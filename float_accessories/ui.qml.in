import "qrc:/mobile"
import QtQuick 2.12
import QtQuick.Controls 2.12
import QtQuick.Layouts 1.3
import QtQuick.Controls.Material 2.2
import Vedder.vesc.commands 1.0
import Vedder.vesc.configparams 1.0
import Vedder.vesc.utility 1.0
import Vedder.vesc.vescinterface 1.0

Item {
    // Custom components
    Component {
        id: customValueSlider

        Slider {
            id: slider
            from: 0
            to: 100
            value: 50
            property bool asPercent: false
            property bool hideBubble: true
            signal interactionReleased()

            onPressedChanged: {
                if (!pressed) {
                    interactionReleased()
                }
            }
            property var formatValue: function(val) { 
                if (asPercent) {
                    let percentage = ((val - from) / (to - from)) * 100;
                    return percentage.toFixed(0) + "%";
                }
                return val + ""; 
            }

            Item {
                parent: slider.handle
                width: parent.width
                height: parent.height

                Rectangle {
                    anchors.horizontalCenter: parent.horizontalCenter
                    anchors.bottom: parent.top
                    anchors.bottomMargin: 8
                    width: valueText.width + 8
                    height: 20
                    radius: 4
                    color: palette.toolTipBase               
                    visible: true
                    opacity: slider.pressed || !hideBubble ? 1.0 : 0.0
                    Behavior on opacity { NumberAnimation { duration: 150 } }

                    Text {
                        id: valueText
                        anchors.centerIn: parent
                        text: slider.formatValue(slider.value)
                        color: palette.toolTipText
                        font.pixelSize: 12
                        font.bold: true
                    }
                }
            }
        }
    }

    // Shared card styling values
    QtObject {
        id: cardStyle
        property int topPadding: 42
        property int sidePadding: 12
        property int bottomPadding: 12
        property int contentSpacing: 6
        property int titleHeight: 40
        property int radius: 15
        // Spacing constants
        property int betweenCards: 20   // gap between GroupBox cards
        property int fieldSpacing: 10   // gap between label+control pairs in a card
        property int labelSpacing: 2    // gap between a label and its control
        // ScrollView padding
        property int scrollHPadding: 12  // left/right padding inside scrollviews
        property int scrollTopPadding: 16
        property int scrollBottomPadding: 16
        // ScrollView background
        property color scrollViewBg: Utility.getAppHexColor("darkBackground")
    }

    // Shared field label styling (used for labels that sit above a control)
    QtObject {
        id: fieldLabelStyle
        property color color: Qt.rgba(1, 1, 1, 0.75)
        property int pixelSize: 13
        property bool bold: false
    }

    Component {
        id: cardBg
        Rectangle {
            color: Qt.rgba(1, 1, 1, 0.06)
            radius: cardStyle.radius
        }
    }

    // Reusable card component with title and optional titleRight content
    // Usage: Loader { sourceComponent: card; onLoaded: { item.title = "Title"; item.titleRight = someComponent } }
    Component {
        id: card
        Rectangle {
            property string title: ""
            property Component titleRight: null
            default property alias content: contentColumn.children

            Layout.fillWidth: true
            radius: 15
            color: Qt.rgba(1, 1, 1, 0.06)
            implicitHeight: cardInner.implicitHeight + 24

            ColumnLayout {
                id: cardInner
                anchors.top: parent.top
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.margins: 12
                spacing: 10

                RowLayout {
                    Layout.fillWidth: true
                    Layout.bottomMargin: 2
                    visible: title !== ""

                    Text {
                        text: title
                        color: "white"
                        font.pixelSize: 15
                        font.bold: true
                        Layout.alignment: Qt.AlignVCenter
                    }
                    Item { Layout.fillWidth: true }
                    Loader {
                        id: titleRightLoader
                        sourceComponent: titleRight
                        Layout.alignment: Qt.AlignVCenter | Qt.AlignRight
                        visible: titleRight !== null
                    }
                }

                ColumnLayout {
                    id: contentColumn
                    Layout.fillWidth: true
                    spacing: 10
                }
            }
        }
    }

    // Card title for GroupBox label
    Component {
        id: cardTitleLabel
        Item {
            property string title: ""
            implicitHeight: 40
            implicitWidth: parent ? parent.width : 200

            Text {
                id: titleText
                text: parent.title
                color: "white"
                font.bold: true
                font.pixelSize: 15
                anchors.left: parent.left
                anchors.leftMargin: 12
                anchors.verticalCenter: parent.verticalCenter
            }
        }
    }

    // Card title with right content for GroupBox label
    Component {
        id: cardTitleWithRight
        Item {
            property string title: ""
            default property alias titleRight: titleRightRow.children
            implicitHeight: 40
            implicitWidth: parent ? parent.width : 200

            Text {
                text: parent.title
                color: "white"
                font.bold: true
                font.pixelSize: 15
                anchors.left: parent.left
                anchors.leftMargin: 12
                anchors.verticalCenter: parent.verticalCenter
            }
            Row {
                id: titleRightRow
                anchors.right: parent.right
                anchors.rightMargin: 12
                anchors.verticalCenter: parent.verticalCenter
                spacing: 8
            }
        }
    }

    Component {
        id: customSwitch
        Switch {
            id: control
            padding: 0
            indicator: Rectangle {
                implicitWidth: 48
                implicitHeight: 26
                x: control.leftPadding
                y: parent.height / 2 - height / 2
                radius: 13
                color: control.checked ? Material.accent : palette.button
                border.color: control.checked ? Material.accent : palette.button
                
                Rectangle {
                    x: control.checked ? parent.width - width - 2 : 2
                    y: 2
                    width: 22
                    height: 22
                    radius: 11
                    color: "white"
                    Behavior on x {
                        NumberAnimation { duration: 200; easing.type: Easing.OutQuad }
                    }
                }
            }
        }
    }

    // Main app
    id: container
    property string tabTitle: "Float Accessories"  
    anchors.fill: parent
    property int pubmotePairCode: -1  // Initialize with a default invalid value
    property int pubmotePairingState: 0
    property bool pairingTimeout: false
    property int remainingTime: 60  // Initialize with the full 60 seconds
    property int bmsConnected: 0
    property Commands mCommands: VescIf.commands()
    property int floatAccessoriesMagic: 102
    property bool acceptTOS: false
    readonly property bool owBmsEnabled: bmsEnabled.checked && bmsBackend.currentIndex === 1
    readonly property bool ssbmsUartSelected: bmsEnabled.checked && bmsBackend.currentIndex === 2
    readonly property bool ssbmsBleSelected: bmsEnabled.checked && bmsBackend.currentIndex === 3
    property int lastStatusTime: 0
    property bool statusTimeout: true
    property string gpioTarget: ""
    readonly property var gpioTargets: JSON.parse('{{GPIO_TARGETS}}')
    readonly property string pinConfigError: readConfig ? pinConfigurationError() : ""

    function gpioPinValid(pin) {
        var caps = gpioTargets[gpioTarget]
        if (pin === -1) return true
        if (!caps || !isFinite(pin) || pin !== Math.floor(pin) || pin < 0 || pin > caps.max)
            return false
        for (var i = 0; i < caps.gap.length; i += 2) {
            if (pin >= caps.gap[i] && pin <= caps.gap[i + 1]) return false
        }
        return true
    }

    function gpioRangeDescription() {
        var caps = gpioTargets[gpioTarget]
        if (!caps) return "Waiting for device GPIO capabilities."
        var ranges = []
        var start = 0
        for (var i = 0; i < caps.gap.length; i += 2) {
            ranges.push(start + "-" + (caps.gap[i] - 1))
            start = caps.gap[i + 1] + 1
        }
        ranges.push(start + "-" + caps.max)
        return ranges.join(", ")
    }

    function pinConfigurationError() {
        if (!gpioTargets[gpioTarget]) return "Waiting for device GPIO capabilities."
        var pins = [
            ["Front LED", ledFrontPin.value],
            ["Rear LED", ledRearPin.value],
            ["Status LED", ledStatusPin.value],
            ["Footpad LED", ledFootpadPin.value],
            ["Button LED", ledButtonPin.value],
            ["Front highbeam", ledFrontHighbeamPin.value],
            ["Rear highbeam", ledRearHighbeamPin.value],
            ["OW BMS DI", bmsRs485DIPin.value],
            ["OW BMS RO", bmsRs485ROPin.value],
            ["OW BMS DE/RE", bmsRs485DEREPin.value],
            ["BMS wakeup", bmsWakeupPin.value],
            ["SSBMS UART RX", ssbmsUartRxPin.value],
            ["SSBMS UART TX", ssbmsUartTxPin.value],
            ["Humidity SDA", humiditySdaPin.value],
            ["Humidity SCL", humiditySlcPin.value],
            ["GNSS RX", gnssRxPin.value],
            ["GNSS TX", gnssTxPin.value]
        ]
        for (var i = 0; i < pins.length; i++) {
            if (!gpioPinValid(pins[i][1])) {
                return pins[i][0] + ": GPIO " + pins[i][1] + " is invalid for "
                    + gpioTarget + ". Use " + gpioRangeDescription() + " or -1 (unassigned)."
            }
        }
        return ""
    }

    // Numeric boot protocol shared with float_accessories.lisp.
    readonly property int bootWaiting: 0
    readonly property int bootLoadingCode: 1
    readonly property int bootLoadingLibraries: 2
    readonly property int bootCreatingImage: 3
    readonly property int bootStarting: 4
    readonly property int bootReady: 5
    readonly property int bootFailed: 6
    property string bootLoadingText: qsTr("Preparing first boot: loading package…")
    property int bootState: container.bootWaiting
    property bool bootConfigRequested: false
    property int bootConfigRetryTicks: 0
    readonly property bool packageReady: readConfig && bootState === container.bootReady
    property bool readConfig: false
    property bool wasConnected: false
    property int debugMask: 0
    property bool simOn: false
    property int integrationLastStatusTime: 0
    property int pubmoteLastStatusTime: 0
    readonly property bool integrationConnected: integrationConnectionState === 2
    // 0 standalone, 1 connecting, 2 connected, 3 disconnected; from the provider.
    property int integrationConnectionState: 1
    readonly property bool integrationEnabled: integrationSelector.currentIndex > 0
    property bool pubmoteConnected: false
    property bool gnssFix: false
    property real gnssAge: 9999
    property real gnssHdop: 99
    property real gnssSpeed: 0
    property int pubmoteWifiChannel: 0
    property bool isPubmoteBle: false
    property bool isPubmotePaired: false
    property int bmsStatusTemp: 0
    property int bmsBatteryTypeVal: 0
    property int bmsBatteryCyclesVal: 0
    property real lcmHum: 0
    property real lcmHumTemp: 0
    property real bmsHum: 0
    property real bmsHumTemp: 0
    property var ssbmsTelemetry: null
    property double ssbmsTelemetryClock: 0
    readonly property real ssbmsTelemetryAge: ssbmsTelemetry
        ? ssbmsTelemetry.age + Math.max(0, ssbmsTelemetryClock - ssbmsTelemetry.receivedAt) / 1000 : -1
    readonly property bool ssbmsTelemetryAvailable: ssbmsTelemetry !== null
        && ssbmsTelemetry.backend === bmsBackend.currentIndex
    readonly property bool ssbmsTelemetryConnected: !statusTimeout
        && (ssbmsUartSelected || ssbmsBleSelected)
        && (bmsConnected === 1 || (ssbmsBleSelected && ssbmsBleLinkConnected))
    onSsbmsTelemetryConnectedChanged: if (!ssbmsTelemetryConnected) ssbmsTelemetry = null

    function applySsbmsTelemetry(message) {
        var values = message.replace(/\0/g, "").trim().split(/\s+/).slice(1).map(Number)
        if (values.length < 11 || (values[0] !== 2 && values[0] !== 3) || values[1] < 0) {
            // Retain the last complete sample while this transport waits for
            // fresh data. A stopped backend clears it.
            if (!ssbmsTelemetry || ssbmsTelemetry.backend !== values[0]) ssbmsTelemetry = null
            return
        }
        var count = values[10]
        if (count < 12 || count > 32 || Math.floor(count) !== count || values.length !== 11 + count) return
        for (var i = 0; i < values.length; i++) if (!isFinite(values[i])) return
        var cells = values.slice(11)
        var low = Math.min.apply(Math, cells), high = Math.max.apply(Math, cells)
        var now = Date.now()
        ssbmsTelemetryClock = now
        ssbmsTelemetry = {backend: values[0], age: values[1], receivedAt: now,
            voltage: values[2], soc: values[3], current: values[4],
            temp1: values[5], temp2: values[6], mosfet: values[7],
            chargeAllowed: values[8] !== 0, status: values[9], cells: cells,
            low: low, high: high, spread: (high - low) * 1000}
    }
    property int loggerRunning: 0
    property string pubmoteVersionStr: "Unknown"

    // ---- Status summary -------------------------------------------------
    // One source of truth for the header pill and the popover it opens.
    // Every line reports a severity: 0 ok, 1 warning, 2 error, and -1 for
    // "nothing to say" - the feature is off, or the value isn't known yet
    // because the link is down, which the link line already reports.
    QtObject {
        id: statusSummary

        readonly property color okColor: "#4caf50"
        readonly property color warnColor: "#ffb300"
        readonly property color errColor: "#ef5350"
        readonly property color idleColor: Qt.rgba(1, 1, 1, 0.45)

        function severityColor(sev) {
            if (sev < 0) return idleColor
            return sev === 0 ? okColor : (sev === 1 ? warnColor : errColor)
        }

        readonly property int linkSeverity: !statusTimeout ? 0 : (lastStatusTime <= 60 ? 1 : 2)

        readonly property int integrationSeverity: (!integrationEnabled || integrationConnectionState === 0) ? -1
            : (integrationConnected && !statusTimeout) ? 0
            : integrationConnectionState === 1 ? 1
            : (Math.max(integrationLastStatusTime, lastStatusTime) <= 60 ? 1 : 2)

        readonly property int pubmoteSeverity: (!pubmoteEnabled.checked || !isPubmotePaired) ? -1
            : ((pubmoteConnected && !statusTimeout) ? 0
            : (Math.max(pubmoteLastStatusTime, lastStatusTime) <= 60 ? 1 : 2))

        readonly property int gnssSeverity: (!gnssEnabled.checked || statusTimeout) ? -1
            : (gnssFix ? 0 : (gnssAge <= 10 ? 1 : 2))

        readonly property int bmsSeverity: ((!bmsEnabled.checked || bmsBackend.currentIndex === 0) || statusTimeout) ? -1
            : (bmsConnected ? 0 : 2)

        readonly property int bmsHumSeverity: (!owBmsEnabled || !humidityEnabled.checked
            || statusTimeout || bmsHum <= 0) ? -1
            : (bmsHum < 65 ? 0 : (bmsHum < 80 ? 1 : 2))

        readonly property int lcmHumSeverity: (!humidityEnabled.checked || statusTimeout || lcmHum <= 0) ? -1
            : (lcmHum < 65 ? 0 : (lcmHum < 80 ? 1 : 2))

        // Only the link and the selected integration. A pubmote that isn't paired, a
        // GNSS still searching or a BMS that isn't fitted are all normal
        // states for a board that is working perfectly, so colouring the pill
        // for them would make it amber most of the time and stop meaning
        // anything. They keep their own coloured line in the popover.
        readonly property int worstSeverity: Math.max(linkSeverity, integrationSeverity)

        readonly property color pillColor: severityColor(worstSeverity)

        // Deliberately no second counter here - the seconds tick every second
        // and would resize the pill under the user's finger. The popover has
        // them.
        readonly property string pillText: {
            if (statusTimeout) return lastStatusTime <= 60 ? qsTr("Connecting") : qsTr("Disconnected")
            // Named rather than counted: the vehicle integration is the only
            // thing besides the link that can colour the pill, so "1 issue"
            // would be a riddle with one answer.
            if (integrationSeverity > 0) return integrationConnectionState === 1
                ? qsTr("Connecting") : qsTr("Integration Disconnected")
            return qsTr("Connected")
        }
    }

    // Live remote input preview state
    property bool pubmoteInputConnected: false
    property real pubmoteInputJsy: 0
    property real pubmoteInputJsx: 0
    property bool pubmoteInputBtC: false
    property bool pubmoteInputBtZ: false
    property bool pubmoteInputRev: false

    // Live GNSS preview state (fed by the (gnss-state) poll)
    property bool gnssPreviewFix: false
    property real gnssPreviewLat: 0
    property real gnssPreviewLon: 0
    property real gnssPreviewHdop: 99
    property real gnssPreviewSpeed: 0
    property real gnssPreviewAge: 9999
    // GNSS track as [dx, dy] metres east/north of the first fix, for the
    // preview canvas (a real map isn't available to package QML).
    property var gnssTrack: []
    property real gnssTrackLat0: 0
    property real gnssTrackLon0: 0
    property bool gnssTrackHasOrigin: false

    // Append a fix to the track in local ENU metres from the first fix,
    // skipping sub-0.5 m jitter, then repaint the preview canvas.
    function appendGnssPoint(lat, lon) {
        if (lat === 0 && lon === 0) return
        if (!gnssTrackHasOrigin) {
            gnssTrackLat0 = lat
            gnssTrackLon0 = lon
            gnssTrackHasOrigin = true
        }
        var mPerDegLat = 111320.0
        var mPerDegLon = 111320.0 * Math.cos(gnssTrackLat0 * Math.PI / 180.0)
        var dx = (lon - gnssTrackLon0) * mPerDegLon
        var dy = (lat - gnssTrackLat0) * mPerDegLat
        var arr = gnssTrack
        if (arr.length > 0) {
            var ddx = dx - arr[arr.length - 1][0]
            var ddy = dy - arr[arr.length - 1][1]
            if ((ddx * ddx + ddy * ddy) < 0.25) {
                gnssTrackCanvas.requestPaint()
                return
            }
        }
        arr.push([dx, dy])
        if (arr.length > 400) arr.shift()
        gnssTrack = arr
        gnssTrackCanvas.requestPaint()
    }

    // Every feature checkbox starts unchecked, so which tabs are worth showing
    // is only known once the board's settings have landed.
    onReadConfigChanged: {
        if (readConfig) {
            settleTabTimer.restart()
        }
    }

    // Device link lost: clear stale preview data so the joystick and GPS
    // track don't stay frozen at their last values until reconnect.
    onStatusTimeoutChanged: {
        if (statusTimeout) {
            gpioTarget = ""
            ssbmsBleLinkConnected = false
            ssbmsTelemetry = null
            ssbmsBleConnectPhase = 0
            ssbmsBleProgressMessage = ""
            ssbmsBleConnectTimer.stop()
            pubmoteInputConnected = false
            pubmoteInputJsy = 0
            pubmoteInputJsx = 0
            pubmoteInputBtC = false
            pubmoteInputBtZ = false
            pubmoteInputRev = false
            gnssPreviewFix = false
            gnssPreviewLat = 0
            gnssPreviewLon = 0
            gnssPreviewHdop = 99
            gnssPreviewSpeed = 0
            gnssTrack = []
            gnssTrackHasOrigin = false
            gnssTrackCanvas.requestPaint()
        }
    }

    // ---- LED strips add/remove -----------------------------------------
    // The per-role strip config cards below (status / front / rear / footpad
    // / button) are each still backed by their own ledXxxStripType / pin /
    // num controls and the positional config protocol. A role's Strip Type
    // combo doubles as its enable: index 0 = "None" hides the card (removes
    // the strip), any preset shows it. The "+ Add Strip" button at the end
    // of the list adds a not-yet-used role. The firmware chains strips that
    // share a pin automatically, so no per-strip offset is configured here.
    // This binding tracks the five currentValue props directly so it
    // re-evaluates whenever a strip is added or removed.
    property var addedRoles: {
        var a = []
        if (ledStatusStripType.currentValue > 0)  a.push("Status")
        if (ledFrontStripType.currentValue > 0)   a.push("Front")
        if (ledRearStripType.currentValue > 0)    a.push("Rear")
        if (ledFootpadStripType.currentValue > 0) a.push("Footpad")
        if (ledButtonStripType.currentValue > 0)  a.push("Button")
        return a
    }

    // Enable (on = true, set the Strip Type to its first real preset) or
    // remove (on = false, back to "None") a role. Setting currentIndex fires
    // the combo's existing onCurrentIndexChanged, which pushes live settings.
    function setRole(name, on) {
        var idx = on ? 1 : 0
        switch (name) {
        case "Status":  ledStatusStripType.currentIndex = idx;  break
        case "Front":   ledFrontStripType.currentIndex = idx;   break
        case "Rear":    ledRearStripType.currentIndex = idx;    break
        case "Footpad": ledFootpadStripType.currentIndex = idx; break
        case "Button":  ledButtonStripType.currentIndex = idx;  break
        }
    }

    // ---- Settings ---------------------------------------------------------
    // The package registers a VESC custom config from its native fa_cfg lib
    // (conf_custom_add_config), so VESC Tool reads and writes these settings
    // over its own config transport - the same one it uses for motor and app
    // config. It even fetches this config by itself on connect. This page
    // therefore never transfers settings: it reads the values out of the
    // ConfigParams object and writes them back through customConfigSet.
    //
    // Index 1 on the VESC Express. VescIf.customConfigNum() / customConfig(i)
    // can enumerate them if that ever stops holding.
    readonly property int faConfigIndex: 1
    property ConfigParams mCustomConf: VescIf.customConfig(faConfigIndex)

    // VESC Express "Bluetooth Mode LBM", reported by Lisp in float-stats:
    // -2 not received yet, -1 firmware without the setting, otherwise
    // 0 Disabled, 1 Server, 2 Client, 3 Client & Server. SSBMS BLE needs Client.
    property int expressBleRole: -2
    property bool expressBleRebootPending: false

    // SSBMS BLE pinning. The address is packed into two config ints: bytes 0-3,
    // then bytes 4-5, address type (0 public, 1 random) and 1 when pinned.
    property int ssbmsBleAddressA: 0
    property int ssbmsBleAddressB: 0
    readonly property bool ssbmsBlePinned: (ssbmsBleAddressB & 255) === 1
    property bool ssbmsBleScanning: false
    property string ssbmsBleScanMessage: ""
    property bool ssbmsBleLinkConnected: false
    property int ssbmsBleLinkA: 0
    property int ssbmsBleLinkB: 0
    property int ssbmsBleRssi: 0
    property int ssbmsBleConnectPhase: 0
    property string ssbmsBleProgressMessage: ""
    readonly property bool ssbmsBleConnecting: ssbmsBleConnectPhase > 0 && ssbmsBleConnectPhase < 6
    ListModel { id: ssbmsBleFound }

    function ssbmsBlePeerSaved(a, b) {
        return ssbmsBlePinned && (a | 0) === (ssbmsBleAddressA | 0) && (b | 0) === (ssbmsBleAddressB | 0)
    }
    function ssbmsBlePeerLinked(a, b) {
        return ssbmsBleLinkConnected && (a | 0) === (ssbmsBleLinkA | 0) && (b | 0) === (ssbmsBleLinkB | 0)
    }
    function ssbmsBleConnectText(a, b) {
        if (ssbmsBlePeerLinked(a, b)) return "Connected"
        if (ssbmsBlePeerSaved(a, b)) return ssbmsBleConnecting ? "Connecting..." : "Retry"
        return "Connect"
    }
    Timer {
        id: ssbmsBleConnectTimer
        interval: 20000
        onTriggered: {
            ssbmsBleConnectPhase = 0
            ssbmsBleProgressMessage = "No connection progress received. Check the Lisp console."
        }
    }

    function formatBleAddress(a, b) {
        var bytes = [(a >>> 24) & 255, (a >>> 16) & 255, (a >>> 8) & 255, a & 255,
                     (b >>> 24) & 255, (b >>> 16) & 255]
        return bytes.map(function (x) { return (x < 16 ? "0" : "") + x.toString(16).toUpperCase() }).join(":")
            + (((b >>> 8) & 255) === 1 ? " (random)" : "")
    }

    // Lisp answers with ssbms-scan-done; this only covers a backend that never does.
    Timer {
        id: ssbmsBleScanTimer
        interval: 15000
        onTriggered: {
            if (ssbmsBleScanning) {
                ssbmsBleScanning = false
                ssbmsBleScanMessage = "No answer from the SSBMS BLE backend."
            }
        }
    }
    readonly property bool expressBleClientMissing: expressBleRole === 0 || expressBleRole === 1

    readonly property var expressBleRoleNames: ["Disabled", "Server", "Client", "Client & Server"]

        // VESC Tool rebuilds its ConfigParams object on every settings read, so a
        // binding onto it goes stale; these are re-read on each connect instead.
    Connections {
        target: VescIf
        function onCustomConfigLoadDone() {
            mCustomConf = VescIf.customConfig(faConfigIndex)
            bootConfigRequested = false
            if (bootState === container.bootReady) reloadMissingConfigAfterBoot()
        }
    }

    function resolveCustomConf() {
        if (!mCustomConf) {
            mCustomConf = VescIf.customConfig(faConfigIndex)
        }
        return !!mCustomConf && mCustomConf.hasParam("led_enabled")
    }

    property bool configReloadRequested: false

    function applyBootState(state) {
        if (!isFinite(state) || state !== Math.floor(state)
                || state < container.bootLoadingCode || state > container.bootFailed) return
        var becameReady = state === container.bootReady && bootState !== container.bootReady
        bootState = state
        if (becameReady) bootConfigRequested = false
        if (state === container.bootReady) reloadMissingConfigAfterBoot(becameReady)
    }

    function pollBootProgress() {
        // Keep boot polling on the app transport: Lisp statistics temporarily
        // pause the evaluator and can interfere with startup's own pause.
        if (bootState === container.bootReady && !readConfig) {
            bootConfigRetryTicks++
            if (bootConfigRetryTicks >= 3) {
                bootConfigRetryTicks = 0
                bootConfigRequested = false
                reloadMissingConfigAfterBoot()
            }
        }
    }

    function applyBootLog(message) {
        var text = message.replace(/\0/g, "").trim()
        if (text.charAt(0) === '"' && text.charAt(text.length - 1) === '"')
            text = text.substring(1, text.length - 1)
        var module = /^FA loaded (core|bms|vehicle|telemetry|led|pubmote|app)$/.exec(text)
        if (module) {
            bootLoadingText = qsTr("Loading") + " " + module[1] + "..."
            bootState = container.bootLoadingCode
        } else if (text.indexOf("FA saving startup image") === 0) {
            applyBootState(container.bootCreatingImage)
        } else if (text.indexOf("FA startup image saved") === 0) {
            applyBootState(container.bootStarting)
        } else if (text.indexOf("Preparing new image") === 0) {
            bootLoadingText = qsTr("Preparing first boot: preparing image storage…")
            bootState = container.bootLoadingCode
        } else if (/^Parsing \d+ characters/.test(text)) {
            bootLoadingText = qsTr("Preparing first boot: parsing package…")
            bootState = container.bootLoadingCode
        }
    }

    function bootProgressStep() {
        switch (bootState) {
        case container.bootLoadingCode: return 1
        case container.bootLoadingLibraries: return 2
        case container.bootCreatingImage: return 3
        case container.bootStarting: return 4
        case container.bootReady: return 5
        default: return 0
        }
    }

    function bootStatusText() {
        switch (bootState) {
        case container.bootLoadingCode: return bootLoadingText
        case container.bootLoadingLibraries: return qsTr("Loading native libraries…")
        case container.bootCreatingImage: return qsTr("Preparing first boot: creating startup image…")
        case container.bootStarting: return qsTr("Starting package…")
        case container.bootReady: return qsTr("Loading settings…")
        case container.bootFailed: return qsTr("Could not create startup image. Check the Lisp console.")
        default: return VescIf.isPortConnected() ? qsTr("Waiting for package to start...")
                        : lastStatusTime <= 60 ? qsTr("Connecting to the board…")
                                           : qsTr("No connection to the board")
        }
    }

    function reloadMissingConfigAfterBoot(forceRead) {
        if (readConfig && !forceRead) return
        if (resolveCustomConf()) {
            if (!bootConfigRequested) {
                bootConfigRequested = true
                mCommands.customConfigGet(faConfigIndex, false)
            }
        } else if (!configReloadRequested) {
            configReloadRequested = true
            startupConfigReloadTimer.start()
        }
    }

    Timer {
        id: startupConfigReloadTimer
        interval: 0
        onTriggered: {
            if (!resolveCustomConf()) {
                VescIf.reloadFirmware()
            } else {
                reloadMissingConfigAfterBoot()
            }
        }
    }

    function requireCustomConf() {
        if (resolveCustomConf()) {
            return true
        }

        if (!configReloadRequested) {
            configReloadRequested = true

            VescIf.emitMessageDialog("Float Accessories",
                                     "VESC Tool has not loaded this package's configuration, so the settings " +
                                     "could not be saved. Re-reading it from the device now - this page will " +
                                     "reload in a moment, then press Save Config again.",
                                     false, false)

            VescIf.reloadFirmware()
        }

        return false
    }

    Connections {
        target: mCustomConf
        function onUpdated() {
            applyConfigFromParams()
        }
    }

    // Populate every control from the custom config. VESC Tool fetches
    // it on connect by itself (a 1 Hz sweep in VescInterface pulls any
    // config it has not received yet), so this is driven by the ConfigParams
    // updated() signal rather than by a request from this page.
    function applyConfigFromParams() {
            if (!resolveCustomConf()) {
                return
            }

            acceptTOS = (mCustomConf.getParamBool("accept_tos")) ? true : false
            ledEnabled.checked = mCustomConf.getParamBool("led_enabled")
            bmsEnabled.checked = mCustomConf.getParamBool("bms_enabled")
            bmsBackend.currentIndex = mCustomConf.getParamEnum("bms_backend")
            ssbmsUartRxPin.value = mCustomConf.getParamInt("ssbms_uart_rx_pin")
            ssbmsUartTxPin.value = mCustomConf.getParamInt("ssbms_uart_tx_pin")
            ssbmsBleAddressA = mCustomConf.getParamInt("ssbms_ble_paired_address_a")
            ssbmsBleAddressB = mCustomConf.getParamInt("ssbms_ble_paired_address_b")
            pubmoteEnabled.checked = mCustomConf.getParamBool("pubmote_enabled")
            ledOn.checked = mCustomConf.getParamBool("led_on")
            ledHighbeamOn.checked = mCustomConf.getParamBool("led_highbeam_on")
            ledMode.currentIndex = mCustomConf.getParamEnum("led_mode")
            ledModeIdle.currentIndex = mCustomConf.getParamEnum("led_mode_idle")
            ledModeStatus.currentIndex = mCustomConf.getParamEnum("led_mode_status")
            ledModeStartup.currentIndex = mCustomConf.getParamEnum("led_mode_startup")
            ledModeButton.currentIndex = mCustomConf.getParamEnum("led_mode_button")
            ledModeFootpad.currentIndex = mCustomConf.getParamEnum("led_mode_footpad")
            ledMallGrabEnabled.checked = mCustomConf.getParamBool("led_mall_grab_enabled")
            ledBrakeLightEnabled.checked = mCustomConf.getParamBool("led_brake_light_enabled")
            ledBrakeLightMinAmps.value = mCustomConf.getParamDouble("led_brake_light_min_amps")
            idleTimeout.value = mCustomConf.getParamInt("idle_timeout")
            idleTimeoutShutoff.value = mCustomConf.getParamInt("idle_timeout_shutoff")
            ledBrightnessLoader.item.value = mCustomConf.getParamDouble("led_brightness")
            ledBrightnessHighbeamLoader.item.value = mCustomConf.getParamDouble("led_brightness_highbeam")
            ledBrightnessIdleLoader.item.value = mCustomConf.getParamDouble("led_brightness_idle")
            ledBrightnessStatusLoader.item.value = mCustomConf.getParamDouble("led_brightness_status")
            ledStatusPin.value = mCustomConf.getParamInt("led_status_pin")
            ledStatusNum.value = mCustomConf.getParamInt("led_status_num")
            ledStatusType.currentIndex = mCustomConf.getParamEnum("led_status_type")
            ledStatusWhiteOutput.currentIndex = mCustomConf.getParamEnum("led_status_white_output")
            ledStatusReversed.checked = mCustomConf.getParamBool("led_status_reversed")
            ledFrontPin.value = mCustomConf.getParamInt("led_front_pin")
            ledFrontNum.value = mCustomConf.getParamInt("led_front_num")
            ledFrontType.currentIndex = mCustomConf.getParamEnum("led_front_type")
            ledFrontWhiteOutput.currentIndex = mCustomConf.getParamEnum("led_front_white_output")
            ledFrontReversed.checked = mCustomConf.getParamBool("led_front_reversed")
            var frontTiming = mCustomConf.getParamEnum("led_front_timing")
            if (frontTiming > 0) {
                ledFrontTiming.currentIndex = frontTiming - 1
            }
            ledRearPin.value = mCustomConf.getParamInt("led_rear_pin")
            ledRearNum.value = mCustomConf.getParamInt("led_rear_num")
            ledRearType.currentIndex = mCustomConf.getParamEnum("led_rear_type")
            ledRearWhiteOutput.currentIndex = mCustomConf.getParamEnum("led_rear_white_output")
            ledRearReversed.checked = mCustomConf.getParamBool("led_rear_reversed")
            var rearTiming = mCustomConf.getParamEnum("led_rear_timing")
            if (rearTiming > 0) {
                ledRearTiming.currentIndex = rearTiming - 1
            }
            ledButtonPin.value = mCustomConf.getParamInt("led_button_pin")
            ledButtonStripType.currentIndex = mCustomConf.getParamEnum("led_button_timing") > 0 ? 1 : 0
            ledFootpadPin.value = mCustomConf.getParamInt("led_footpad_pin")
            ledFootpadNum.value = mCustomConf.getParamInt("led_footpad_num")
            ledFootpadType.currentIndex = mCustomConf.getParamEnum("led_footpad_type")
            ledFootpadWhiteOutput.currentIndex = mCustomConf.getParamEnum("led_footpad_white_output")
            ledFootpadReversed.checked = mCustomConf.getParamBool("led_footpad_reversed")
            var footpadTiming = mCustomConf.getParamEnum("led_footpad_timing")
            ledFootpadStripType.currentIndex = footpadTiming > 0 ? 1 : 0
            if (footpadTiming > 0) {
                ledFootpadTiming.currentIndex = footpadTiming - 1
            }
            // Format and display MAC address... need to unpack
            var unpack = unpackUint32ToBytes(mCustomConf.getParamInt("pubmote_remote_mac_a")).concat(unpackUint32ToBytes(mCustomConf.getParamInt("pubmote_remote_mac_b"))).slice(0,-2)
            var macAddress = unpack.map(function(token) {
                return ("0" + Number(token).toString(16)).slice(-2);
            }).join(":");
            // pubmote-secret-code 48
            bmsRs485DIPin.value = mCustomConf.getParamInt("bms_rs485_di_pin")
            bmsRs485ROPin.value = mCustomConf.getParamInt("bms_rs485_ro_pin")
            bmsRs485DEREPin.value = mCustomConf.getParamInt("bms_rs485_dere_pin")
            bmsWakeupPin.value = mCustomConf.getParamInt("bms_wakeup_pin")
            bmsOverrideSOC.checked = mCustomConf.getParamInt("bms_override_soc")
            bmsRS485Chip.checked = mCustomConf.getParamInt("bms_rs485_chip")
            //Need to read and unpack. To set this is also going to be handled in seperate button like tos, pubmote-pair etc.
            //bmsKeyA.value = mCustomConf.getParamInt("bms_key_a")
            //bmsKeyB.value = mCustomConf.getParamInt("bms_key_b")
            //bmsKeyC.value = mCustomConf.getParamInt("bms_key_c")
            //bmsKeyD.value = mCustomConf.getParamInt("bms_key_d")
            //bmsCounterA.value = mCustomConf.getParamInt("bms_counter_a")
            //bmsCounterB.value = mCustomConf.getParamInt("bms_counter_b")
            //bmsCounterC.value = mCustomConf.getParamInt("bms_counter_c")
            //bmsCounterD.value = mCustomConf.getParamInt("bms_counter_d")
            ledLoopDelay.value = mCustomConf.getParamInt("led_loop_delay")
            bmsLoopDelay.value = mCustomConf.getParamInt("bms_loop_delay")
            pubmoteLoopDelay.value = mCustomConf.getParamInt("pubmote_loop_delay")
            canLoopFreq.value = mCustomConf.getParamInt("can_loop_delay")
            integrationSelector.currentIndex = mCustomConf.getParamEnum("integration")
            ledDimOnHighbeamRatioLoader.item.value = mCustomConf.getParamDouble("led_dim_on_highbeam_ratio")
            bmsType.currentIndex = mCustomConf.getParamInt("bms_type")
            var statusTiming = mCustomConf.getParamEnum("led_status_timing")
            ledStatusStripType.currentIndex = statusTiming > 0 ? 1 : 0
            if (statusTiming > 0) {
                ledStatusTiming.currentIndex = statusTiming - 1
            }
            bmsChargeOnly.checked = mCustomConf.getParamBool("bms_charge_only")
            ledShowBatteryCharging.checked = mCustomConf.getParamBool("led_show_battery_charging")
            ledFrontHighbeamPin.value = mCustomConf.getParamInt("led_front_highbeam_pin")
            ledRearHighbeamPin.value = mCustomConf.getParamInt("led_rear_highbeam_pin")
            bmsBuffSize.value = mCustomConf.getParamInt("bms_buff_size")
            ledMaxBrightnessLoader.item.value = mCustomConf.getParamDouble("led_max_brightness")
            floatPkgSoc.checked = mCustomConf.getParamInt("soc_type") == 0
            voltageCurveSoc.checked = mCustomConf.getParamInt("soc_type") == 1
            cellType.currentIndex = mCustomConf.getParamInt("cell_type")
            logEnabled.checked = mCustomConf.getParamBool("log_enabled")
            logRate.value = mCustomConf.getParamDouble("log_rate")
            logAppendGnss.checked = mCustomConf.getParamBool("log_append_gnss")
            humidityEnabled.checked = mCustomConf.getParamBool("humidity_enabled")
            humiditySdaPin.value = mCustomConf.getParamInt("humidity_sda_pin")
            humiditySlcPin.value = mCustomConf.getParamInt("humidity_slc_pin")
            frontHbMode = mCustomConf.getParamEnum("led_front_highbeam_mode")
            frontHbPos = unpackHbPos(mCustomConf.getParamInt("led_front_highbeam_pos"))
            frontHbMin = mCustomConf.getParamDouble("led_front_highbeam_min")
            frontHbMax = mCustomConf.getParamDouble("led_front_highbeam_max")
            rearHbMode = mCustomConf.getParamEnum("led_rear_highbeam_mode")
            rearHbPos = unpackHbPos(mCustomConf.getParamInt("led_rear_highbeam_pos"))
            rearHbMin = mCustomConf.getParamDouble("led_rear_highbeam_min")
            rearHbMax = mCustomConf.getParamDouble("led_rear_highbeam_max")
            syncHbControls()
            gnssEnabled.checked = mCustomConf.getParamBool("gnss_enabled")
            gnssType.currentIndex = mCustomConf.getParamEnum("gnss_type")
            gnssRxPin.value = mCustomConf.getParamInt("gnss_rx_pin")
            gnssTxPin.value = mCustomConf.getParamInt("gnss_tx_pin")
            gnssUartNum.value = mCustomConf.getParamInt("gnss_uart_num")
            gnssRateMs.value = mCustomConf.getParamInt("gnss_rate_ms")
            gnssBaud.value = mCustomConf.getParamInt("gnss_baud")

            // The preset itself is not stored - recognize it from the
            // loaded values, falling back to Custom.
            ledFrontStripType.currentIndex = frontTiming > 0
                ? matchStripPreset(ledFrontNum.value, ledFrontType.currentIndex,
                                   frontHbMode, frontHbPos, frontHbMin, frontHbMax)
                : 0
            ledRearStripType.currentIndex = rearTiming > 0
                ? matchStripPreset(ledRearNum.value, ledRearType.currentIndex,
                                   rearHbMode, rearHbPos, rearHbMin, rearHbMax)
                : 0

            isPubmoteBle = (macAddress === "00:00:00:00:00:00");
            isPubmotePaired = (mCustomConf.getParamInt("pubmote_remote_mac_a") != -1);
            pubmoteMacAddress.text = !isPubmotePaired ? "MAC: Not Paired" : (isPubmoteBle ? "Connection: BLE" : "MAC: " + macAddress.toUpperCase());
            readConfig = true;
    }

    Component.onCompleted: {
        if (VescIf.getLastFwRxParams().hwTypeStr() !== "Custom Module") {
            VescIf.emitMessageDialog("Float Accessories", "Warning: It doesn't look like this is installed on a VESC Express.", false, false)
        }

        // Usually already in flight from VESC Tool's own sweep; harmless
        // if it is, and covers the case where the page outlives a reconnect.
        mCommands.customConfigGet(faConfigIndex, false)
    }

    Timer {
        id: statusCheckTimer
        interval: 1000 // Check status every second
        running: true
        repeat: true
        triggeredOnStart: true
        onTriggered: {
            // Before the app handler starts, firmware log messages show progress.
            // Once running, status includes a persistent boot-state snapshot.
            pollBootProgress()
            sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(status)")
            lastStatusTime++
            integrationLastStatusTime++
            pubmoteLastStatusTime++

            if (lastStatusTime > 2) { // 2 second timeout
                statusTimeout = true
            }
            if (lastStatusTime > 60) {
                wasConnected = false
            }
        }
    }

    // Request BMS values only while its Config section is open.
    Timer {
        interval: 1000
        repeat: true
        triggeredOnStart: true
        running: !statusTimeout && tabBar.currentIndex === 1 && tabBar2.currentIndex === 2
            && (ssbmsUartSelected || ssbmsBleSelected)
        onTriggered: {
            ssbmsTelemetryClock = Date.now()
            sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(ssbms-state)")
        }
    }

    // Polls the remote's input state while the preview section is visible and toggled on
    Timer {
        id: inputPreviewTimer
        interval: 100 // 10 Hz
        repeat: true
        running: inputPreviewSection.visible && inputPreviewEnabled.checked
        onTriggered: {
            sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(input-state)")
        }
    }

    // Polls the GNSS position while the preview section is visible and on
    Timer {
        id: gnssPreviewTimer
        interval: 200 // 5 Hz
        repeat: true
        running: gnssPreviewSection.visible && gnssPreviewEnabled.checked
        onTriggered: {
            sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(gnss-state)")
        }
    }

    Timer {
        id: simThrottleTimer
        interval: 50 // 20 Hz, matching the light controls
        repeat: false
        property var pending: ({})
        onTriggered: simFlushPending()
    }

    // Timer for 60-second timeout
    Timer {
        id: pairingTimeoutTimer
        interval: 1000  // 1 second
        running: false
        repeat: true

        onTriggered: {
            remainingTime--;  // Decrease the remaining time by 1 second

            if (remainingTime <= 0) {
                pairingTimeout = true;
                sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(pubmote-pair -2)");  // Automatically reject if time runs out
                pubmotePairPopup.close();
            }
        }
    }
    Dialog {
        id: commDialog
        title: "Processing..."
        closePolicy: Popup.NoAutoClose
        modal: true
        focus: true
        
        width: parent.width - 20
        x: 10
        y: parent.height / 2 - height / 2
        parent: container
        
        ProgressBar {
            anchors.fill: parent
            indeterminate: visible
        }
    }

    Dialog {
        id: pubmotePairPopup
        modal: true
        focus: true
        // Whole pixels: centerIn can land on a half pixel, which blurs the Material
        // buttons' shadow layer and makes them look tilted on high-DPI phones.
        x: Math.round((parent.width - width) / 2)
        y: Math.round((parent.height - height) / 2)
        width: Math.min(container.width - 20, 340)

        // Match the rounding of the standard cards elsewhere in the UI.
        background: Rectangle {
            color: Utility.getAppHexColor("darkBackground")
            radius: cardStyle.radius
            border.color: Qt.rgba(1, 1, 1, 0.1)
            border.width: 1
        }

        onVisibleChanged: {
            if (visible) {
                pubmotePairingState = 1;
                // Generate code only when the popup is shown
                pubmotePairCode = Math.floor(1000 + Math.random() * 9000);  // Generates a number between 1000 and 9999
                pairingTimeout = false;  // Reset timeout flag
                remainingTime = 60;  // Reset the timer to 60 seconds
                pairingTimeoutTimer.start();  // Start the 1-second timer to count down

                // Send the pairing request with the generated code
                sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(pubmote-pair " + pubmotePairCode + ")");
            } else {
                pairingTimeoutTimer.stop();  // Stop timer if the popup is closed
            }
        }

        ColumnLayout {
            anchors.fill: parent
            spacing: 12

            Text {
                text: "Pairing Code: " + pubmotePairCode
                color: Utility.getAppHexColor("lightText")
                font.pointSize: 20
                font.bold: true
                Layout.alignment: Qt.AlignHCenter
            }

            Text {
                text: "Time remaining: " + remainingTime + " s"
                color: Utility.getAppHexColor("lightText")
                Layout.alignment: Qt.AlignHCenter
            }

            Text {
                text: pubmotePairingState === 1 ? "Searching for remote..." :
                      pubmotePairingState === 2 ? "Remote found! Confirm code and Accept." :
                      "Pairing..."
                color: Material.accent
                wrapMode: Text.WordWrap
                horizontalAlignment: Text.AlignHCenter
                Layout.fillWidth: true
            }

            RowLayout {
                Layout.fillWidth: true
                Layout.topMargin: 8
                spacing: 10

                Button {
                    text: "Reject"
                    Layout.fillWidth: true
                    Layout.preferredWidth: 1  // even split, not by label width
                    onClicked: {
                        sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(pubmote-pair -2)");  // Reject pairing manually
                        pubmotePairPopup.close();
                    }
                }

                Button {
                    text: "Accept"
                    Layout.fillWidth: true
                    Layout.preferredWidth: 1  // even split, not by label width
                    highlighted: true
                    enabled: !pairingTimeout
                    onClicked: {
                        if (!pairingTimeout) {
                            sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(pubmote-pair -1)");  // Accept pairing
                            pubmotePairPopup.close();
                        }
                    }
                }
            }
        }
    }

    // Test mode controls. Opening this popup turns test mode on and closing it
    // turns it off, so the board cannot be left reporting scripted telemetry
    // because a panel was scrolled past. The controls below are the whole state:
    // a preset fills them in, it does not compose with them.
    Popup {
        id: simPopup
        modal: true
        focus: true
        visible: false
        anchors.centerIn: parent
        closePolicy: Popup.CloseOnEscape
        // Sized and painted like the About dialog. Taller cap than its 520,
        // because this one holds controls rather than a block of text.
        width: Math.min(container.width - 20, 400)
        height: Math.min(container.height - 40, 620)
        leftPadding: 12
        rightPadding: 12
        topPadding: 16
        bottomPadding: 12

        background: Rectangle {
            color: Utility.getAppHexColor("darkBackground")
            radius: cardStyle.radius
            border.color: Qt.rgba(1, 1, 1, 0.1)
            border.width: 1
        }

        // True while a preset is filling the controls. Their change handlers skip
        // sending during that, and one sim-load goes out afterwards - twelve separate
        // packets would put the board through eleven states nobody asked for.
        property bool pushing: false

        onOpened: {
            simOn = true
            sendSim("(sim-on)")
            simPushAll()
        }

        // Closing hands telemetry back, on Escape and on the Close button alike.
        onClosed: {
            simOn = false
            sendSim("(sim-off)")
        }

        // ...and on losing the link. A popup left open across a disconnect would
        // show live controls for a test mode that is not running, and the
        // (sim-off) on close would go nowhere.
        property bool linkUp: !statusTimeout
        onLinkUpChanged: if (!linkUp && opened) close()

        // A child rather than contentItem itself, which is how the About dialog
        // does it. Set as contentItem, anchors.fill made it fill the whole Popup
        // and the padding above did nothing - the title sat against the top edge
        // and the controls against the sides.
        ColumnLayout {
            anchors.fill: parent
            spacing: 12

            Text {
                text: "Test Mode"
                color: Utility.getAppHexColor("lightText")
                font.bold: true
                font.pointSize: 16
                Layout.alignment: Qt.AlignHCenter
            }

            ScrollView {
                id: simScroll
                Layout.fillWidth: true
                Layout.fillHeight: true
                clip: true
                // On top of the dialog's own padding, so the controls are inset
                // from the edge and clear of the vertical scrollbar. availableWidth
                // accounts for both, so the column below still sizes correctly.
                leftPadding: 4
                rightPadding: 12
                contentWidth: availableWidth
                ScrollBar.horizontal.policy: ScrollBar.AlwaysOff

                ColumnLayout {
                    width: simScroll.availableWidth
                    spacing: cardStyle.fieldSpacing

                    Text {
                        Layout.fillWidth: true
                        wrapMode: Text.WordWrap
                        color: fieldLabelStyle.color
                        font.pixelSize: fieldLabelStyle.pixelSize - 2
                        text: "Fakes the telemetry the package reads, so you can check every status with no board attached. " +
                              "Safe to use with a board connected - its real values are ignored while this is on. " +
                              "RAM only: it turns itself off when the board reboots."
                    }

                    Text {
                        Layout.fillWidth: true
                        wrapMode: Text.WordWrap
                        color: !simOn ? fieldLabelStyle.color : "#8fdc8f"
                        font.pixelSize: fieldLabelStyle.pixelSize
                        font.bold: true
                        text: !simOn ? "Test mode: OFF" : "Test mode: ON"
                    }

                    // Presets. Purely a convenience for filling the controls: the
                    // combinations that produce each status are the part worth
                    // remembering (tiltback is sat > 2 AND rpm > 250, mall grab is
                    // pitch > 70 AND not running AND both pads), and nobody should
                    // have to read led.lisp to reproduce one.
                    ColumnLayout {
                        spacing: cardStyle.labelSpacing
                        Layout.fillWidth: true
                        Text {
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            color: fieldLabelStyle.color
                            font.pixelSize: fieldLabelStyle.pixelSize
                            font.bold: fieldLabelStyle.bold
                            text: "Preset - fills the values below"
                        }
                        ComboBox {
                            id: simPreset
                            Layout.fillWidth: true
                            textRole: "text"
                            model: [
                                {text: "Connecting",       st: 0,  sw: 0, sat: 2, rpm:     0, duty: 0.00, phase:  0.00, bat:  0.00, batt: 0.55, pitch:  0, chg: false, hand: false, link: false},
                                {text: "Idle",             st: 0,  sw: 0, sat: 2, rpm:     0, duty: 0.00, phase:  0.00, bat:  0.00, batt: 0.55, pitch:  0, chg: false, hand: false, link: true},
                                {text: "Idle, low batt",   st: 0,  sw: 0, sat: 2, rpm:     0, duty: 0.00, phase:  0.00, bat:  0.00, batt: 0.08, pitch:  0, chg: false, hand: false, link: true},
                                {text: "Charging",         st: 0,  sw: 0, sat: 2, rpm:     0, duty: 0.00, phase:  0.00, bat:  0.00, batt: 0.42, pitch:  0, chg: true,  hand: false, link: true},
                                {text: "Footpad left",     st: 0,  sw: 1, sat: 2, rpm:     0, duty: 0.00, phase:  0.00, bat:  0.00, batt: 0.55, pitch:  0, chg: false, hand: false, link: true},
                                {text: "Footpad right",    st: 0,  sw: 2, sat: 2, rpm:     0, duty: 0.00, phase:  0.00, bat:  0.00, batt: 0.55, pitch:  0, chg: false, hand: false, link: true},
                                {text: "Footpad both",     st: 0,  sw: 3, sat: 2, rpm:     0, duty: 0.00, phase:  0.00, bat:  0.00, batt: 0.55, pitch:  0, chg: false, hand: false, link: true},
                                {text: "Mall grab",        st: 0,  sw: 3, sat: 2, rpm:     0, duty: 0.00, phase:  0.00, bat:  0.00, batt: 0.55, pitch: 75, chg: false, hand: false, link: true},
                                {text: "Riding",           st: 1,  sw: 3, sat: 2, rpm:  1500, duty: 0.35, phase:  0.30, bat:  0.20, batt: 0.55, pitch:  2, chg: false, hand: false, link: true},
                                {text: "Duty warn",        st: 1,  sw: 3, sat: 2, rpm:  1800, duty: 0.65, phase:  0.45, bat:  0.35, batt: 0.50, pitch:  3, chg: false, hand: false, link: true},
                                {text: "Duty high",        st: 1,  sw: 3, sat: 2, rpm:  2200, duty: 0.85, phase:  0.55, bat:  0.45, batt: 0.45, pitch:  4, chg: false, hand: false, link: true},
                                {text: "Phase limited",    st: 1,  sw: 3, sat: 2, rpm:  1600, duty: 0.40, phase:  0.85, bat:  0.50, batt: 0.45, pitch:  4, chg: false, hand: false, link: true},
                                {text: "Hard braking",     st: 1,  sw: 3, sat: 2, rpm:  1400, duty: 0.30, phase: -0.75, bat: -0.90, batt: 0.80, pitch: -6, chg: false, hand: false, link: true},
                                {text: "Pad off at speed", st: 1,  sw: 1, sat: 2, rpm:  1500, duty: 0.35, phase:  0.30, bat:  0.20, batt: 0.55, pitch:  2, chg: false, hand: false, link: true},
                                {text: "Tiltback",         st: 2,  sw: 3, sat: 3, rpm:  2000, duty: 0.70, phase:  0.50, bat:  0.40, batt: 0.40, pitch:  6, chg: false, hand: false, link: true},
                                {text: "Wheelslip",        st: 3,  sw: 3, sat: 2, rpm:  1600, duty: 0.50, phase:  0.20, bat:  0.15, batt: 0.50, pitch:  2, chg: false, hand: false, link: true},
                                {text: "Reverse",          st: 1,  sw: 3, sat: 2, rpm: -1500, duty: 0.35, phase:  0.30, bat:  0.20, batt: 0.50, pitch: -2, chg: false, hand: false, link: true},
                                {text: "Darkride",         st: 4,  sw: 3, sat: 2, rpm: -1500, duty: 0.40, phase:  0.35, bat:  0.25, batt: 0.50, pitch:  2, chg: false, hand: false, link: true},
                                {text: "Flywheel",         st: 5,  sw: 3, sat: 2, rpm:  1200, duty: 0.30, phase:  0.15, bat:  0.10, batt: 0.50, pitch:  0, chg: false, hand: false, link: true},
                                {text: "Fault - switch",   st: 8,  sw: 1, sat: 2, rpm:     0, duty: 0.00, phase:  0.00, bat:  0.00, batt: 0.55, pitch:  0, chg: false, hand: false, link: true},
                                {text: "Quickstop",        st: 13, sw: 0, sat: 2, rpm:     0, duty: 0.00, phase:  0.00, bat:  0.00, batt: 0.55, pitch:  0, chg: false, hand: false, link: true},
                                {text: "Disabled",         st: 15, sw: 0, sat: 2, rpm:     0, duty: 0.00, phase:  0.00, bat:  0.00, batt: 0.55, pitch:  0, chg: false, hand: false, link: true},
                                {text: "Hand test",        st: 0,  sw: 3, sat: 2, rpm:     0, duty: 0.00, phase:  0.00, bat:  0.00, batt: 0.55, pitch:  0, chg: false, hand: true,  link: true}
                            ]
                            currentIndex: 8
                            onActivated: simApplyPreset(model[currentIndex])
                        }
                    }

                    Text {
                        Layout.fillWidth: true
                        color: fieldLabelStyle.color
                        font.pixelSize: fieldLabelStyle.pixelSize
                        font.bold: true
                        text: "Values"
                    }

                    ColumnLayout {
                        spacing: cardStyle.labelSpacing
                        Layout.fillWidth: true
                        Text {
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            color: fieldLabelStyle.color
                            font.pixelSize: fieldLabelStyle.pixelSize
                            text: "Board state"
                        }
                        ComboBox {
                            id: simState
                            Layout.fillWidth: true
                            textRole: "text"
                            valueRole: "value"
                            // The state numbers the float/refloat packages report.
                            model: [
                                {text: "Startup (0)",           value: 0},
                                {text: "Running (1)",           value: 1},
                                {text: "Tiltback (2)",          value: 2},
                                {text: "Wheelslip (3)",         value: 3},
                                {text: "Upside down (4)",       value: 4},
                                {text: "Flywheel (5)",          value: 5},
                                {text: "Fault pitch (6)",       value: 6},
                                {text: "Fault roll (7)",        value: 7},
                                {text: "Fault switch half (8)", value: 8},
                                {text: "Fault switch full (9)", value: 9},
                                {text: "Fault startup (11)",    value: 11},
                                {text: "Fault reverse (12)",    value: 12},
                                {text: "Quickstop (13)",        value: 13},
                                {text: "Disabled (15)",         value: 15}
                            ]
                            currentIndex: 1
                            onActivated: simSend("sim-in-state", model[currentIndex].value)
                        }
                    }

                    ColumnLayout {
                        spacing: cardStyle.labelSpacing
                        Layout.fillWidth: true
                        Text {
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            color: fieldLabelStyle.color
                            font.pixelSize: fieldLabelStyle.pixelSize
                            text: "Footpad"
                        }
                        ComboBox {
                            id: simSwitch
                            Layout.fillWidth: true
                            textRole: "text"
                            valueRole: "value"
                            model: [
                                {text: "None",  value: 0},
                                {text: "Left",  value: 1},
                                {text: "Right", value: 2},
                                {text: "Both",  value: 3}
                            ]
                            currentIndex: 3
                            onActivated: simSend("sim-in-switch", model[currentIndex].value)
                        }
                    }

                    ColumnLayout {
                        spacing: cardStyle.labelSpacing
                        Layout.fillWidth: true
                        Text {
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            color: fieldLabelStyle.color
                            font.pixelSize: fieldLabelStyle.pixelSize
                            text: "Tiltback - above None is what strobes the status bar red"
                        }
                        ComboBox {
                            id: simSat
                            Layout.fillWidth: true
                            textRole: "text"
                            valueRole: "value"
                            model: [
                                {text: "Centering (0)",   value: 0},
                                {text: "Reversestop (1)", value: 1},
                                {text: "None (2)",        value: 2},
                                {text: "Duty (3)",        value: 3},
                                {text: "High volts (4)",  value: 4},
                                {text: "Low volts (5)",   value: 5}
                            ]
                            currentIndex: 2
                            onActivated: simSend("sim-in-sat", model[currentIndex].value)
                        }
                    }

                    ColumnLayout {
                        spacing: cardStyle.labelSpacing
                        Layout.fillWidth: true
                        Text {
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            color: fieldLabelStyle.color
                            font.pixelSize: fieldLabelStyle.pixelSize
                            text: "Speed (erpm) - negative is reverse. Direction commits past ±100, after a short debounce."
                        }
                        Loader {
                            id: simRpmLoader
                            sourceComponent: customValueSlider
                            onLoaded: {
                                item.from = -3000.0
                                item.to = 3000.0
                                // Snapped so the value is a round number, both in
                                // the bubble and in the (setq ...) that follows.
                                item.stepSize = 25
                                item.snapMode = Slider.SnapAlways
                                item.formatValue = function(v) { return v.toFixed(0) }
                                item.value = 1500.0
                                item.valueChanged.connect(function() {
                                    if (!simPopup.pushing)
                                        simSendFThrottled("sim-in-rpm", simRpmLoader.item.value)
                                })
                                item.interactionReleased.connect(function() {
                                    simFlushSlider("sim-in-rpm", simRpmLoader.item.value)
                                })
                            }
                        }
                    }

                    ColumnLayout {
                        spacing: cardStyle.labelSpacing
                        Layout.fillWidth: true
                        Text {
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            color: fieldLabelStyle.color
                            font.pixelSize: fieldLabelStyle.pixelSize
                            text: "Duty cycle - bar turns yellow past 60%, red past 80%. Shown whenever Board state is running."
                        }
                        Loader {
                            id: simDutyLoader
                            sourceComponent: customValueSlider
                            onLoaded: {
                                item.from = 0.0
                                item.to = 1.0
                                item.stepSize = 0.01
                                item.snapMode = Slider.SnapAlways
                                item.value = 0.35
                                item.asPercent = true
                                item.valueChanged.connect(function() {
                                    if (!simPopup.pushing)
                                        simSendFThrottled("sim-in-duty", simDutyLoader.item.value)
                                })
                                item.interactionReleased.connect(function() {
                                    simFlushSlider("sim-in-duty", simDutyLoader.item.value)
                                })
                            }
                        }
                    }

                    ColumnLayout {
                        spacing: cardStyle.labelSpacing
                        Layout.fillWidth: true
                        Text {
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            color: fieldLabelStyle.color
                            font.pixelSize: fieldLabelStyle.pixelSize
                            text: "Phase utilization - motor current against the ESC limit, negative is braking. Sent to the remote."
                        }
                        Loader {
                            id: simPhaseLoader
                            sourceComponent: customValueSlider
                            onLoaded: {
                                item.from = -1.0
                                item.to = 1.0
                                item.stepSize = 0.01
                                item.snapMode = Slider.SnapAlways
                                item.value = 0.30
                                item.formatValue = function(v) { return Math.round(v * 100) + "%" }
                                item.valueChanged.connect(function() {
                                    if (!simPopup.pushing)
                                        simSendFThrottled("sim-in-phase", simPhaseLoader.item.value)
                                })
                                item.interactionReleased.connect(function() {
                                    simFlushSlider("sim-in-phase", simPhaseLoader.item.value)
                                })
                            }
                        }
                    }

                    ColumnLayout {
                        spacing: cardStyle.labelSpacing
                        Layout.fillWidth: true
                        Text {
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            color: fieldLabelStyle.color
                            font.pixelSize: fieldLabelStyle.pixelSize
                            text: "Battery utilization - battery current against the ESC limit, negative is regen. Sent to the remote."
                        }
                        Loader {
                            id: simBatLoader
                            sourceComponent: customValueSlider
                            onLoaded: {
                                item.from = -1.0
                                item.to = 1.0
                                item.stepSize = 0.01
                                item.snapMode = Slider.SnapAlways
                                item.value = 0.20
                                item.formatValue = function(v) { return Math.round(v * 100) + "%" }
                                item.valueChanged.connect(function() {
                                    if (!simPopup.pushing)
                                        simSendFThrottled("sim-in-bat", simBatLoader.item.value)
                                })
                                item.interactionReleased.connect(function() {
                                    simFlushSlider("sim-in-bat", simBatLoader.item.value)
                                })
                            }
                        }
                    }

                    ColumnLayout {
                        spacing: cardStyle.labelSpacing
                        Layout.fillWidth: true
                        Text {
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            color: fieldLabelStyle.color
                            font.pixelSize: fieldLabelStyle.pixelSize
                            text: "Pitch angle - past 70 is mall grab, but only while Board state is not a running one."
                        }
                        Loader {
                            id: simPitchLoader
                            sourceComponent: customValueSlider
                            onLoaded: {
                                item.from = -90.0
                                item.to = 90.0
                                item.stepSize = 1
                                item.snapMode = Slider.SnapAlways
                                item.formatValue = function(v) { return v.toFixed(0) + "°" }
                                item.value = 0.0
                                item.valueChanged.connect(function() {
                                    if (!simPopup.pushing)
                                        simSendFThrottled("sim-in-pitch", simPitchLoader.item.value)
                                })
                                item.interactionReleased.connect(function() {
                                    simFlushSlider("sim-in-pitch", simPitchLoader.item.value)
                                })
                            }
                        }
                    }

                    ColumnLayout {
                        spacing: cardStyle.labelSpacing
                        Layout.fillWidth: true
                        Text {
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            color: fieldLabelStyle.color
                            font.pixelSize: fieldLabelStyle.pixelSize
                            text: "Battery - drives the gauge on the status and button strips"
                        }
                        Loader {
                            id: simBattLoader
                            sourceComponent: customValueSlider
                            onLoaded: {
                                item.from = 0.0
                                item.to = 1.0
                                item.stepSize = 0.01
                                item.snapMode = Slider.SnapAlways
                                item.value = 0.55
                                item.asPercent = true
                                item.valueChanged.connect(function() {
                                    if (!simPopup.pushing)
                                        simSendFThrottled("sim-in-batt", simBattLoader.item.value)
                                })
                                item.interactionReleased.connect(function() {
                                    simFlushSlider("sim-in-batt", simBattLoader.item.value)
                                })
                            }
                        }
                    }

                    RowLayout {
                        Layout.fillWidth: true
                        spacing: 12
                        CheckBox {
                            id: simCharging
                            text: "Charging"
                            onToggled: simSendB("sim-in-charging", checked)
                        }
                        CheckBox {
                            id: simHandtest
                            text: "Hand test"
                            onToggled: simSendB("sim-in-handtest", checked)
                        }
                        CheckBox {
                            id: simLink
                            text: "Link up"
                            checked: true
                            onToggled: simSendB("sim-in-link", checked)
                        }
                    }

                    Text {
                        Layout.fillWidth: true
                        wrapMode: Text.WordWrap
                        color: fieldLabelStyle.color
                        font.pixelSize: fieldLabelStyle.pixelSize - 2
                        text: "Link up off reports no ESC and a stale link, which is what the status bar shows as " +
                              "\"connecting\". Speed, voltage, currents and temperatures are derived from the values " +
                              "above rather than set here, so the telemetry page cannot be made to describe an " +
                              "impossible board."
                    }
                }
            }

            Button {
                text: "Close"
                Layout.fillWidth: true
                highlighted: true
                onClicked: simPopup.close()
            }
        }
    }


    Popup {
        id: keySettingPopup
        modal: true
        focus: true
        visible: false
        width: parent.width * 0.8
        height: parent.height * 0.3
        anchors.centerIn: parent

        background: Rectangle {
            color: "black"
            radius: 10
        }

        contentItem: ColumnLayout {
            anchors.fill: parent
            anchors.margins: 20
            spacing: 10

            Text {
                text: "Set Keys"
                color: "white"
                font.pointSize: 16
                Layout.alignment: Qt.AlignHCenter
            }

            TextField {
                id: keyInput
                placeholderText: "Enter Key (16 hex bytes, e.g., FFAABBCC...)"
                Layout.fillWidth: true
            }

            TextField {
                id: counterInput
                placeholderText: "Enter Counter (16 hex bytes, e.g., FFAABBCC...)"
                Layout.fillWidth: true
            }

            Button {
                id: submitButton
                text: "Submit"
                Layout.alignment: Qt.AlignHCenter
                onClicked: {
                    var keyHex = keyInput.text.replace(/[^0-9A-Fa-f]/g, '');
                    var counterHex = counterInput.text.replace(/[^0-9A-Fa-f]/g, '');

                    if (keyHex.length === 32 && counterHex.length === 32) {
                        console.log("Key: " + keyHex);
                        console.log("Counter: " + counterHex);

                        var keyList = hexStringToLispList(keyHex);
                        var counterList = hexStringToLispList(counterHex);

                        var sendKeysString = "(bms-pair " + keyList + " " + counterList + ")";
                        console.log("Sending: " + sendKeysString);
                        sendCode(String.fromCharCode(102) + String.fromCharCode(1) + sendKeysString);

                        keySettingPopup.close();
                    } else {
                        console.error("Invalid input: Both key and counter must result in 4 uint32 values each")
                    }
                }
            }
        }
    }

    // BMS terms of service, styled like the pubmote pairing dialog.
    Dialog {
        id: termsPopup
        modal: true
        focus: true
        // Whole pixels: centerIn can land on a half pixel, which blurs the Material
        // buttons' shadow layer and makes them look tilted on high-DPI phones.
        x: Math.round((parent.width - width) / 2)
        y: Math.round((parent.height - height) / 2)
        width: Math.min(container.width - 20, 400)
        height: Math.min(container.height - 40, 560)

        // Match the rounding of the standard cards elsewhere in the UI.
        background: Rectangle {
            color: Utility.getAppHexColor("darkBackground")
            radius: cardStyle.radius
            border.color: Qt.rgba(1, 1, 1, 0.1)
            border.width: 1
        }

        ColumnLayout {
            anchors.fill: parent
            spacing: 12

            Text {
                text: "Terms of Service"
                color: "white"
                font.bold: true
                font.pixelSize: 15
                Layout.alignment: Qt.AlignHCenter
            }

            ScrollView {
                Layout.fillWidth: true
                Layout.fillHeight: true
                clip: true
                ScrollBar.horizontal.policy: ScrollBar.AlwaysOff
                background: Rectangle { color: cardStyle.scrollViewBg; radius: 8 }

                TextArea {
                    id: termsText
                    textFormat: Text.RichText
                    text: "<p>WARNING NOTICE:</p>" +
                        "<p>This code is released as part of legitimate security research and is intended to enable interoperability between a specific Battery Management System (BMS) and aftermarket Electronic Speed Controllers (ESCs) for a widely used motorized land vehicle. This vehicle is often utilized as a mobility aid for individuals with disabilities, such as those with Hidradenitis Suppurativa, which prevents the use of traditional mobility devices.</p>" +
                        "<p>The publication of this code is an exercise of the right to free speech and expression, protected under the First Amendment of the U.S. Constitution. Furthermore, this code is released in accordance with both the security research exception under DMCA Section 1201(g) and the exemption for motorized land vehicles, which allows the circumvention of technological protection measures (TPMs) for the purposes of repair, modification, and interoperability under the Librarian of Congress's 2015 ruling and subsequent triennial exemptions. This exemption applies specifically to vehicle software, including Battery Management Systems, and permits this work for diagnostic and modification purposes.</p>" +
                        "<p>This system lacks manufacturer-provided documentation or tools for repair. Currently, consumers are forced to replace the entire battery, enclosure, and BMS at significant cost, rather than repairing individual components. We are providing the necessary documentation and tools to facilitate the repair of these systems, enabling consumers to extend the life of their devices.</p>" +
                        "<p>This publication is further supported by the California Right to Repair Act (SB 244), which took full effect on July 1, 2024. Under this law, consumers and independent repair providers are entitled to access the tools, parts, and documentation necessary to perform repairs on electronics and appliances sold or used in California, reinforcing the legality and public interest of this code publication. Although some exceptions apply, this law affirms the right to repair motorized vehicles, aligning with the purpose of this research and promoting repairability and consumer choice.</p>" +
                        "<p>Additionally, this publication is protected under Washington's Revised Code of Washington (RCW) § 4.24.525 and California Code of Civil Procedure § 425.16, which are anti-SLAPP laws designed to prevent lawsuits aimed at intimidating or silencing lawful speech on matters of public interest. Any attempt to interfere with or litigate against the publication of this code may result in the dismissal of such legal actions, with the imposition of attorney's fees and statutory damages.</p>" +
                        "<p>Furthermore, the motor land vehicle this BMS resides in had its advertised speed reduced during a software update for the haptic buzz feature. This change constitutes a violation of Article 6(1)(a) of the EU Directive 2005/29/EC on Unfair Commercial Practices, which prohibits misleading actions that affect the consumer's decision to purchase or retain a product. Reducing the performance of previously purchased products, is deemed unfair under EU law, particularly as consumers were not informed or compensated for this loss of functionality.</p>" +
                        "<p>Moreover, the haptic feedback feature remains insufficiently implemented. On uneven terrains such as trails, the vibration cannot be felt effectively, and the audio feedback is may sometimes be too quiet to be useful, especially for individuals with disabilities like hearing impairments. This code addresses these deficiencies by allowing use with ESCs that allow real-time interoperability with third-party phone applications that provide customizable alerts through speakers, or headphones, improving accessibility, safety, and overall user experience."
                    color: Utility.getAppHexColor("lightText")
                    wrapMode: Text.Wrap
                    readOnly: true
                    background: null
                    onLinkActivated: function(url) {
                        Qt.openUrlExternally(url)
                    }
                }
            }

            CheckBox {
                id: acceptCheckBox
                text: "I have read and accept the Terms of Service."
                checked: false
                onCheckedChanged: {
                    acceptButton.enabled = checked
                }
            }

            RowLayout {
                Layout.fillWidth: true
                spacing: 10

                Button {
                    text: "Cancel"
                    Layout.fillWidth: true
                    Layout.preferredWidth: 1  // even split, not by label width
                    onClicked: {
                        termsPopup.close()
                        bmsEnabled.checked = false
                        VescIf.emitMessageDialog("Float Accessories", "You must accept the Terms of Service to continue with BMS features.", false, false)
                    }
                }

                Button {
                    id: acceptButton
                    text: "Accept"
                    Layout.fillWidth: true
                    Layout.preferredWidth: 1  // even split, not by label width
                    highlighted: true
                    enabled: acceptCheckBox.checked
                    onClicked: {
                        acceptTOS = true
                        termsPopup.close()
                        sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(accept-tos)")
                    }
                }
            }
        }
    }

    // About dialog, opened from the (i) button in the title bar (was a tab).
    Dialog {
        id: aboutDialog
        modal: true
        focus: true
        anchors.centerIn: parent
        width: Math.min(container.width - 20, 400)
        height: Math.min(container.height - 40, 520)
        background: Rectangle {
            color: Utility.getAppHexColor("darkBackground")
            radius: cardStyle.radius
            border.color: Qt.rgba(1, 1, 1, 0.1)
            border.width: 1
        }

        ColumnLayout {
            anchors.fill: parent
            spacing: 12

            ScrollView {
                Layout.fillWidth: true
                Layout.fillHeight: true
                clip: true
                ScrollBar.horizontal.policy: ScrollBar.AlwaysOff

            TextArea {
                textFormat: Text.RichText
                text: Utility.md2html("{{ABOUT_MD}}")
                wrapMode: Text.WordWrap
                readOnly: true
                color: Utility.getAppHexColor("lightText")
                background: null
                onLinkActivated: function(url) {
                    Qt.openUrlExternally(url)
                }
            }
            }

            Button {
                text: "Close"
                Layout.fillWidth: true
                highlighted: true
                onClicked: aboutDialog.close()
            }
        }
    }

    ColumnLayout {
        id: mainLayout
        anchors.fill: parent
        spacing: 10
        // Status used to live on the Control tab and gave it its name when no
        // feature was on. It is in the header pill now, so with every feature
        // off that tab holds nothing at all and hides itself.
        property bool hasControlContent: ledEnabled.checked || owBmsEnabled || logEnabled.checked
        property int enabledFeatureCount: ledEnabled.checked + pubmoteEnabled.checked + bmsEnabled.checked + logEnabled.checked + gnssEnabled.checked

        // Control (0) and Config (1) each hide themselves when they have
        // nothing to show, so keep the selection off a hidden tab. Settings
        // (2) is always there as the fallback.
        function settleTabSelection() {
            // Nothing to settle before a config has ever landed: the tabs are
            // hidden behind the loading pane, and every feature flag is still
            // at its unchecked default.
            if (!readConfig) {
                return
            }
            if (tabBar.currentIndex === 0 && !hasControlContent) {
                tabBar.currentIndex = enabledFeatureCount > 0 ? 1 : 2
            } else if (tabBar.currentIndex === 1 && enabledFeatureCount === 0) {
                tabBar.currentIndex = hasControlContent ? 0 : 2
            }
        }

                // Coalesced rather than stored per change: a config write is an NVS
                // write, and dragging a slider would issue one per sample.
        Timer {
            id: settleTabTimer
            interval: 0
            onTriggered: mainLayout.settleTabSelection()
        }

        onEnabledFeatureCountChanged: settleTabTimer.restart()
        onHasControlContentChanged: settleTabTimer.restart()

        Item {
            id: headerBar
            Layout.fillWidth: true
            Layout.topMargin: 10
            implicitHeight: Math.max(appTitleText.implicitHeight, statusPill.height)

            readonly property real gutter: 10
            readonly property real pillGap: 8

            // Width the pill wants with its label showing. Measured off
            // TextMetrics rather than the label itself: the label is hidden
            // when the pill collapses, so measuring the live item would make
            // the collapse depend on its own outcome.
            readonly property real pillFullWidth: pillMetrics.width + 8 + 6 + 20

            // Keeping the title dead centre means reserving the pill's width
            // on the empty left side too, which on a phone-width window
            // leaves the title nothing. Drop the pill's label and show just
            // the dot when both won't fit; the colour still carries the state
            // and the popover has the words.
            readonly property bool pillCompact:
                width > 0 && (width - 2 * (pillFullWidth + gutter + pillGap)) < appTitleText.implicitWidth

            TextMetrics {
                id: pillMetrics
                font.pixelSize: 12
                font.bold: true
                text: statusSummary.pillText
            }

            Text {
                id: appTitleText
                anchors.centerIn: parent
                width: Math.max(0, parent.width - 2 * (statusPill.width + parent.gutter + parent.pillGap))
                horizontalAlignment: Text.AlignHCenter
                elide: Text.ElideRight
                color: Utility.getAppHexColor("lightText")
                font.pointSize: 20
                font.bold: true
                text: "Float Accessories"
            }

            // Current status at a glance; tap for the full breakdown.
            Rectangle {
                id: statusPill
                anchors.right: parent.right
                anchors.rightMargin: headerBar.gutter
                anchors.verticalCenter: parent.verticalCenter
                height: 26
                width: headerBar.pillCompact ? height : headerBar.pillFullWidth
                radius: height / 2
                color: Qt.rgba(statusSummary.pillColor.r, statusSummary.pillColor.g,
                               statusSummary.pillColor.b, statusPillMouse.pressed ? 0.30 : 0.16)
                border.width: 1
                border.color: Qt.rgba(statusSummary.pillColor.r, statusSummary.pillColor.g,
                                      statusSummary.pillColor.b, 0.55)

                Behavior on color { ColorAnimation { duration: 150 } }

                RowLayout {
                    id: pillContent
                    anchors.centerIn: parent
                    spacing: 6

                    Rectangle {
                        Layout.alignment: Qt.AlignVCenter
                        width: 8
                        height: 8
                        radius: 4
                        color: statusSummary.pillColor
                    }

                    Text {
                        Layout.alignment: Qt.AlignVCenter
                        visible: !headerBar.pillCompact
                        text: statusSummary.pillText
                        color: Utility.getAppHexColor("lightText")
                        font.pixelSize: 12
                        font.bold: true
                    }
                }

                MouseArea {
                    id: statusPillMouse
                    anchors.fill: parent
                    onClicked: statusPopup.opened ? statusPopup.close() : statusPopup.open()
                }

                Popup {
                    id: statusPopup
                    // Right-aligned under the pill, which sits at the right
                    // edge of the header.
                    x: statusPill.width - width
                    y: statusPill.height + 8
                    width: Math.min(340, container.width - 20)
                    padding: 14
                    modal: true
                    dim: false
                    closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside | Popup.CloseOnReleaseOutside

                    background: Rectangle {
                        color: Utility.getAppHexColor("darkBackground")
                        border.color: Qt.rgba(1, 1, 1, 0.18)
                        border.width: 1
                        radius: 12
                    }

                    contentItem: ColumnLayout {
                        spacing: 6

                        Text {
                            Layout.fillWidth: true
                            Layout.bottomMargin: 2
                            color: Qt.rgba(1, 1, 1, 0.55)
                            font.pixelSize: 12
                            font.bold: true
                            text: qsTr("Status")
                        }

                        Rectangle {
                            Layout.fillWidth: true
                            Layout.bottomMargin: 4
                            height: 1
                            color: Qt.rgba(1, 1, 1, 0.12)
                        }

                        Text {
                            id: lastStatusText
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            color: statusSummary.severityColor(statusSummary.linkSeverity)
                            text: !statusTimeout ? "Status: Connected" : (lastStatusTime <= 60 ? "Status: Connecting (" + lastStatusTime + "s)" : "Status: Disconnected (" + lastStatusTime + "s)")
                        }

                        Text {
                            id: integrationStatus
                            visible: integrationEnabled && integrationConnectionState !== 0
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            property int effectiveTime: Math.max(integrationLastStatusTime, lastStatusTime)
                            color: statusSummary.severityColor(statusSummary.integrationSeverity)
                            text: (integrationSelector.currentText || qsTr("Integration")) + ": " + (statusTimeout ? "Unknown"
                                : integrationConnectionState === 2 ? "Connected"
                                : (integrationConnectionState === 1 ? "Connecting" : "Disconnected")
                                    + " (" + effectiveTime + "s)")
                        }

                        Text {
                            id: pubmoteStatus
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            visible: pubmoteEnabled.checked
                            property int effectiveTime: Math.max(pubmoteLastStatusTime, lastStatusTime)
                            color: statusSummary.severityColor(statusSummary.pubmoteSeverity)
                            text: !isPubmotePaired ? "Pubmote: Not Paired" : ("Pubmote : " + ((pubmoteConnected && !statusTimeout) ? (isPubmoteBle ? "Connected (BLE)" : "Connected (WiFi Channel " + (pubmoteWifiChannel ? pubmoteWifiChannel : "?") + ")") : (effectiveTime <= 60 ? "Connecting (" + effectiveTime + "s)" : "Disconnected (" + effectiveTime + "s)")))
                        }

                        Text {
                            id: gnssStatus
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            visible: gnssEnabled.checked
                            color: statusSummary.severityColor(statusSummary.gnssSeverity)
                            text: statusTimeout ? "GNSS: Unknown"
                                : (gnssFix ? "GNSS: Fix (HDOP " + gnssHdop.toFixed(1) + ", " + (gnssSpeed * 3.6).toFixed(1) + " km/h)"
                                : (gnssAge <= 10 ? "GNSS: Searching (no fix)" : "GNSS: No Signal"))
                        }

                        Text {
                            id: bmsStatus
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            color: statusSummary.severityColor(statusSummary.bmsSeverity)
                            text: bmsBackend.currentIndex === 0 ? "BMS: No backend selected"
                                : (ssbmsBleSelected && expressBleClientMissing) ? "SSBMS BLE: Express Bluetooth LispBM role must include Client"
                                : (ssbmsUartSelected ? "SSBMS UART: " : (ssbmsBleSelected ? "SSBMS BLE: " : "OW BMS: "))
                                    + (statusTimeout ? "Unknown" : (bmsConnected ? "Connected" : "Not Connected"))
                            visible: bmsEnabled.checked
                        }

                        Text {
                            id: bmsHumStatus
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            color: statusSummary.severityColor(statusSummary.bmsHumSeverity)
                            text: "BMS Humidity: " + ((!statusTimeout && bmsHum > 0) ? bmsHum + "%" : "Unknown")
                            visible: owBmsEnabled && humidityEnabled.checked
                        }

                        Text {
                            id: bmsHumTempStatus
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            color: (!statusTimeout && bmsHum > 0) ? statusSummary.okColor : statusSummary.idleColor
                            text: "BMS Temp: " + ((!statusTimeout && bmsHum > 0) ? Math.floor((bmsHumTemp * 1.8 + 32) * 100)/100 +"F " + bmsHumTemp + "C" : "Unknown")
                            visible: owBmsEnabled
                        }

                        Text {
                            id: humidityStatus
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            color: statusSummary.severityColor(statusSummary.lcmHumSeverity)
                            text: "LCM Humidity: " + ((!statusTimeout && lcmHum > 0) ? lcmHum + "%" : "Unknown")
                            visible: humidityEnabled.checked
                        }

                        Text {
                            id: humidityTempStatus
                            Layout.fillWidth: true
                            wrapMode: Text.WordWrap
                            color: (!statusTimeout && lcmHum > 0) ? statusSummary.okColor : statusSummary.idleColor
                            text: "LCM Temp: " + ((!statusTimeout && lcmHum > 0) ? Math.floor((lcmHumTemp * 1.8 + 32) * 100)/100 +"F " + lcmHumTemp + "C" : "Unknown")
                            visible: humidityEnabled.checked
                        }

                        Rectangle {
                            Layout.fillWidth: true
                            Layout.topMargin: 6
                            height: 1
                            color: Qt.rgba(1, 1, 1, 0.12)
                        }

                        // The About dialog used to hang off an "i" button in
                        // the header; it lives here now so the header carries
                        // the pill alone. Styled explicitly rather than left
                        // to the ambient Button style, which renders almost
                        // invisibly against this popup's background.
                        ItemDelegate {
                            Layout.fillWidth: true
                            Layout.preferredHeight: 34
                            padding: 0

                            contentItem: Text {
                                text: qsTr("About Float Accessories")
                                color: Utility.getAppHexColor("lightText")
                                verticalAlignment: Text.AlignVCenter
                                font.pixelSize: 13
                            }

                            onClicked: {
                                statusPopup.close()
                                aboutDialog.open()
                            }
                        }
                    }
                }
            }
        }

        // Config menu for selecting which config to show
        Menu {
            id: configMenu

            MenuItem {
                text: qsTr("Lights")
                visible: ledEnabled.checked
                height: visible ? implicitHeight : 0
                onTriggered: {
                    tabBar2.currentIndex = 0
                    tabBar.currentIndex = 1
                }
            }
            MenuItem {
                text: qsTr("Pubmote")
                visible: pubmoteEnabled.checked
                height: visible ? implicitHeight : 0
                onTriggered: {
                    tabBar2.currentIndex = 1
                    tabBar.currentIndex = 1
                }
            }
            MenuItem {
                text: qsTr("BMS")
                visible: bmsEnabled.checked
                height: visible ? implicitHeight : 0
                onTriggered: {
                    tabBar2.currentIndex = 2
                    tabBar.currentIndex = 1
                }
            }
            MenuItem {
                text: qsTr("Logging")
                visible: logEnabled.checked
                height: visible ? implicitHeight : 0
                onTriggered: {
                    tabBar2.currentIndex = 3
                    tabBar.currentIndex = 1
                }
            }
            MenuItem {
                text: qsTr("GNSS")
                visible: gnssEnabled.checked
                height: visible ? implicitHeight : 0
                onTriggered: {
                    tabBar2.currentIndex = 4
                    tabBar.currentIndex = 1
                }
            }
        }

        // Until the board's settings have landed there is nothing worth
        // showing: every feature checkbox is still unchecked, so the tabs
        // appear and disappear underneath the user as the config arrives.
        // readConfig is a one-way latch - once we have seen a config the tabs
        // stay put through any later dropout, and this never comes back.
        Item {
            id: loadingPane
            Layout.fillWidth: true
            Layout.fillHeight: true
            visible: !packageReady

            ColumnLayout {
                anchors.centerIn: parent
                spacing: 16

                // Progress marks completed stages, rather than estimating time.
                ProgressBar {
                    Layout.alignment: Qt.AlignHCenter
                    Layout.preferredWidth: Math.min(320, Math.max(0, loadingPane.width - 48))
                    from: 0
                    to: 5
                    value: packageReady ? 5 : Math.max(0, bootProgressStep() - 1)
                    indeterminate: loadingPane.visible && (bootState === container.bootWaiting
                        || bootState === container.bootLoadingCode)
                    visible: bootState !== container.bootFailed
                }

                Text {
                    Layout.alignment: Qt.AlignHCenter
                    color: Qt.rgba(1, 1, 1, 0.6)
                    visible: bootProgressStep() > 0
                    text: qsTr("Step %1 of 5").arg(bootProgressStep())
                }

                Text {
                    Layout.alignment: Qt.AlignHCenter
                    horizontalAlignment: Text.AlignHCenter
                    color: Qt.rgba(1, 1, 1, 0.6)
                    Layout.maximumWidth: Math.max(0, loadingPane.width - 32)
                    wrapMode: Text.WordWrap
                    text: bootStatusText()
                }
            }
        }

        TabBar {
            id: tabBar
            Layout.fillWidth: true
            visible: packageReady

            TabButton {
                id: primaryTabButton
                text: qsTr("Control")
                font.capitalization: Font.MixedCase
                enabled: mainLayout.hasControlContent
                visible: mainLayout.hasControlContent
                Layout.fillWidth: true
                Layout.maximumWidth: mainLayout.hasControlContent ? Number.POSITIVE_INFINITY : 0
                width: mainLayout.hasControlContent ? undefined : 0
                contentItem: Text {
                    text: primaryTabButton.text
                    font: primaryTabButton.font
                    color: primaryTabButton.checked ? "white" : Qt.rgba(1, 1, 1, 0.54)
                    horizontalAlignment: Text.AlignHCenter
                    verticalAlignment: Text.AlignVCenter
                }
            }

            TabButton {
                id: configTabButton
                text: qsTr("Config")
                font.capitalization: Font.MixedCase
                enabled: mainLayout.enabledFeatureCount > 0
                visible: mainLayout.enabledFeatureCount > 0
                Layout.fillWidth: true
                Layout.maximumWidth: mainLayout.enabledFeatureCount > 0 ? Number.POSITIVE_INFINITY : 0
                width: mainLayout.enabledFeatureCount > 0 ? undefined : 0

                contentItem: Item {
                    implicitWidth: labelText.implicitWidth + (chevronCanvas.visible ? chevronCanvas.width + 4 : 0)
                    implicitHeight: labelText.implicitHeight

                    property color textColor: configTabButton.checked ? "white" : Qt.rgba(1, 1, 1, 0.54)

                    Text {
                        id: labelText
                        text: qsTr("Config")
                        font: configTabButton.font
                        color: parent.textColor
                        anchors.centerIn: parent
                        anchors.horizontalCenterOffset: chevronCanvas.visible ? -(chevronCanvas.width + 4) / 2 : 0
                    }

                    Canvas {
                        id: chevronCanvas
                        width: 14
                        height: 14
                        visible: mainLayout.enabledFeatureCount > 1
                        anchors.left: labelText.right
                        anchors.leftMargin: 4
                        anchors.verticalCenter: parent.verticalCenter

                        property color strokeColor: parent.textColor
                        onStrokeColorChanged: requestPaint()

                        onPaint: {
                            var ctx = getContext("2d")
                            ctx.clearRect(0, 0, width, height)
                            ctx.strokeStyle = strokeColor
                            ctx.lineWidth = 1.5
                            ctx.lineCap = "round"
                            ctx.lineJoin = "round"
                            var s = 14 / 24
                            ctx.beginPath()
                            ctx.moveTo(6 * s, 9 * s)
                            ctx.lineTo(12 * s, 15 * s)
                            ctx.lineTo(18 * s, 9 * s)
                            ctx.stroke()
                        }
                    }
                }

                onClicked: {
                    if (mainLayout.enabledFeatureCount > 1) {
                        configMenu.popup(configTabButton, 0, configTabButton.height)
                    } else {
                        if (ledEnabled.checked) tabBar2.currentIndex = 0
                        else if (pubmoteEnabled.checked) tabBar2.currentIndex = 1
                        else if (bmsEnabled.checked) tabBar2.currentIndex = 2
                        else if (logEnabled.checked) tabBar2.currentIndex = 3
                        else if (gnssEnabled.checked) tabBar2.currentIndex = 4
                    }
                }
            }

            TabButton {
                id: settingsTabButton
                text: qsTr("Settings")
                font.capitalization: Font.MixedCase
                Layout.fillWidth: true
                contentItem: Text {
                    text: settingsTabButton.text
                    font: settingsTabButton.font
                    color: settingsTabButton.checked ? "white" : Qt.rgba(1, 1, 1, 0.54)
                    horizontalAlignment: Text.AlignHCenter
                    verticalAlignment: Text.AlignVCenter
                }
            }

        }

        TabBar {
            id: tabBar2
            Layout.fillWidth: true
            visible: false  // Hidden - using menu instead

            // Update enabled indices when checkboxes change
            Component.onCompleted: updateEnabledIndices()

            Connections {
                target: ledEnabled
                function onCheckedChanged() { updateEnabledIndices() }
            }

            Connections {
                target: pubmoteEnabled
                function onCheckedChanged() { updateEnabledIndices() }
            }

            Connections {
                target: bmsEnabled
                function onCheckedChanged() { updateEnabledIndices() }
            }

            Connections {
                target: logEnabled
                function onCheckedChanged() { updateEnabledIndices() }
            }

            Connections {
                target: gnssEnabled
                function onCheckedChanged() { updateEnabledIndices() }
            }

            TabButton {
                text: qsTr("Lights")
                enabled: ledEnabled.checked
                visible: ledEnabled.checked
                width: ledEnabled.checked ? implicitWidth : 0
            }

            TabButton {
                text: qsTr("Pubmote")
                enabled: pubmoteEnabled.checked
                visible: pubmoteEnabled.checked
                width: pubmoteEnabled.checked ? implicitWidth : 0
            }

            TabButton {
                text: qsTr("BMS")
                enabled: bmsEnabled.checked
                visible: bmsEnabled.checked
                width: bmsEnabled.checked ? implicitWidth : 0
            }
            TabButton {
                text: qsTr("Logging")
                enabled: logEnabled.checked
                visible: logEnabled.checked
                width: logEnabled.checked ? implicitWidth : 0
            }
            TabButton {
                text: qsTr("GNSS")
                enabled: gnssEnabled.checked
                visible: gnssEnabled.checked
                width: gnssEnabled.checked ? implicitWidth : 0
            }
        }

        // Stack Layout
        StackLayout {
            id: stackLayout
            Layout.fillWidth: true
            Layout.fillHeight: true
            visible: packageReady
            currentIndex: tabBar.currentIndex

            // LED Control Tab
            ScrollView {
                clip: true
                ScrollBar.vertical.policy: ScrollBar.AsNeeded
                background: Rectangle { color: cardStyle.scrollViewBg }

                Item {
                    width: stackLayout.width
                    implicitHeight: scrollContent1.implicitHeight + cardStyle.scrollTopPadding + cardStyle.scrollBottomPadding

                    ColumnLayout {
                        id: scrollContent1
                        anchors.top: parent.top
                        anchors.left: parent.left
                        anchors.right: parent.right
                        anchors.topMargin: cardStyle.scrollTopPadding
                        anchors.leftMargin: cardStyle.scrollHPadding
                        anchors.rightMargin: cardStyle.scrollHPadding
                        spacing: 20

                    Timer {
                        id: throttleTimer
                        interval: 50  // 50ms throttle timer
                        repeat: false
                        property bool controlPending: false
                        onTriggered: {
                            if (controlPending) {
                                applyControlChanges()
                                controlPending = false
                            }
                        }
                    }

                    GroupBox {
                        title: "Light Control"
                        Layout.fillWidth: true
                        visible: ledEnabled.checked
                        background: Loader { sourceComponent: cardBg }
                        label: Item {
                            implicitHeight: 40
                            width: parent ? parent.width : 200

                            Text {
                                text: "Light Control"
                                color: "white"
                                font.bold: true
                                font.pixelSize: 15
                                anchors.left: parent.left
                                anchors.leftMargin: 12
                                anchors.verticalCenter: parent.verticalCenter
                            }
                            Loader {
                                id: ledOn
                                sourceComponent: customSwitch
                                anchors.right: parent.right
                                anchors.rightMargin: cardStyle.sidePadding
                                anchors.verticalCenter: parent.verticalCenter
                                property bool checked: item ? item.checked : false

                                onLoaded: {
                                    item.checked = true
                                    item.checkedChanged.connect(function() {
                                        ledOn.checked = item.checked
                                        handleDebouncedChange()
                                    })
                                }

                                onCheckedChanged: {
                                    if (item) item.checked = checked
                                }
                            }
                        }
                        topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding

                        ColumnLayout {
                            anchors.fill: parent
                            spacing: 6

                            ColumnLayout {
                                id: ledHighBeamLayout
                                visible: (
                                    ledOn.checked
                                    && (
                                        frontHbMode === 2
                                        || (frontHbMode === 1 && ledFrontHighbeamPin.value >= 0)
                                        || rearHbMode === 2
                                        || (rearHbMode === 1 && ledRearHighbeamPin.value >= 0)
                                    )
                                )
                                spacing: 10

                                CheckBox {
                                    id: ledHighbeamOn
                                    text: "LED Highbeam On"
                                    checked: true
                                    onCheckedChanged: {
                                        handleDebouncedChange()
                                    }
                                }
                            }

                            ColumnLayout {
                                id: ledOnLayout
                                visible: true
                                spacing: 10

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Brightness"
                                        opacity: ledOn.checked ? 1.0 : 0.4
                                    }
                                    Loader {
                                        id: ledBrightnessLoader
                                        enabled: ledOn.checked
                                        opacity: ledOn.checked ? 1.0 : 0.4
                                        sourceComponent: customValueSlider
                                        onLoaded: {
                                            item.from = 0.0
                                            item.to = 1.0
                                            item.value = 0.6
                                            item.asPercent = true
                                            item.valueChanged.connect(function() {
                                                    handleDebouncedChange()
                                            })
                                            item.interactionReleased.connect(function() {
                                                    flushControlChanges()
                                            })
                                        }
                                    }
                                }

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Idle Brightness"
                                        opacity: ledOn.checked ? 1.0 : 0.4
                                    }
                                    Loader {
                                        id: ledBrightnessIdleLoader
                                        enabled: ledOn.checked
                                        opacity: ledOn.checked ? 1.0 : 0.4
                                        sourceComponent: customValueSlider
                                        onLoaded: {
                                            item.from = 0.0
                                            item.to = 1.0
                                            item.value = 0.3
                                            item.asPercent = true
                                            item.valueChanged.connect(function() {
                                                    handleDebouncedChange()
                                            })
                                            item.interactionReleased.connect(function() {
                                                    flushControlChanges()
                                            })
                                        }
                                    }
                                }

                                ColumnLayout {
                                    id: ledStatusBrightnessLayout
                                    visible: ledStatusStripType.currentValue > 0 || ledMallGrabEnabled.checked
                                    spacing: cardStyle.labelSpacing

                                    Text {
                                        opacity: ledOn.checked ? 1.0 : 0.4
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: ledMallGrabEnabled.checked && ledStatusStripType.currentValue > 0 ? "Status/Mall Grab Brightness" : ledMallGrabEnabled.checked ? "Mall Grab Brightness" : "Status Brightness"
                                    }

                                    Loader {
                                        id: ledBrightnessStatusLoader
                                        enabled: ledOn.checked
                                        opacity: ledOn.checked ? 1.0 : 0.4
                                        sourceComponent: customValueSlider
                                        onLoaded: {
                                            item.from = 0.0
                                            item.to = 1.0
                                            item.value = 0.6
                                            item.asPercent = true
                                            item.valueChanged.connect(function() {
                                                    handleDebouncedChange()
                                            })
                                            item.interactionReleased.connect(function() {
                                                    flushControlChanges()
                                            })
                                        }
                                    }
                                }
                            }

                            ColumnLayout {
                                id: ledHighBeamBrightnessLayout
                                visible: (
                                    ledOn.checked
                                    && ledHighbeamOn.checked
                                    && (frontHbMode > 0 || rearHbMode > 0)
                                )
                                spacing: 2

                                Text {
                                    color: fieldLabelStyle.color
                                    font.pixelSize: fieldLabelStyle.pixelSize
                                    font.bold: fieldLabelStyle.bold
                                    text: "Highbeam Brightness"
                                }

                                Loader {
                                    id: ledBrightnessHighbeamLoader
                                    Layout.topMargin: -9
                                    sourceComponent: customValueSlider
                                    onLoaded: {
                                        item.from = 0.0
                                        item.to = 1.0
                                        item.value = 0.5
                                        item.asPercent = true
                                        item.valueChanged.connect(function() {
                                                handleDebouncedChange()
                                        })
                                        item.interactionReleased.connect(function() {
                                                flushControlChanges()
                                        })
                                    }
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Logging Control"
                        Layout.fillWidth: true
                        visible: logEnabled.checked
                        background: Loader { sourceComponent: cardBg }
                        label: Loader { sourceComponent: cardTitleLabel; onLoaded: item.title = "Logging Control" }
                        topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding

                        ColumnLayout {
                            anchors.fill: parent
                            spacing: 6

                            Text {
                                id: loggerStatus
                                Layout.fillWidth: true
                                color: statusTimeout ? "grey" : (loggerRunning ? "green" : Utility.getAppHexColor("lightText"))
                                text: statusTimeout ? "Logger Status: Unknown" : "Logger Status: " + (loggerRunning ? "Running" : "Not Running")
                            }

                            Button {
                                id: logStartButton
                                Layout.fillWidth: true
                                Layout.preferredWidth: 500
                                visible: !statusTimeout && !loggerRunning
                                text: "Start Logging"

                                onClicked: {
                                    sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(start-log (get-config 'log-append-gnss) (get-config 'log-rate))");
                                }
                            }
                            Button {
                                id: logStopButton
                                Layout.fillWidth: true
                                Layout.preferredWidth: 500
                                visible: !statusTimeout && loggerRunning
                                text: "Stop Logging"

                                onClicked: {
                                    sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(stop-log)");
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "BMS Control"
                        Layout.fillWidth: true
                        visible: owBmsEnabled && bmsType.currentIndex > 1
                        background: Loader { sourceComponent: cardBg }
                        label: Loader { sourceComponent: cardTitleLabel; onLoaded: item.title = "BMS Control" }
                        topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding

                        ColumnLayout {
                            anchors.fill: parent
                            spacing: 6

                            Switch {
                                id: bmsChargeState
                                text: "Charge BMS 90%"
                                checked: true
                                enabled: bmsConnected === 1
                                onCheckedChanged: {
                                    handleDebouncedChange()
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "BMS Info"
                        Layout.fillWidth: true
                        visible: (owBmsEnabled || ssbmsUartSelected || ssbmsBleSelected) && bmsConnected === 1
                        background: Loader { sourceComponent: cardBg }
                        label: Loader { sourceComponent: cardTitleLabel; onLoaded: item.title = "BMS Info" }
                        topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding

                        ColumnLayout {
                            anchors.fill: parent
                            spacing: 6

                            Text {
                                id: bmsError
                                Layout.fillWidth: true
                                color: Utility.getAppHexColor("lightText")
                                text: (statusTimeout || bmsStatusTemp < 0) ? "BMS Status: Unknown" : "BMS Error: " + bmsStatusTemp + "\nCharging: " + ((bmsStatusTemp & 0x20)>0) + "\nEmpty: " + ((bmsStatusTemp & 0x04)>0) + "\nTemp: " + ((bmsStatusTemp & 0x03)>0) + "\nOvercharge: " + ((bmsStatusTemp & 0x08)>0) + "\nSoC Calibration: " + ((bmsStatusTemp & 0x40)>0)
                            }
                            Text {
                                id: bmsBatteryType
                                Layout.fillWidth: true
                                color: Utility.getAppHexColor("lightText")
                                text: (statusTimeout || bmsBatteryTypeVal < 0) ? "Battery Type: Unknown" : "Battery Type: " + bmsBatteryTypeVal
                            }
                            Text {
                                id: bmsBatteryCycles
                                Layout.fillWidth: true
                                color: Utility.getAppHexColor("lightText")
                                text: (statusTimeout || bmsBatteryCyclesVal < 0) ? "Battery Cycles: Unknown" : "Battery Cycles: " + bmsBatteryCyclesVal
                            }
                        }
                    }

                    }
                }
            }

            // LED Configuration Tab
            ScrollView {
                clip: true
                ScrollBar.vertical.policy: ScrollBar.AsNeeded
                background: Rectangle { color: cardStyle.scrollViewBg }

                Item {
                    width: stackLayout.width
                    implicitHeight: scrollContent2.implicitHeight + cardStyle.scrollTopPadding + cardStyle.scrollBottomPadding

                    ColumnLayout {
                        id: scrollContent2
                        x: cardStyle.scrollHPadding
                        y: cardStyle.scrollTopPadding
                        width: stackLayout.width - 2 * cardStyle.scrollHPadding
                        spacing: 20

                        ColumnLayout {
                            id: ledEnabledLayout
                            Layout.fillWidth: true
                            visible: ledEnabled.checked && tabBar2.currentIndex === 0
                            spacing: 20

                        GroupBox {
                            title: "Lighting"
                            Layout.fillWidth: true
                            background: Loader { sourceComponent: cardBg }
                            label: Loader { sourceComponent: cardTitleLabel; onLoaded: item.title = "Lighting" }
                            topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding

                            ColumnLayout {
                                anchors.fill: parent
                                spacing: 10

                                Text {
                                    Layout.fillWidth: true
                                    wrapMode: Text.WordWrap
                                    color: fieldLabelStyle.color
                                    visible: integrationSelector.currentIndex === 1
                                    text: "Uses Refloat brightness when external LCM control is active; otherwise uses local settings. Max brightness always applies. Highbeam is switched locally."
                                }

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Update rate (Hz)"
                                        visible: ledEnabled.checked
                                    }
                                    SpinBox {
                                        id: ledLoopDelay
                                        from: 1
                                        to: 1000
                                        value: 20
                                        stepSize: 1
                                        visible: ledEnabled.checked
                                        editable: true
                                    }
                                }

                                // Max Blend Count and LED Fix were rgbled-era
                                // workarounds; the esp_led render thread makes
                                // them unnecessary. Their wire-protocol slots
                                // are kept as constants.

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Max brightness"
                                    }
                                    Loader {
                                        id: ledMaxBrightnessLoader
                                        sourceComponent: customValueSlider
                                        onLoaded: {
                                            item.from = 0.0
                                            item.to = 1.0
                                            item.value = 0.8
                                            item.stepSize = 0.01
                                            item.asPercent = true
                                        }
                                    }
                                }

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Dim RGB on Highbeam (% of main brightness)"
                                    }
                                    Loader {
                                        id: ledDimOnHighbeamRatioLoader
                                        sourceComponent: customValueSlider
                                        onLoaded: {
                                            item.from = 0.0
                                            item.to = 1.0
                                            item.value = 0.0
                                            item.stepSize = 0.1
                                            item.asPercent = true
                                        }
                                    }
                                }

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Mode"
                                    }
                                    ComboBox {
                                        id: ledMode
                                        Layout.fillWidth: true
                                        model: [
                                            {text: "White/Red", value: 0},
                                            {text: "Battery Meter", value: 1},
                                            {text: "Cyan/Magenta", value: 2},
                                            {text: "Blue/Green", value: 3},
                                            {text: "Yellow/Green", value: 4},
                                            {text: "Rainbow Chase", value: 5},
                                            {text: "Strobe", value: 6},
                                            {text: "Rave", value: 7},
                                            {text: "Mullet", value: 8},
                                            {text: "Knight Rider", value: 9},
                                            {text: "Felony", value: 10},
                                            {text: "Trans Pride", value: 11}
                                        ]
                                        textRole: "text"
                                        valueRole: "value"
                                        onCurrentIndexChanged: {
                                            value = model[currentIndex].value
                                        }
                                        property int value: 0
                                    }
                                }

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Idle Mode"
                                    }
                                    ComboBox {
                                        id: ledModeIdle
                                        Layout.fillWidth: true
                                        model: ledMode.model
                                        textRole: "text"
                                        valueRole: "value"
                                        onCurrentIndexChanged: {
                                            value = model[currentIndex].value
                                        }
                                        property int value: 5
                                    }
                                }

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Startup Mode"
                                    }
                                    ComboBox {
                                        id: ledModeStartup
                                        Layout.fillWidth: true
                                        model: ledMode.model
                                        textRole: "text"
                                        valueRole: "value"
                                        onCurrentIndexChanged: {
                                            value = model[currentIndex].value
                                        }
                                        property int value: 5
                                    }
                                }

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Status Mode"
                                    }
                                    ComboBox {
                                        id: ledModeStatus
                                        Layout.fillWidth: true
                                        model: [
                                            {text: "Green->Red Voltage, Blue Sensor, Yellow->Red Duty", value: 0},
                                            {text: "Swap ADC1/ADC2", value: 1},
                                        ]
                                        textRole: "text"
                                        valueRole: "value"
                                        onCurrentIndexChanged: {
                                            value = model[currentIndex].value
                                        }
                                        property int value: 0
                                    }
                                }

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Button Mode"
                                    }
                                    ComboBox {
                                        id: ledModeButton
                                        Layout.fillWidth: true
                                        model: [
                                            {text: "Rainbow Chase", value: 0},
                                            {text: "Battery Meter", value: 1},
                                        ]
                                        textRole: "text"
                                        valueRole: "value"
                                        onCurrentIndexChanged: {
                                            value = model[currentIndex].value
                                        }
                                        property int value: 0
                                    }
                                }

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Footpad Mode"
                                    }
                                    ComboBox {
                                        id: ledModeFootpad
                                        Layout.fillWidth: true
                                        model: [
                                            {text: "Rainbow Chase", value: 0}
                                        ]
                                        textRole: "text"
                                        valueRole: "value"
                                        onCurrentIndexChanged: {
                                            value = model[currentIndex].value
                                        }
                                        property int value: 0
                                    }
                                }

                                CheckBox {
                                    id: ledMallGrabEnabled
                                    text: "Mall Grab"
                                    checked: true
                                }

                                CheckBox {
                                    id: ledBrakeLightEnabled
                                    text: "Brake Light"
                                    checked: true
                                }

                                CheckBox {
                                    id: ledShowBatteryCharging
                                    text: "Show battery % while charging"
                                    checked: false
                                }

                                ColumnLayout {
                                    id: ledBrakeLightLayout
                                    visible: ledBrakeLightEnabled.checked
                                    spacing: cardStyle.labelSpacing

                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Brake threshold (A)"
                                    }

                                    SpinBox {
                                        id: ledBrakeLightMinAmps
                                        from: -40.0
                                        to: -1.0
                                        value: -4.0
                                        editable: true
                                    }
                                }

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Idle delay (s)"
                                    }
                                    SpinBox {
                                        id: idleTimeout
                                        from: 1
                                        to: 100
                                        value: 1
                                        editable: true
                                    }
                                }

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Idle shutoff delay (s)"
                                    }
                                    SpinBox {
                                        id: idleTimeoutShutoff
                                        from: 0
                                        to: 1000
                                        value: 600
                                        editable: true
                                    }
                                }

                            }
                        }

                        GroupBox {
                            title: "Status LEDs"
                            Layout.fillWidth: true
                            visible: ledStatusStripType.currentValue > 0
                            background: Loader { sourceComponent: cardBg }
                            label: Loader { sourceComponent: cardTitleLabel; onLoaded: item.title = "Status LEDs" }
                            topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding

                            ColumnLayout {
                                anchors.fill: parent
                                spacing: 10

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Status Strip"
                                    }
                                    ComboBox {
                                        id: ledStatusStripType
                                        Layout.fillWidth: true
                                        model: [
                                            {text: "None", value: 0},
                                            {text: "Custom", value: 1},
                                        ]
                                        textRole: "text"
                                        valueRole: "value"
                                        onCurrentIndexChanged: {
                                            value = model[currentIndex].value
                                            updateStatusLEDSettings()
                                        }
                                        property int value: 1
                                    }
                                }

                                ColumnLayout {
                                    id: ledStatusPinLayout
                                    visible: ledStatusStripType.currentValue > 0
                                    spacing: cardStyle.fieldSpacing

                                    ColumnLayout {
                                        spacing: cardStyle.labelSpacing
                                        Text {
                                            color: fieldLabelStyle.color
                                            font.pixelSize: fieldLabelStyle.pixelSize
                                            font.bold: fieldLabelStyle.bold
                                            text: "Status Pin"
                                        }
                                        SpinBox {
                                            id: ledStatusPin
                                            from: -1
                                            to: 100
                                            value: 7
                                            editable: true
                                        }
                                    }

                                    ColumnLayout {
                                        spacing: cardStyle.labelSpacing
                                        Text {
                                            color: fieldLabelStyle.color
                                            font.pixelSize: fieldLabelStyle.pixelSize
                                            font.bold: fieldLabelStyle.bold
                                            text: "LED count"
                                        }
                                        SpinBox {
                                            id: ledStatusNum
                                            from: 0
                                            to: 100
                                            value: 10
                                            editable: true
                                        }
                                    }

                                    ColumnLayout {
                                        spacing: cardStyle.labelSpacing
                                        Layout.fillWidth: true
                                        Text {
                                            color: fieldLabelStyle.color
                                            font.pixelSize: fieldLabelStyle.pixelSize
                                            font.bold: fieldLabelStyle.bold
                                            text: "Status Type"
                                        }
                                        ComboBox {
                                            id: ledStatusType
                                            Layout.fillWidth: true
                                            model: [
                                                {text: "GRB", value: 0},
                                                {text: "RGB", value: 1},
                                                {text: "GRBW", value: 2},
                                                {text: "RGBW", value: 3},
                                                {text: "WRGB", value: 4},
                                            ]
                                            textRole: "text"
                                            valueRole: "value"
                                            onCurrentIndexChanged: {
                                                value = model[currentIndex].value
                                            }
                                            property int value: 0
                                        }
                                    }

                                    ColumnLayout {
                                        visible: ledStatusStripType.currentValue > 0 && ledStatusType.currentIndex >= 2
                                        spacing: cardStyle.labelSpacing
                                        Layout.fillWidth: true
                                        Text {
                                            color: fieldLabelStyle.color
                                            font.pixelSize: fieldLabelStyle.pixelSize
                                            font.bold: fieldLabelStyle.bold
                                            text: "White Output"
                                        }
                                        ComboBox {
                                            id: ledStatusWhiteOutput
                                            Layout.fillWidth: true
                                            model: ["RGB + W", "W only", "RGB only"]
                                        }
                                    }

                                    CheckBox {
                                        id: ledStatusReversed
                                        text: "Status Reversed"
                                        checked: false
                                    }

                                    ColumnLayout {
                                        spacing: cardStyle.labelSpacing
                                        Layout.fillWidth: true
                                        Text {
                                            color: fieldLabelStyle.color
                                            font.pixelSize: fieldLabelStyle.pixelSize
                                            font.bold: fieldLabelStyle.bold
                                            text: "Status Timing"
                                        }
                                        ComboBox {
                                            id: ledStatusTiming
                                            Layout.fillWidth: true
                                            model: ["Universal", "WS2812B", "WS2815", "SK6812", "SK6815"]
                                        }
                                    }
                                }
                            }
                        }

                        GroupBox {
                            title: "Front LEDs"
                            Layout.fillWidth: true
                            visible: ledFrontStripType.currentValue > 0
                            background: Loader { sourceComponent: cardBg }
                            label: Loader { sourceComponent: cardTitleLabel; onLoaded: item.title = "Front LEDs" }
                            topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding

                            ColumnLayout {
                                anchors.fill: parent
                                spacing: 10

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Front Strip"
                                    }
                                    ComboBox {
                                        id: ledFrontStripType
                                        Layout.fillWidth: true
                                        model: [
                                            {text: "None", value: 0},
                                            {text: "Custom", value: 1},
                                            {text: "Avaspark Laserbeam", value: 2},
                                            {text: "Avaspark Laserbeam Pint", value: 3},
                                            {text: "JetFleet H4", value: 4},
                                            {text: "JetFleet H4 (no limit DCDC)", value: 5},
                                            {text: "JetFleet GT", value: 6},
                                            {text: "Stock GT", value: 7},
                                            {text: "Avaspark Laserbeam V2", value: 8},
                                            {text: "Avaspark Laserbeam V2 Pint", value: 9},
                                            {text: "Light-shutka Flashfires", value: 10},
                                            {text: "Fungineers GTFO", value: 11},
                                        ]
                                        textRole: "text"
                                        valueRole: "value"
                                        onCurrentIndexChanged: {
                                            value = model[currentIndex].value
                                            updateFrontLEDSettings()
                                        }
                                        property int value: 2
                                    }
                                }

                                ColumnLayout {
                                    id: ledFrontPinLayout
                                    visible: ledFrontStripType.currentValue > 0
                                    spacing: 10

                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Front Pin"
                                    }

                                    SpinBox {
                                        id: ledFrontPin
                                        from: -1
                                        to: 100
                                        value: 8
                                        editable: true
                                    }
                                }

                                // Says why the fields above are missing, rather than leaving a gap where
                                // the highbeam settings used to be.
                                Text {
                                        Layout.fillWidth: true
                                        wrapMode: Text.WordWrap
                                        visible: ledFrontStripType.currentIndex > 1
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize - 2
                                        text: "Highbeam is set by the " + ledFrontStripType.model[ledFrontStripType.currentIndex].text +
                                              " preset. Pick Custom to configure it by hand."
                                }

                                ColumnLayout {
                                    id: ledFrontHighbeamPinLayout
                                    visible: frontHbMode === 1
                                    spacing: 10

                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Front Highbeam Pin"
                                    }

                                    SpinBox {
                                        id: ledFrontHighbeamPin
                                        from: -1
                                        to: 100
                                        value: -1
                                        editable: true
                                    }
                                }

                                // Highbeam hardware, editable for any strip. The presets fill these in for the
                                // boards they know; a strip that is not one of them had no way to declare an
                                // overlay at all, and Embedded LEDs with no positions defines no overlay pixels -
                                // which looked like the highbeam simply never lighting.
                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    // A recognised board defines its own highbeam hardware, so these are
                                    // only editable for Custom. The PWM pin below stays visible either
                                    // way: which GPIO it is wired to is not something a preset can know.
                                    visible: ledFrontStripType.currentIndex === 1
                                    Text {
                                        Layout.fillWidth: true
                                        wrapMode: Text.WordWrap
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Front Highbeam"
                                    }
                                    ComboBox {
                                        id: ledFrontHighbeamMode
                                        Layout.fillWidth: true
                                        model: ["None", "PWM Pin", "Embedded LEDs"]
                                        onActivated: frontHbMode = currentIndex
                                    }
                                    }

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    visible: frontHbMode === 2 && ledFrontStripType.currentIndex === 1
                                    Text {
                                        Layout.fillWidth: true
                                        wrapMode: Text.WordWrap
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        text: "Highbeam LED positions (first LED = 0). Leave unused slots blank."
                                    }
                                    // Four boxes because the config stores exactly four: one position per byte of
                                    // led_*_highbeam_pos, 255 meaning unused. A slot each is closer to what is
                                    // actually stored than a comma-separated list, and there is nothing to parse.
                                    RowLayout {
                                        Layout.fillWidth: true
                                        spacing: 6
                                        TextField {
                                            id: ledFrontHbPos0
                                            Layout.fillWidth: true
                                            horizontalAlignment: TextInput.AlignHCenter
                                            placeholderText: "-"
                                            inputMethodHints: Qt.ImhDigitsOnly
                                            validator: IntValidator { bottom: 0; top: 254 }
                                            onEditingFinished: commitFrontHbSlots()
                                        }
                                        TextField {
                                            id: ledFrontHbPos1
                                            Layout.fillWidth: true
                                            horizontalAlignment: TextInput.AlignHCenter
                                            placeholderText: "-"
                                            inputMethodHints: Qt.ImhDigitsOnly
                                            validator: IntValidator { bottom: 0; top: 254 }
                                            onEditingFinished: commitFrontHbSlots()
                                        }
                                        TextField {
                                            id: ledFrontHbPos2
                                            Layout.fillWidth: true
                                            horizontalAlignment: TextInput.AlignHCenter
                                            placeholderText: "-"
                                            inputMethodHints: Qt.ImhDigitsOnly
                                            validator: IntValidator { bottom: 0; top: 254 }
                                            onEditingFinished: commitFrontHbSlots()
                                        }
                                        TextField {
                                            id: ledFrontHbPos3
                                            Layout.fillWidth: true
                                            horizontalAlignment: TextInput.AlignHCenter
                                            placeholderText: "-"
                                            inputMethodHints: Qt.ImhDigitsOnly
                                            validator: IntValidator { bottom: 0; top: 254 }
                                            onEditingFinished: commitFrontHbSlots()
                                        }
                                    }
                                    Text {
                                        Layout.fillWidth: true
                                        wrapMode: Text.WordWrap
                                        color: hbFootprintBad(ledFrontNum.value, frontHbPos) ? "#e08f8f" : fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize - 2
                                        // LED count excludes the highbeam pixels, which is the easiest thing to get
                                        // wrong here, so the total is spelled out.
                                        text: hbFootprintText(ledFrontNum.value, frontHbPos)
                                    }
                                    }

                                RowLayout {
                                    Layout.fillWidth: true
                                    spacing: 10
                                    visible: frontHbMode === 2 && ledFrontStripType.currentIndex === 1
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        text: "Drive % min / max"
                                    }
                                    Item { Layout.fillWidth: true }
                                    SpinBox {
                                        id: ledFrontHighbeamMin
                                        from: 0
                                        to: 100
                                        onValueModified: frontHbMin = value / 100
                                    }
                                    SpinBox {
                                        id: ledFrontHighbeamMax
                                        from: 0
                                        to: 100
                                        onValueModified: frontHbMax = value / 100
                                    }
                                    }


                                ColumnLayout {
                                    id: ledFrontCustomSettings
                                    visible: ledFrontStripType.currentValue === 1
                                    spacing: 10

                                    ColumnLayout {
                                        spacing: cardStyle.labelSpacing
                                        Text {
                                            color: fieldLabelStyle.color
                                            font.pixelSize: fieldLabelStyle.pixelSize
                                            font.bold: fieldLabelStyle.bold
                                            text: "LED count"
                                        }
                                        SpinBox {
                                            id: ledFrontNum
                                            from: 0
                                            to: 100
                                            value: 18
                                            editable: true
                                        }
                                    }

                                    ColumnLayout {
                                        spacing: cardStyle.labelSpacing
                                        Layout.fillWidth: true
                                        Text {
                                            color: fieldLabelStyle.color
                                            font.pixelSize: fieldLabelStyle.pixelSize
                                            font.bold: fieldLabelStyle.bold
                                            text: "Front Type"
                                        }
                                        ComboBox {
                                            id: ledFrontType
                                            Layout.fillWidth: true
                                            model: [
                                                {text: "GRB", value: 0},
                                                {text: "RGB", value: 1},
                                                {text: "GRBW", value: 2},
                                                {text: "RGBW", value: 3},
                                                {text: "WRGB", value: 4},
                                            ]
                                            textRole: "text"
                                            valueRole: "value"
                                            onCurrentIndexChanged: {
                                                value = model[currentIndex].value
                                            }
                                            property int value: 0
                                        }
                                    }
                                }

                                ColumnLayout {
                                    visible: ledFrontStripType.currentValue > 0 && ledFrontType.currentIndex >= 2
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "White Output"
                                    }
                                    ComboBox {
                                        id: ledFrontWhiteOutput
                                        Layout.fillWidth: true
                                        model: ["RGB + W", "W only", "RGB only"]
                                    }
                                }

                                ColumnLayout {
                                    id: ledFrontReversedLayout
                                    visible: ledFrontStripType.currentValue > 0
                                    spacing: 10

                                    CheckBox {
                                        id: ledFrontReversed
                                        text: "Front Reversed"
                                        checked: false
                                    }
                                }

                                ColumnLayout {
                                    visible: ledFrontStripType.currentValue > 0
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true

                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Front Timing"
                                    }
                                    ComboBox {
                                        id: ledFrontTiming
                                        Layout.fillWidth: true
                                        model: ["Universal", "WS2812B", "WS2815", "SK6812", "SK6815"]
                                    }
                                }
                            }
                        }

                        GroupBox {
                            title: "Rear LEDs"
                            Layout.fillWidth: true
                            visible: ledRearStripType.currentValue > 0
                            background: Loader { sourceComponent: cardBg }
                            label: Loader { sourceComponent: cardTitleLabel; onLoaded: item.title = "Rear LEDs" }
                            topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding

                            ColumnLayout {
                                anchors.fill: parent
                                spacing: 10

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Rear Strip"
                                    }
                                    ComboBox {
                                        id: ledRearStripType
                                        Layout.fillWidth: true
                                        model: [
                                            {text: "None", value: 0},
                                            {text: "Custom", value: 1},
                                            {text: "Avaspark Laserbeam", value: 2},
                                            {text: "Avaspark Laserbeam Pint", value: 3},
                                            {text: "JetFleet H4", value: 4},
                                            {text: "JetFleet H4 (no limit DCDC)", value: 5},
                                            {text: "JetFleet GT", value: 6},
                                            {text: "Stock GT", value: 7},
                                            {text: "Avaspark Laserbeam V2", value: 8},
                                            {text: "Avaspark Laserbeam V2 Pint", value: 9},
                                            {text: "Light-shutka Flashfires", value: 10},
                                            {text: "Fungineers GTFO", value: 11},
                                        ]
                                        textRole: "text"
                                        valueRole: "value"
                                        onCurrentIndexChanged: {
                                            value = model[currentIndex].value
                                            updateRearLEDSettings()
                                        }
                                        property int value: 2
                                    }
                                }

                                ColumnLayout {
                                    id: ledRearPinLayout
                                    visible: ledRearStripType.currentValue > 0
                                    spacing: cardStyle.labelSpacing

                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Rear Pin"
                                    }

                                    SpinBox {
                                        id: ledRearPin
                                        from: -1
                                        to: 100
                                        value: 9
                                        editable: true
                                    }
                                }

                                // Says why the fields above are missing, rather than leaving a gap where
                                // the highbeam settings used to be.
                                Text {
                                        Layout.fillWidth: true
                                        wrapMode: Text.WordWrap
                                        visible: ledRearStripType.currentIndex > 1
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize - 2
                                        text: "Highbeam is set by the " + ledRearStripType.model[ledRearStripType.currentIndex].text +
                                              " preset. Pick Custom to configure it by hand."
                                }

                                ColumnLayout {
                                    id: ledRearHighbeamPinLayout
                                    visible: rearHbMode === 1
                                    spacing: cardStyle.labelSpacing

                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Rear Highbeam Pin"
                                    }

                                    SpinBox {
                                        id: ledRearHighbeamPin
                                        from: -1
                                        to: 100
                                        value: -1
                                        editable: true
                                    }
                                }

                                // Highbeam hardware, editable for any strip. The presets fill these in for the
                                // boards they know; a strip that is not one of them had no way to declare an
                                // overlay at all, and Embedded LEDs with no positions defines no overlay pixels -
                                // which looked like the highbeam simply never lighting.
                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    // A recognised board defines its own highbeam hardware, so these are
                                    // only editable for Custom. The PWM pin below stays visible either
                                    // way: which GPIO it is wired to is not something a preset can know.
                                    visible: ledRearStripType.currentIndex === 1
                                    Text {
                                        Layout.fillWidth: true
                                        wrapMode: Text.WordWrap
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Rear Highbeam"
                                    }
                                    ComboBox {
                                        id: ledRearHighbeamMode
                                        Layout.fillWidth: true
                                        model: ["None", "PWM Pin", "Embedded LEDs"]
                                        onActivated: rearHbMode = currentIndex
                                    }
                                    }

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    visible: rearHbMode === 2 && ledRearStripType.currentIndex === 1
                                    Text {
                                        Layout.fillWidth: true
                                        wrapMode: Text.WordWrap
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        text: "Highbeam LED positions (first LED = 0). Leave unused slots blank."
                                    }
                                    // Four boxes because the config stores exactly four: one position per byte of
                                    // led_*_highbeam_pos, 255 meaning unused. A slot each is closer to what is
                                    // actually stored than a comma-separated list, and there is nothing to parse.
                                    RowLayout {
                                        Layout.fillWidth: true
                                        spacing: 6
                                        TextField {
                                            id: ledRearHbPos0
                                            Layout.fillWidth: true
                                            horizontalAlignment: TextInput.AlignHCenter
                                            placeholderText: "-"
                                            inputMethodHints: Qt.ImhDigitsOnly
                                            validator: IntValidator { bottom: 0; top: 254 }
                                            onEditingFinished: commitRearHbSlots()
                                        }
                                        TextField {
                                            id: ledRearHbPos1
                                            Layout.fillWidth: true
                                            horizontalAlignment: TextInput.AlignHCenter
                                            placeholderText: "-"
                                            inputMethodHints: Qt.ImhDigitsOnly
                                            validator: IntValidator { bottom: 0; top: 254 }
                                            onEditingFinished: commitRearHbSlots()
                                        }
                                        TextField {
                                            id: ledRearHbPos2
                                            Layout.fillWidth: true
                                            horizontalAlignment: TextInput.AlignHCenter
                                            placeholderText: "-"
                                            inputMethodHints: Qt.ImhDigitsOnly
                                            validator: IntValidator { bottom: 0; top: 254 }
                                            onEditingFinished: commitRearHbSlots()
                                        }
                                        TextField {
                                            id: ledRearHbPos3
                                            Layout.fillWidth: true
                                            horizontalAlignment: TextInput.AlignHCenter
                                            placeholderText: "-"
                                            inputMethodHints: Qt.ImhDigitsOnly
                                            validator: IntValidator { bottom: 0; top: 254 }
                                            onEditingFinished: commitRearHbSlots()
                                        }
                                    }
                                    Text {
                                        Layout.fillWidth: true
                                        wrapMode: Text.WordWrap
                                        color: hbFootprintBad(ledRearNum.value, rearHbPos) ? "#e08f8f" : fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize - 2
                                        // LED count excludes the highbeam pixels, which is the easiest thing to get
                                        // wrong here, so the total is spelled out.
                                        text: hbFootprintText(ledRearNum.value, rearHbPos)
                                    }
                                    }

                                RowLayout {
                                    Layout.fillWidth: true
                                    spacing: 10
                                    visible: rearHbMode === 2 && ledRearStripType.currentIndex === 1
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        text: "Drive % min / max"
                                    }
                                    Item { Layout.fillWidth: true }
                                    SpinBox {
                                        id: ledRearHighbeamMin
                                        from: 0
                                        to: 100
                                        onValueModified: rearHbMin = value / 100
                                    }
                                    SpinBox {
                                        id: ledRearHighbeamMax
                                        from: 0
                                        to: 100
                                        onValueModified: rearHbMax = value / 100
                                    }
                                    }


                                ColumnLayout {
                                    id: ledRearCustomSettings
                                    visible: ledRearStripType.currentValue === 1
                                    spacing: cardStyle.fieldSpacing

                                    ColumnLayout {
                                        spacing: cardStyle.labelSpacing
                                        Text {
                                            color: fieldLabelStyle.color
                                            font.pixelSize: fieldLabelStyle.pixelSize
                                            font.bold: fieldLabelStyle.bold
                                            text: "LED count"
                                        }
                                        SpinBox {
                                            id: ledRearNum
                                            from: 0
                                            to: 100
                                            value: 18
                                            editable: true
                                        }
                                    }

                                    ColumnLayout {
                                        spacing: cardStyle.labelSpacing
                                        Layout.fillWidth: true
                                        Text {
                                            color: fieldLabelStyle.color
                                            font.pixelSize: fieldLabelStyle.pixelSize
                                            font.bold: fieldLabelStyle.bold
                                            text: "Rear Type"
                                        }
                                        ComboBox {
                                            id: ledRearType
                                            Layout.fillWidth: true
                                            model: [
                                                {text: "GRB", value: 0},
                                                {text: "RGB", value: 1},
                                                {text: "GRBW", value: 2},
                                                {text: "RGBW", value: 3},
                                                {text: "WRGB", value: 4},
                                            ]
                                            textRole: "text"
                                            valueRole: "value"
                                            onCurrentIndexChanged: {
                                                value = model[currentIndex].value
                                            }
                                            property int value: 0
                                        }
                                    }
                                }

                                ColumnLayout {
                                    visible: ledRearStripType.currentValue > 0 && ledRearType.currentIndex >= 2
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "White Output"
                                    }
                                    ComboBox {
                                        id: ledRearWhiteOutput
                                        Layout.fillWidth: true
                                        model: ["RGB + W", "W only", "RGB only"]
                                    }
                                }

                                ColumnLayout {
                                    id: ledRearReversedLayout
                                    visible: ledRearStripType.currentValue > 0
                                    spacing: 10

                                    CheckBox {
                                        id: ledRearReversed
                                        text: "Rear Reversed"
                                        checked: false
                                    }
                                }

                                ColumnLayout {
                                    visible: ledRearStripType.currentValue > 0
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true

                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Rear Timing"
                                    }
                                    ComboBox {
                                        id: ledRearTiming
                                        Layout.fillWidth: true
                                        model: ["Universal", "WS2812B", "WS2815", "SK6812", "SK6815"]
                                    }
                                }
                            }
                        }

                        GroupBox {
                            title: "Button LED"
                            Layout.fillWidth: true
                            visible: ledButtonStripType.currentValue > 0
                            background: Loader { sourceComponent: cardBg }
                            label: Loader { sourceComponent: cardTitleLabel; onLoaded: item.title = "Button LED" }
                            topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding

                            ColumnLayout {
                                anchors.fill: parent
                                spacing: 10

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Button"
                                    }
                                    ComboBox {
                                        id: ledButtonStripType
                                        Layout.fillWidth: true
                                        model: [
                                            {text: "None", value: 0},
                                            {text: "NeoPixel RGB", value: 1},
                                        ]
                                        textRole: "text"
                                        valueRole: "value"
                                        onCurrentIndexChanged: {
                                            value = model[currentIndex].value
                                        }
                                        property int value: 0
                                    }
                                }

                                ColumnLayout {
                                    id: ledButtonPinLayout
                                    visible: ledButtonStripType.currentValue > 0
                                    spacing: cardStyle.labelSpacing

                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Button Pin"
                                    }

                                    SpinBox {
                                        id: ledButtonPin
                                        from: -1
                                        to: 100
                                        value: -1
                                        editable: true
                                    }
                                }

                                ColumnLayout {
                                    id: ledButtonCustomSettings
                                    visible: ledButtonStripType.currentValue === 1
                                    spacing: 10
                                }
                            }
                        }

                        GroupBox {
                            title: "Footpad LEDs"
                            Layout.fillWidth: true
                            visible: ledFootpadStripType.currentValue > 0
                            background: Loader { sourceComponent: cardBg }
                            label: Loader { sourceComponent: cardTitleLabel; onLoaded: item.title = "Footpad LEDs" }
                            topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding

                            ColumnLayout {
                                anchors.fill: parent
                                spacing: 10

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Footpad Strip"
                                    }
                                    ComboBox {
                                        id: ledFootpadStripType
                                        Layout.fillWidth: true
                                        model: [
                                            {text: "None", value: 0},
                                            {text: "Custom", value: 1}
                                        ]
                                        textRole: "text"
                                        valueRole: "value"
                                        onCurrentIndexChanged: {
                                            value = model[currentIndex].value
                                            updateFootpadLEDSettings()
                                        }
                                        property int value: 0
                                    }
                                }

                                ColumnLayout {
                                    id: ledFootpadPinLayout
                                    visible: ledFootpadStripType.currentValue > 0
                                    spacing: cardStyle.labelSpacing

                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Footpad Pin"
                                    }

                                    SpinBox {
                                        id: ledFootpadPin
                                        from: -1
                                        to: 100
                                        value: -1
                                        editable: true
                                    }
                                }

                                ColumnLayout {
                                    id: ledFootpadCustomSettings
                                    visible: ledFootpadStripType.currentValue === 1
                                    spacing: cardStyle.fieldSpacing

                                    ColumnLayout {
                                        spacing: cardStyle.labelSpacing
                                        Text {
                                            color: fieldLabelStyle.color
                                            font.pixelSize: fieldLabelStyle.pixelSize
                                            font.bold: fieldLabelStyle.bold
                                            text: "LED count"
                                        }
                                        SpinBox {
                                            id: ledFootpadNum
                                            from: 0
                                            to: 100
                                            value: 13
                                            editable: true
                                        }
                                    }

                                    ColumnLayout {
                                        spacing: cardStyle.labelSpacing
                                        Layout.fillWidth: true
                                        Text {
                                            color: fieldLabelStyle.color
                                            font.pixelSize: fieldLabelStyle.pixelSize
                                            font.bold: fieldLabelStyle.bold
                                            text: "Footpad Type"
                                        }
                                        ComboBox {
                                            id: ledFootpadType
                                            Layout.fillWidth: true
                                            model: [
                                                {text: "GRB", value: 0},
                                                {text: "RGB", value: 1},
                                                {text: "GRBW", value: 2},
                                                {text: "RGBW", value: 3},
                                                {text: "WRGB", value: 4},
                                            ]
                                            textRole: "text"
                                            valueRole: "value"
                                            onCurrentIndexChanged: {
                                                value = model[currentIndex].value
                                            }
                                            property int value: 0
                                        }
                                    }
                                }

                                ColumnLayout {
                                    visible: ledFootpadStripType.currentValue > 0 && ledFootpadType.currentIndex >= 2
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "White Output"
                                    }
                                    ComboBox {
                                        id: ledFootpadWhiteOutput
                                        Layout.fillWidth: true
                                        model: ["RGB + W", "W only", "RGB only"]
                                    }
                                }

                                ColumnLayout {
                                    id: ledFootpadReversedLayout
                                    visible: ledFootpadStripType.currentValue > 0
                                    spacing: 10

                                    CheckBox {
                                        id: ledFootpadReversed
                                        text: "Footpad Reversed"
                                        checked: false
                                    }
                                }

                                ColumnLayout {
                                    visible: ledFootpadStripType.currentValue > 0
                                    spacing: cardStyle.labelSpacing
                                    Layout.fillWidth: true

                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Footpad Timing"
                                    }
                                    ComboBox {
                                        id: ledFootpadTiming
                                        Layout.fillWidth: true
                                        model: ["Universal", "WS2812B", "WS2815", "SK6812", "SK6815"]
                                    }
                                }
                            }
                        }

                        // Adds a not-yet-used role to the list above; each
                        // role's own Strip Type = "None" removes it again.
                        Button {
                            text: "+ Add Strip"
                            Layout.fillWidth: true
                            enabled: container.addedRoles.length < 5
                            onClicked: addStripMenu.popup()

                            Menu {
                                id: addStripMenu

                                MenuItem {
                                    text: "Status bar"
                                    visible: ledStatusStripType.currentValue === 0
                                    height: visible ? implicitHeight : 0
                                    onTriggered: container.setRole("Status", true)
                                }
                                MenuItem {
                                    text: "Front"
                                    visible: ledFrontStripType.currentValue === 0
                                    height: visible ? implicitHeight : 0
                                    onTriggered: container.setRole("Front", true)
                                }
                                MenuItem {
                                    text: "Rear"
                                    visible: ledRearStripType.currentValue === 0
                                    height: visible ? implicitHeight : 0
                                    onTriggered: container.setRole("Rear", true)
                                }
                                MenuItem {
                                    text: "Footpad"
                                    visible: ledFootpadStripType.currentValue === 0
                                    height: visible ? implicitHeight : 0
                                    onTriggered: container.setRole("Footpad", true)
                                }
                                MenuItem {
                                    text: "Button LED"
                                    visible: ledButtonStripType.currentValue === 0
                                    height: visible ? implicitHeight : 0
                                    onTriggered: container.setRole("Button", true)
                                }
                            }
                        }
                    }

                    ColumnLayout {
                        Layout.fillWidth: true
                        spacing: 20
                        visible: pubmoteEnabled.checked && tabBar2.currentIndex === 1
                        GroupBox {
                            title: "Pubmote"
                            Layout.fillWidth: true
                            background: Loader { sourceComponent: cardBg }
                            label: Loader { sourceComponent: cardTitleLabel; onLoaded: item.title = "Pubmote" }
                            topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding

                            ColumnLayout {
                                anchors.fill: parent
                                spacing: 10

                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    visible: pubmoteEnabled.checked
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "Frequency (Hz)"
                                    }
                                    SpinBox {
                                        id: pubmoteLoopDelay
                                        from: 1
                                        to: 1000
                                        value: 8
                                        stepSize: 1
                                        editable: true
                                    }
                                }

                                Text {
                                    id: pubmoteMacAddress
                                    color: Utility.getAppHexColor("lightText")
                                    text: "MAC: Unknown"
                                }

                                Text {
                                    id: pubmoteVersion
                                    color: Utility.getAppHexColor("lightText")
                                    text: statusTimeout ? "Version: Unknown" : "Version: " + pubmoteVersionStr
                                }

                                Button {
                                    text: isPubmotePaired ? "Unpair Pubmote" : "Pair Pubmote"
                                    Layout.fillWidth: true
                                    Layout.preferredWidth: 500
                                    onClicked: {
                                        if (isPubmotePaired) {
                                            sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(pubmote-pair -2)");
                                        } else {
                                            pubmotePairPopup.open();  // Open the confirmation popup with the random code
                                        }
                                    }
                                }

                            }
                        }

                        GroupBox {
                            id: inputPreviewSection
                            title: "Input Preview"
                            Layout.fillWidth: true
                            background: Loader { sourceComponent: cardBg }
                            label: Item {
                                implicitHeight: 40
                                width: parent ? parent.width : 200

                                Text {
                                    text: "Input Preview"
                                    color: "white"
                                    font.bold: true
                                    font.pixelSize: 15
                                    anchors.left: parent.left
                                    anchors.leftMargin: 12
                                    anchors.verticalCenter: parent.verticalCenter
                                }
                                Loader {
                                    id: inputPreviewEnabled
                                    sourceComponent: customSwitch
                                    anchors.right: parent.right
                                    anchors.rightMargin: cardStyle.sidePadding
                                    anchors.verticalCenter: parent.verticalCenter
                                    property bool checked: item ? item.checked : false

                                    onLoaded: {
                                        item.checked = false
                                        item.checkedChanged.connect(function() {
                                            inputPreviewEnabled.checked = item.checked
                                        })
                                    }

                                    onCheckedChanged: {
                                        if (item) item.checked = checked
                                    }
                                }
                            }
                            topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding

                            ColumnLayout {
                                anchors.fill: parent
                                spacing: 10

                                Text {
                                    visible: inputPreviewEnabled.checked
                                    text: pubmoteInputConnected ? "Pubmote connected" : "Pubmote not connected"
                                    color: pubmoteInputConnected ? "cyan" : Utility.getAppHexColor("lightText")
                                    Layout.alignment: Qt.AlignHCenter
                                }

                                ColumnLayout {
                                    visible: inputPreviewEnabled.checked
                                    spacing: 10
                                    Layout.alignment: Qt.AlignHCenter

                                    Rectangle {
                                        id: joystickPad
                                        Layout.alignment: Qt.AlignHCenter
                                        Layout.preferredWidth: 160
                                        Layout.preferredHeight: 160
                                        color: "transparent"
                                        border.color: Qt.rgba(1, 1, 1, 0.3)
                                        border.width: 1
                                        radius: 8

                                        Rectangle {
                                            width: 1
                                            height: parent.height - 2
                                            anchors.centerIn: parent
                                            color: Qt.rgba(1, 1, 1, 0.15)
                                        }
                                        Rectangle {
                                            width: parent.width - 2
                                            height: 1
                                            anchors.centerIn: parent
                                            color: Qt.rgba(1, 1, 1, 0.15)
                                        }

                                        Rectangle {
                                            width: 14
                                            height: 14
                                            radius: 7
                                            color: pubmoteInputConnected ? "cyan" : "gray"
                                            x: (parent.width - width) / 2 + Math.max(-1, Math.min(1, pubmoteInputJsx)) * (parent.width - width) / 2
                                            y: (parent.height - height) / 2 - Math.max(-1, Math.min(1, pubmoteInputJsy)) * (parent.height - height) / 2
                                        }
                                    }

                                    Text {
                                        text: "Y: " + pubmoteInputJsy.toFixed(3) + "    X: " + pubmoteInputJsx.toFixed(3)
                                        color: Utility.getAppHexColor("lightText")
                                        Layout.alignment: Qt.AlignHCenter
                                    }

                                    RowLayout {
                                        spacing: 10
                                        Layout.alignment: Qt.AlignHCenter

                                        Rectangle {
                                            Layout.preferredWidth: 70
                                            Layout.preferredHeight: 32
                                            radius: 6
                                            color: pubmoteInputBtC ? "cyan" : Qt.rgba(1, 1, 1, 0.1)
                                            Text {
                                                anchors.centerIn: parent
                                                text: "C"
                                                color: pubmoteInputBtC ? "black" : "white"
                                            }
                                        }
                                        Rectangle {
                                            Layout.preferredWidth: 70
                                            Layout.preferredHeight: 32
                                            radius: 6
                                            color: pubmoteInputBtZ ? "cyan" : Qt.rgba(1, 1, 1, 0.1)
                                            Text {
                                                anchors.centerIn: parent
                                                text: "Z"
                                                color: pubmoteInputBtZ ? "black" : "white"
                                            }
                                        }
                                        Rectangle {
                                            Layout.preferredWidth: 70
                                            Layout.preferredHeight: 32
                                            radius: 6
                                            color: pubmoteInputRev ? "cyan" : Qt.rgba(1, 1, 1, 0.1)
                                            Text {
                                                anchors.centerIn: parent
                                                text: "REV"
                                                color: pubmoteInputRev ? "black" : "white"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    ColumnLayout {
                        Layout.fillWidth: true
                        spacing: 20
                        visible: bmsEnabled.checked && tabBar2.currentIndex === 2
                        GroupBox {
                            title: "BMS Connection"
                            Layout.fillWidth: true
                            background: Loader { sourceComponent: cardBg }
                            label: Loader { sourceComponent: cardTitleLabel; onLoaded: item.title = "BMS Connection" }
                            topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding
                            ColumnLayout {
                                anchors.fill: parent
                                spacing: 10
                                ComboBox {
                                    id: bmsBackend
                                    Layout.fillWidth: true
                                    Layout.minimumWidth: 0
                                    model: ["None", "OW", "SSBMS UART", "SSBMS BLE"]
                                }
                                Text {
                                    Layout.fillWidth: true
                                    wrapMode: Text.WordWrap
                                    color: fieldLabelStyle.color
                                    visible: bmsBackend.currentIndex === 0
                                    text: "Choose how to connect your BMS. None disables the connection."
                                }
                            }
                        }
                        GroupBox {
                            title: "SSBMS UART"
                            Layout.fillWidth: true
                            visible: ssbmsUartSelected
                            background: Loader { sourceComponent: cardBg }
                            label: Loader { sourceComponent: cardTitleLabel; onLoaded: item.title = "SSBMS UART" }
                            topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding
                            ColumnLayout {
                                anchors.fill: parent
                                Text {
                                    Layout.fillWidth: true
                                    wrapMode: Text.WordWrap
                                    color: fieldLabelStyle.color
                                    text: "UART 1: 115200 baud, 8N1. Assign both RX and TX pins (-1 = unassigned). Read-only telemetry; SoC uses the lowest cell and your Cell Type setting."
                                }
                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "RX pin (BMS TX)"
                                    }
                                    SpinBox {
                                        id: ssbmsUartRxPin
                                        from: -1
                                        to: 100
                                        value: -1
                                        editable: true
                                    }

                                }
                                ColumnLayout {
                                    spacing: cardStyle.labelSpacing
                                    Text {
                                        color: fieldLabelStyle.color
                                        font.pixelSize: fieldLabelStyle.pixelSize
                                        font.bold: fieldLabelStyle.bold
                                        text: "TX pin (BMS RX)"
                                    }
                                    SpinBox {
                                        id: ssbmsUartTxPin
                                        from: -1
                                        to: 100
                                        value: -1
                                        editable: true
                                    }

                                }
                            }
                        }
                        GroupBox {
                            title: "SSBMS BLE"
                            Layout.fillWidth: true
                            visible: ssbmsBleSelected
                            background: Loader { sourceComponent: cardBg }
                            label: Loader { sourceComponent: cardTitleLabel; onLoaded: item.title = "SSBMS BLE" }
                            topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding
                            ColumnLayout {
                                anchors.fill: parent
                                Text {
                                    Layout.fillWidth: true
                                    wrapMode: Text.WordWrap
                                    color: fieldLabelStyle.color
                                    text: "Scan, then Connect to save your BMS. Close any BMS phone app first."
                                }
                                // One line for paired x connected, so a paired BMS that is
                                // out of range or off still shows, next to Forget.
                                Text {
                                    Layout.fillWidth: true
                                    wrapMode: Text.WordWrap
                                    visible: ssbmsBlePinned || ssbmsBleLinkConnected
                                    readonly property string linkText: ssbmsBleLinkConnected
                                        ? formatBleAddress(ssbmsBleLinkA, ssbmsBleLinkB) + " (" + ssbmsBleRssi + " dBm)" : ""
                                    readonly property bool pinnedLinked: ssbmsBlePinned && ssbmsBlePeerLinked(ssbmsBleAddressA, ssbmsBleAddressB)
                                    color: pinnedLinked ? statusSummary.okColor : statusSummary.warnColor
                                    text: ssbmsBlePinned
                                        ? (pinnedLinked
                                            ? "Connected: " + linkText
                                            : "Saved BMS " + formatBleAddress(ssbmsBleAddressA, ssbmsBleAddressB)
                                              + " not connected" + (ssbmsBleLinkConnected ? " (linked to " + linkText + ")" : "")
                                              + ". Wake it, or Forget.")
                                        : "Disconnecting forgotten BMS: " + linkText
                                }
                                Text {
                                    Layout.fillWidth: true
                                    wrapMode: Text.WordWrap
                                    visible: ssbmsBleProgressMessage !== "" && !ssbmsBleScanning
                                        && (ssbmsBlePinned || ssbmsBleLinkConnected || ssbmsBleConnectPhase > 0)
                                    color: ssbmsBleConnectPhase === 6 ? statusSummary.okColor : statusSummary.warnColor
                                    text: ssbmsBleProgressMessage
                                }
                                RowLayout {
                                    Button {
                                        id: ssbmsBleScanButton
                                        text: "Scan"
                                        visible: !ssbmsBlePinned
                                        enabled: !ssbmsBleScanning
                                        Accessible.name: ssbmsBleScanning ? "Scanning for BMS" : text
                                        contentItem.opacity: ssbmsBleScanning ? 0 : 1
                                        BusyIndicator {
                                            anchors.centerIn: parent
                                            width: 20
                                            height: 20
                                            padding: 0
                                            running: ssbmsBleScanning
                                            visible: running
                                        }
                                        onClicked: {
                                            ssbmsBleFound.clear()
                                            ssbmsBleScanMessage = ""
                                            ssbmsBleScanning = true
                                            ssbmsBleScanTimer.restart()
                                            sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(ssbms-ble-request-scan)")
                                        }
                                    }
                                    Button {
                                        text: "Forget"
                                        visible: ssbmsBlePinned
                                        onClicked: sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(ssbms-ble-select 0 0)")
                                    }
                                }
                                Text {
                                    Layout.fillWidth: true
                                    wrapMode: Text.WordWrap
                                    color: statusSummary.warnColor
                                    visible: ssbmsBleScanMessage !== ""
                                    text: ssbmsBleScanMessage
                                }
                                Repeater {
                                    model: ssbmsBleFound
                                    delegate: RowLayout {
                                        Layout.fillWidth: true
                                        Text {
                                            Layout.fillWidth: true
                                            wrapMode: Text.WordWrap
                                            color: fieldLabelStyle.color
                                            text: model.name + "  " + formatBleAddress(model.a, model.b) + "  " + model.rssi + " dBm"
                                        }
                                        Button {
                                            readonly property bool current: ssbmsBlePeerSaved(model.a, model.b)
                                            readonly property bool linked: ssbmsBlePeerLinked(model.a, model.b)
                                            text: ssbmsBleConnectText(model.a, model.b)
                                            enabled: !linked && !ssbmsBleScanning && (!current || !ssbmsBleConnecting)
                                            onClicked: sendCode(String.fromCharCode(102) + String.fromCharCode(1)
                                                + "(ssbms-ble-select " + model.a + " " + model.b + ")")
                                        }
                                    }
                                }
                                Text {
                                    Layout.fillWidth: true
                                    wrapMode: Text.WordWrap
                                    visible: expressBleClientMissing
                                    color: statusSummary.errColor
                                    text: "Bluetooth role: " + (expressBleClientMissing ? expressBleRoleNames[expressBleRole] : "")
                                        + ". Select Client or Client & Server, then reboot."
                                }
                                Button {
                                    visible: expressBleClientMissing
                                    text: expressBleRole === 1 ? "Set Role to Client & Server" : "Set Role to Client"
                                    onClicked: {
                                        sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(express-ble-enable-client)")
                                        expressBleRebootPending = true
                                    }
                                }
                                Text {
                                    Layout.fillWidth: true
                                    wrapMode: Text.WordWrap
                                    visible: expressBleRole === -1
                                    color: statusSummary.errColor
                                    text: "Update Express firmware to enable SSBMS BLE."
                                }
                                Text {
                                    Layout.fillWidth: true
                                    wrapMode: Text.WordWrap
                                    visible: expressBleRebootPending
                                    color: statusSummary.warnColor
                                    text: "Role saved. Reboot Express to apply."
                                }
                                Button {
                                    visible: expressBleRebootPending
                                    text: "Reboot VESC Express"
                                    onClicked: {
                                        expressBleRebootPending = false
                                        sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(reboot)")
                                    }
                                }
                            }
                        }
                        GroupBox {
                            id: ssbmsTelemetryCard
                            title: "SSBMS Telemetry"
                            visible: ssbmsTelemetryConnected
                            Layout.fillWidth: true
                            background: Loader { sourceComponent: cardBg }
                            label: Loader { sourceComponent: cardTitleLabel; onLoaded: item.title = "SSBMS Telemetry" }
                            topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding
                            ColumnLayout {
                                anchors.fill: parent
                                Text {
                                    Layout.fillWidth: true
                                    wrapMode: Text.WordWrap
                                    color: ssbmsTelemetryAvailable && ssbmsTelemetryAge < 3 ? statusSummary.okColor : statusSummary.warnColor
                                    text: ssbmsTelemetryAvailable
                                        ? "Last telemetry: " + ssbmsTelemetryAge.toFixed(1) + " s ago" + (ssbmsTelemetryAge >= 3 ? " (stale)" : "")
                                        : "Connected; waiting for telemetry."
                                }
                                ColumnLayout {
                                    visible: ssbmsTelemetryAvailable
                                    Layout.fillWidth: true
                                    Text {
                                        Layout.fillWidth: true
                                        wrapMode: Text.WordWrap
                                        color: fieldLabelStyle.color
                                        text: ssbmsTelemetryAvailable ? "Pack: " + ssbmsTelemetry.voltage.toFixed(2) + " V    SoC: " + ssbmsTelemetry.soc.toFixed(1) + "% (estimated)" : ""
                                    }
                                    Text {
                                        Layout.fillWidth: true
                                        wrapMode: Text.WordWrap
                                        color: fieldLabelStyle.color
                                        text: ssbmsTelemetryAvailable ? "Cells: " + ssbmsTelemetry.cells.length + "    Min: " + ssbmsTelemetry.low.toFixed(3) + " V    Max: " + ssbmsTelemetry.high.toFixed(3) + " V    Spread: " + ssbmsTelemetry.spread.toFixed(0) + " mV" : ""
                                    }
                                    Text {
                                        Layout.fillWidth: true
                                        wrapMode: Text.WordWrap
                                        color: fieldLabelStyle.color
                                        text: ssbmsTelemetryAvailable ? "Charging current: " + Math.max(0, -ssbmsTelemetry.current).toFixed(2) + " A    Charging: " + ((ssbmsTelemetry.status & 32) ? "Yes" : "No") + "    Charge allowed: " + (ssbmsTelemetry.chargeAllowed ? "Yes" : "No") : ""
                                    }
                                    Text {
                                        Layout.fillWidth: true
                                        wrapMode: Text.WordWrap
                                        color: fieldLabelStyle.color
                                        text: ssbmsTelemetryAvailable ? "Battery: " + ssbmsTelemetry.temp1.toFixed(1) + " / " + ssbmsTelemetry.temp2.toFixed(1) + " °C    MOSFET: " + ssbmsTelemetry.mosfet.toFixed(1) + " °C" : ""
                                    }
                                    Flow {
                                        Layout.fillWidth: true
                                        spacing: 12
                                        Repeater {
                                            model: ssbmsTelemetryAvailable ? ssbmsTelemetry.cells : []
                                            delegate: Text { color: fieldLabelStyle.color; text: "C" + (index + 1) + ": " + Number(modelData).toFixed(3) + " V" }
                                        }
                                    }
                                }
                            }
                        }
