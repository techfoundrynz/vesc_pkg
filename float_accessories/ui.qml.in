                                }
                                SpinBox {
                                    id: canLoopFreq
                                    from: 1
                                    to: 100
                                    value: 20
                                    stepSize: 1
                                    editable: true
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Humidity Sensor"
                        Layout.fillWidth: true
                        visible: humidityEnabled.checked
                        background: Loader { sourceComponent: cardBg }
                        label: Loader { sourceComponent: cardTitleLabel; onLoaded: item.title = "Humidity Sensor" }
                        topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding

                        ColumnLayout {
                            anchors.fill: parent
                            width: stackLayout.width
                            spacing: 10
                            ColumnLayout {
                                spacing: cardStyle.labelSpacing
                                Text {
                                    color: fieldLabelStyle.color
                                    font.pixelSize: fieldLabelStyle.pixelSize
                                    font.bold: fieldLabelStyle.bold
                                    text: "SDA Pin"
                                }
                                SpinBox {
                                    id: humiditySdaPin
                                    from: -1
                                    to: 100
                                    value: 7
                                    editable: true
                                }
                            }

                            ColumnLayout {
                                spacing: cardStyle.labelSpacing
                                Text {
                                    color: fieldLabelStyle.color
                                    font.pixelSize: fieldLabelStyle.pixelSize
                                    font.bold: fieldLabelStyle.bold
                                    text: "SCL pin"
                                }
                                SpinBox {
                                    id: humiditySlcPin
                                    from: -1
                                    to: 100
                                    value: 7
                                    editable: true
                                }
                            }
                        }
                    }

                    // Diagnostics. Unlike the rest of this page these are applied
                    // the moment they are toggled, live in RAM, and reset on
                    // reboot - verbose logging is a debugging aid, not a setting.
                    GroupBox {
                        title: "Diagnostics"
                        Layout.fillWidth: true
                        background: Loader { sourceComponent: cardBg }
                        label: Loader { sourceComponent: cardTitleLabel; onLoaded: item.title = "Diagnostics" }
                        topPadding: cardStyle.topPadding; leftPadding: cardStyle.sidePadding; rightPadding: cardStyle.sidePadding; bottomPadding: cardStyle.bottomPadding

                        ColumnLayout {
                            anchors.fill: parent
                            spacing: cardStyle.fieldSpacing

                            Text {
                                Layout.fillWidth: true
                                wrapMode: Text.WordWrap
                                color: fieldLabelStyle.color
                                font.pixelSize: fieldLabelStyle.pixelSize - 2
                                text: "Logs appear in Dev Tools → Lisp → Console. Enable the areas you need. Logging resets on reboot."
                            }

                            Text {
                                Layout.fillWidth: true
                                color: debugMask === 0 ? fieldLabelStyle.color : "#8fdc8f"
                                font.pixelSize: fieldLabelStyle.pixelSize
                                font.bold: true
                                text: debugMask === 0
                                      ? "Verbose logging: OFF"
                                      : ("Verbose logging: ON (mask " + debugMask + ")")
                            }

                            GridLayout {
                                Layout.fillWidth: true
                                columns: 2
                                columnSpacing: 12
                                rowSpacing: 0

                                CheckBox { id: dbgCore;  text: "Core / threads";  onToggled: sendDebugMask() }
                                CheckBox { id: dbgCfg;   text: "Config";          onToggled: sendDebugMask() }
                                CheckBox { id: dbgCan;   text: "CAN / telemetry"; onToggled: sendDebugMask() }
                                CheckBox { id: dbgLed;   text: "Lighting";        onToggled: sendDebugMask() }
                                CheckBox { id: dbgBms;   text: "BMS";             onToggled: sendDebugMask() }
                                CheckBox { id: dbgRem;   text: "Pubmote";         onToggled: sendDebugMask() }
                                CheckBox { id: dbgGnss;  text: "GNSS";            onToggled: sendDebugMask() }
                                CheckBox { id: dbgHum;   text: "Humidity";        onToggled: sendDebugMask() }
                                CheckBox { id: dbgSdlog; text: "SD logging";      onToggled: sendDebugMask() }
                                CheckBox { id: dbgCmd;   text: "Commands";        onToggled: sendDebugMask() }
                            }

                            RowLayout {
                                Layout.fillWidth: true
                                spacing: 10

                                Button {
                                    text: "Enable All"
                                    enabled: !statusTimeout
                                    onClicked: { applyDebugMask(1023); sendDebugMaskValue(1023) }
                                }
                                Button {
                                    text: "Disable All"
                                    enabled: !statusTimeout
                                    onClicked: { applyDebugMask(0); sendDebugMaskValue(0) }
                                }
                                Item { Layout.fillWidth: true }
                                Button {
                                    text: "Print Report"
                                    enabled: !statusTimeout
                                    onClicked: sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(diag)")
                                }
                            }

                            Text {
                                Layout.fillWidth: true
                                wrapMode: Text.WordWrap
                                color: fieldLabelStyle.color
                                font.pixelSize: fieldLabelStyle.pixelSize - 2
                                text: "Print Report sends a system snapshot to the console, even with logging off."
                            }

                            // Test mode fakes the telemetry every subsystem reads, not just the
                            // lighting, so it belongs with the diagnostics rather than under the LED
                            // config. Same rules as the switches above: live, RAM-only, gone on reboot.
                            Button {
                                text: "Test Mode"
                                Layout.fillWidth: true
                                enabled: !statusTimeout
                                onClicked: simPopup.open()
                            }
                        }
                    }


                    }
                }
            }

        }

        Text {
            Layout.fillWidth: true
            visible: (tabBar.currentIndex === 1 || tabBar.currentIndex === 2)
                && readConfig && !statusTimeout && pinConfigError !== ""
            wrapMode: Text.WordWrap
            color: statusSummary.severityColor(2)
            text: pinConfigError
        }

        // Save and Restore Buttons
        RowLayout {
            Layout.fillWidth: true
            spacing: 10
            visible: tabBar.currentIndex === 1 || tabBar.currentIndex === 2

            Item { Layout.fillWidth: true }

            Button {
                text: statusTimeout ? "Not connected" : "Save Config"
                enabled: readConfig && !statusTimeout
                onClicked: {
                    if (owBmsEnabled && !acceptTOS) {
                        termsPopup.visible = true
                    }

                    if (!requireCustomConf()) {
                        return
                    }

                    if (pinConfigError !== "") {
                        VescIf.emitMessageDialog("Invalid GPIO", pinConfigError, false, false)
                        return
                    }

                    writeConfigToParams()
                    mCommands.customConfigSet(faConfigIndex, mCustomConf)

                    if ((ssbmsBleSelected) && (expressBleClientMissing || expressBleRole === -1)) {
                        var bleUser = "SSBMS BLE"
                        VescIf.emitMessageDialog("Bluetooth Client",
                            expressBleRole === -1
                                ? "Config saved, but this VESC Express firmware has no LispBM Bluetooth client, so " + bleUser + " cannot connect."
                                : "Config saved, but the VESC Express Bluetooth LispBM role is " + expressBleRoleNames[expressBleRole]
                                  + ", so " + bleUser + " cannot connect. Use Set Role on the SSBMS BLE card, or set it under VESC Express > Bluetooth, then reboot.",
                            false, false)
                    }

                    //sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(save-config)")
                    //mCommands.customConfigGet(faConfigIndex, false)
                }
            }

            ToolButton {
                id: optionsButton
                text: "⋮"
                font.pixelSize: 24
                enabled: !statusTimeout
                onClicked: optionsMenu.open()

                Menu {
                    id: optionsMenu
                    y: optionsButton.height

                    MenuItem {
                        text: "Read Config"
                        onClicked: {
                            mCommands.customConfigGet(faConfigIndex, false)
                        }
                    }

                    MenuItem {
                        text: "Restore Default Config"
                        onClicked: {
                            sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(restore-config)")
                            mCommands.customConfigGet(faConfigIndex, false)
                        }
                    }
                }
            }
        }
    }

    function updateStatusLEDSettings() {
        switch(ledStatusStripType.value) {
            case 0: // None
                break
            case 1: // Custom
                break
            default:
                // Do nothing, keep user-defined values
        }
    }

    // Front/rear board presets. Selecting one just fills the concrete
    // hardware description below - only those values are stored in the
    // config, the preset itself is not. hbPos holds embedded highbeam LED
    // positions; hbMin/hbMax the drive range those LEDs expect.
    property var stripPresets: [
        { },                                                                        // 0 None
        { },                                                                        // 1 Custom
        { num: 18, type: 0, hbMode: 2, hbPos: [0], hbMin: 0.0, hbMax: 1.0 },        // 2 Avaspark Laserbeam
        { num: 16, type: 0, hbMode: 2, hbPos: [0], hbMin: 0.0, hbMax: 1.0 },        // 3 Avaspark Laserbeam Pint
        { num: 17, type: 0, hbMode: 2, hbPos: [3,8,14,19], hbMin: 0.6, hbMax: 0.8 },// 4 JetFleet H4
        { num: 17, type: 0, hbMode: 2, hbPos: [3,8,14,19], hbMin: 0.6, hbMax: 1.0 },// 5 JetFleet H4 (no limit)
        { num: 11, type: 0, hbMode: 2, hbPos: [1,4,10,13], hbMin: 0.6, hbMax: 1.0 },// 6 JetFleet GT
        { num: 11, type: 2, hbMode: 1, hbPos: [], hbMin: 0.0, hbMax: 1.0 },         // 7 Stock GT (PWM highbeam)
        { num: 13, type: 0, hbMode: 2, hbPos: [0], hbMin: 0.0, hbMax: 1.0 },        // 8 Avaspark Laserbeam V2
        { num: 10, type: 0, hbMode: 2, hbPos: [0], hbMin: 0.0, hbMax: 1.0 },        // 9 Avaspark Laserbeam V2 Pint
        { num: 20, type: 0, hbMode: 2, hbPos: [0], hbMin: 0.0, hbMax: 1.0 },        // 10 Light-shutka Flashfires
        { num: 10, type: 0, hbMode: 2, hbPos: [3,6,9,13], hbMin: 0.4, hbMax: 1.0 }, // 11 Fungineers GTFO
    ]

    // Highbeam hardware description per strip (0 none, 1 PWM pin,
    // 2 embedded LEDs). Filled by the presets, kept as-is for Custom.
    property int frontHbMode: 0
    property var frontHbPos: []
    property real frontHbMin: 0.0
    property real frontHbMax: 1.0
    property int rearHbMode: 0
    property var rearHbPos: []
    property real rearHbMin: 0.0
    property real rearHbMax: 1.0

    // Positions pack one per byte from the lowest, 255 = unused.
    // Slots -> the array the config packer wants. Blank slots are skipped and a
    // repeat of an earlier value is dropped, so the array is what will actually be
    // stored; the caller re-fills the boxes from it, which is what makes a
    // correction visible rather than silent. Entry order is kept: these are four
    // slots, not a sorted set, and having values jump between boxes on commit
    // would be worse than a preset showing as Custom.
    function hbSlotsToArray(slots) {
        var out = []
        for (var i = 0; i < slots.length; i++) {
            var t = String(slots[i].text).trim()
            if (t === "") continue
            var v = parseInt(t, 10)
            if (isNaN(v) || v < 0 || v > 254) continue
            if (out.indexOf(v) >= 0) continue
            out.push(v)
        }
        return out
    }

    function hbArrayToSlots(pos, slots) {
        for (var i = 0; i < slots.length; i++) {
            slots[i].text = (pos && i < pos.length) ? String(pos[i]) : ""
        }
    }

    function frontHbSlots() {
        return [ledFrontHbPos0, ledFrontHbPos1, ledFrontHbPos2, ledFrontHbPos3]
    }

    function rearHbSlots() {
        return [ledRearHbPos0, ledRearHbPos1, ledRearHbPos2, ledRearHbPos3]
    }

    function commitFrontHbSlots() {
        frontHbPos = hbSlotsToArray(frontHbSlots())
        hbArrayToSlots(frontHbPos, frontHbSlots())
    }

    function commitRearHbSlots() {
        rearHbPos = hbSlotsToArray(rearHbSlots())
        hbArrayToSlots(rearHbPos, rearHbSlots())
    }

    // The strip's real footprint. led_*_num excludes the highbeam pixels, so the
    // total is num + however many positions are declared.
    function hbFootprintText(num, pos) {
        if (!pos || pos.length === 0) {
            return num + " LEDs, no highbeam pixels"
        }
        var total = num + pos.length
        var msg = num + " + " + pos.length + " highbeam = " + total + " LEDs on this strip"
        if (hbFootprintBad(num, pos)) {
            msg += " - position " + Math.max.apply(null, pos) + " is past the end and will be dropped"
        }
        return msg
    }

    // Mirrors hb-positions in led.lisp: a position at or past the footprint is
    // rejected by the lib, so the package filters it out and warns.
    function hbFootprintBad(num, pos) {
        if (!pos || pos.length === 0) {
            return false
        }
        return Math.max.apply(null, pos) >= num + pos.length
    }

    // Properties -> controls. Called after a config read and after a preset fills
    // the properties in; the controls only ever write back on user interaction, so
    // there is no binding loop to worry about.
    function syncHbControls() {
        ledFrontHighbeamMode.currentIndex = frontHbMode
        hbArrayToSlots(frontHbPos, frontHbSlots())
        ledFrontHighbeamMin.value = Math.round(frontHbMin * 100)
        ledFrontHighbeamMax.value = Math.round(frontHbMax * 100)
        ledRearHighbeamMode.currentIndex = rearHbMode
        hbArrayToSlots(rearHbPos, rearHbSlots())
        ledRearHighbeamMin.value = Math.round(rearHbMin * 100)
        ledRearHighbeamMax.value = Math.round(rearHbMax * 100)
    }

    function packHbPos(arr) {
        var v = 0
        for (var i = 0; i < 4; i++) {
            v |= (i < arr.length ? (arr[i] & 0xFF) : 0xFF) << (8 * i)
        }
        return v
    }

    function unpackHbPos(v) {
        var arr = []
        for (var i = 0; i < 4; i++) {
            var b = (v >> (8 * i)) & 0xFF
            if (b !== 0xFF) arr.push(b)
        }
        return arr
    }

    // Find the preset matching a loaded config, 1 (Custom) when none does.
    function matchStripPreset(num, type, hbMode, hbPos, hbMin, hbMax) {
        for (var i = 2; i < stripPresets.length; i++) {
            var p = stripPresets[i]
            if (p.num === num && p.type === type && p.hbMode === hbMode
                && Math.abs(p.hbMin - hbMin) < 0.01
                && Math.abs(p.hbMax - hbMax) < 0.01
                && JSON.stringify(p.hbPos) === JSON.stringify(hbPos)) {
                return i
            }
        }
        return 1
    }

    function updateFrontLEDSettings() {
        var p = stripPresets[ledFrontStripType.value]
        if (!p || p.num === undefined) {
            return // None / Custom keep the user-defined values
        }
        ledFrontNum.value = p.num
        ledFrontType.currentIndex = p.type
        frontHbMode = p.hbMode
        frontHbPos = p.hbPos
        frontHbMin = p.hbMin
        frontHbMax = p.hbMax
        syncHbControls()
    }

    function updateRearLEDSettings() {
        var p = stripPresets[ledRearStripType.value]
        if (!p || p.num === undefined) {
            return // None / Custom keep the user-defined values
        }
        ledRearNum.value = p.num
        ledRearType.currentIndex = p.type
        rearHbMode = p.hbMode
        rearHbPos = p.hbPos
        rearHbMin = p.hbMin
        rearHbMax = p.hbMax
        syncHbControls()
    }

    function updateFootpadLEDSettings() {
        switch(ledFootpadStripType.value) {
            case 0: // None
                break
            case 1: // Custom
                break
            default:
                // Do nothing, keep user-defined values
        }
    }

    function bmsFactoryInit(str) {
        sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(bms-request-factory-init)")
    }

    function makeControlArgStr() {
        return [
            ledOn.checked * 1,
            ledHighbeamOn.checked * 1,
            parseFloat(ledBrightnessLoader.item.value).toFixed(2),
            parseFloat(ledBrightnessHighbeamLoader.item.value).toFixed(2),
            parseFloat(ledBrightnessIdleLoader.item.value).toFixed(2),
            parseFloat(ledBrightnessStatusLoader.item.value).toFixed(2),
            bmsChargeState.checked * 1
        ].join(" ");
    }

    function handleDebouncedChange() {
        if (!throttleTimer.running) {
            applyControlChanges()
            throttleTimer.start()
        } else {
            throttleTimer.controlPending = true
        }
    }

    function flushControlChanges() {
        if (throttleTimer.controlPending) {
            applyControlChanges()
            throttleTimer.controlPending = false
        }
        throttleTimer.stop()
    }

    function applyControlChanges() {
        //console.log("Applying LED control settings after debounce")
        sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(recv-control " + makeControlArgStr() + " )")
    }

    // Push every control into the custom config. The transfer is VESC
    // Tool's job from here: customConfigSet writes it, fa_cfg persists it
    // to eeprom and flags it changed, and the lisp config-watch-loop picks
    // that up and applies it.
    function writeConfigToParams() {
        mCustomConf.updateParamBool("led_enabled", ledEnabled.checked)
        mCustomConf.updateParamBool("bms_enabled", bmsEnabled.checked)
        mCustomConf.updateParamEnum("bms_backend", bmsBackend.currentIndex)
        mCustomConf.updateParamInt("ssbms_uart_rx_pin", ssbmsUartRxPin.value)
        mCustomConf.updateParamInt("ssbms_uart_tx_pin", ssbmsUartTxPin.value)
        mCustomConf.updateParamInt("ssbms_ble_paired_address_a", ssbmsBleAddressA)
        mCustomConf.updateParamInt("ssbms_ble_paired_address_b", ssbmsBleAddressB)
        mCustomConf.updateParamBool("pubmote_enabled", pubmoteEnabled.checked)
        mCustomConf.updateParamBool("led_on", ledOn.checked)
        mCustomConf.updateParamBool("led_highbeam_on", ledHighbeamOn.checked)
        mCustomConf.updateParamEnum("led_mode", ledMode.currentIndex)
        mCustomConf.updateParamEnum("led_mode_idle", ledModeIdle.currentIndex)
        mCustomConf.updateParamEnum("led_mode_status", ledModeStatus.currentIndex)
        mCustomConf.updateParamEnum("led_mode_startup", ledModeStartup.currentIndex)
        mCustomConf.updateParamEnum("led_mode_button", ledModeButton.currentIndex)
        mCustomConf.updateParamEnum("led_mode_footpad", ledModeFootpad.currentIndex)
        mCustomConf.updateParamBool("led_mall_grab_enabled", ledMallGrabEnabled.checked)
        mCustomConf.updateParamBool("led_brake_light_enabled", ledBrakeLightEnabled.checked)
        mCustomConf.updateParamDouble("led_brake_light_min_amps", parseFloat(ledBrakeLightMinAmps.value).toFixed(2))
        mCustomConf.updateParamInt("idle_timeout", idleTimeout.value)
        mCustomConf.updateParamInt("idle_timeout_shutoff", idleTimeoutShutoff.value)
        mCustomConf.updateParamDouble("led_brightness", parseFloat(ledBrightnessLoader.item.value).toFixed(2))
        mCustomConf.updateParamDouble("led_brightness_highbeam", parseFloat(ledBrightnessHighbeamLoader.item.value).toFixed(2))
        mCustomConf.updateParamDouble("led_brightness_idle", parseFloat(ledBrightnessIdleLoader.item.value).toFixed(2))
        mCustomConf.updateParamDouble("led_brightness_status", parseFloat(ledBrightnessStatusLoader.item.value).toFixed(2))
        mCustomConf.updateParamInt("led_status_pin", ledStatusPin.value)
        mCustomConf.updateParamInt("led_status_num", ledStatusNum.value)
        mCustomConf.updateParamEnum("led_status_type", ledStatusType.currentIndex)
        mCustomConf.updateParamEnum("led_status_white_output", ledStatusWhiteOutput.currentIndex)
        mCustomConf.updateParamBool("led_status_reversed", ledStatusReversed.checked)
        mCustomConf.updateParamInt("led_front_pin", ledFrontPin.value)
        mCustomConf.updateParamInt("led_front_num", ledFrontNum.value)
        mCustomConf.updateParamEnum("led_front_type", ledFrontType.currentIndex)
        mCustomConf.updateParamEnum("led_front_white_output", ledFrontWhiteOutput.currentIndex)
        mCustomConf.updateParamBool("led_front_reversed", ledFrontReversed.checked)
        mCustomConf.updateParamEnum("led_front_timing", ledFrontStripType.currentIndex > 0 ? ledFrontTiming.currentIndex + 1 : 0)
        mCustomConf.updateParamInt("led_rear_pin", ledRearPin.value)
        mCustomConf.updateParamInt("led_rear_num", ledRearNum.value)
        mCustomConf.updateParamEnum("led_rear_type", ledRearType.currentIndex)
        mCustomConf.updateParamEnum("led_rear_white_output", ledRearWhiteOutput.currentIndex)
        mCustomConf.updateParamBool("led_rear_reversed", ledRearReversed.checked)
        mCustomConf.updateParamEnum("led_rear_timing", ledRearStripType.currentIndex > 0 ? ledRearTiming.currentIndex + 1 : 0)
        mCustomConf.updateParamInt("led_button_pin", ledButtonPin.value)
        mCustomConf.updateParamEnum("led_button_timing", ledButtonStripType.currentIndex > 0 ? 1 : 0)
        mCustomConf.updateParamInt("led_footpad_pin", ledFootpadPin.value)
        mCustomConf.updateParamInt("led_footpad_num", ledFootpadNum.value)
        mCustomConf.updateParamEnum("led_footpad_type", ledFootpadType.currentIndex)
        mCustomConf.updateParamEnum("led_footpad_white_output", ledFootpadWhiteOutput.currentIndex)
        mCustomConf.updateParamBool("led_footpad_reversed", ledFootpadReversed.checked)
        mCustomConf.updateParamEnum("led_footpad_timing", ledFootpadStripType.currentIndex > 0 ? ledFootpadTiming.currentIndex + 1 : 0)
        mCustomConf.updateParamInt("bms_rs485_di_pin", bmsRs485DIPin.value)
        mCustomConf.updateParamInt("bms_rs485_ro_pin", bmsRs485ROPin.value)
        mCustomConf.updateParamInt("bms_rs485_dere_pin", bmsRs485DEREPin.value)
        mCustomConf.updateParamInt("bms_wakeup_pin", bmsWakeupPin.value)
        mCustomConf.updateParamInt("bms_override_soc", bmsOverrideSOC.checked * 1)
        mCustomConf.updateParamInt("bms_rs485_chip", bmsRS485Chip.checked * 1)
        mCustomConf.updateParamInt("led_loop_delay", ledLoopDelay.value)
        mCustomConf.updateParamInt("bms_loop_delay", bmsLoopDelay.value)
        mCustomConf.updateParamInt("pubmote_loop_delay", pubmoteLoopDelay.value)
        mCustomConf.updateParamInt("can_loop_delay", canLoopFreq.value)
        mCustomConf.updateParamEnum("integration", integrationSelector.currentIndex)
        mCustomConf.updateParamDouble("led_dim_on_highbeam_ratio", parseFloat(ledDimOnHighbeamRatioLoader.item.value).toFixed(2))
        mCustomConf.updateParamInt("bms_type", bmsType.currentIndex)
        mCustomConf.updateParamEnum("led_status_timing", ledStatusStripType.currentIndex > 0 ? ledStatusTiming.currentIndex + 1 : 0)
        mCustomConf.updateParamBool("bms_charge_only", bmsChargeOnly.checked)
        mCustomConf.updateParamBool("led_show_battery_charging", ledShowBatteryCharging.checked)
        mCustomConf.updateParamInt("led_front_highbeam_pin", ledFrontHighbeamPin.value)
        mCustomConf.updateParamInt("led_rear_highbeam_pin", ledRearHighbeamPin.value)
        mCustomConf.updateParamInt("bms_buff_size", bmsBuffSize.value)
        mCustomConf.updateParamDouble("led_max_brightness", parseFloat(ledMaxBrightnessLoader.item.value).toFixed(2))
        mCustomConf.updateParamInt("soc_type", voltageCurveSoc.checked * 1)
        mCustomConf.updateParamInt("cell_type", cellType.value)
        mCustomConf.updateParamBool("log_enabled", logEnabled.checked)
        mCustomConf.updateParamDouble("log_rate", logRate.value)
        mCustomConf.updateParamBool("log_append_gnss", logAppendGnss.checked)
        mCustomConf.updateParamBool("humidity_enabled", humidityEnabled.checked)
        mCustomConf.updateParamInt("humidity_sda_pin", humiditySdaPin.value)
        mCustomConf.updateParamInt("humidity_slc_pin", humiditySlcPin.value)
        mCustomConf.updateParamEnum("led_front_highbeam_mode", frontHbMode)
        mCustomConf.updateParamInt("led_front_highbeam_pos", packHbPos(frontHbPos))
        mCustomConf.updateParamDouble("led_front_highbeam_min", frontHbMin.toFixed(2))
        mCustomConf.updateParamDouble("led_front_highbeam_max", frontHbMax.toFixed(2))
        mCustomConf.updateParamEnum("led_rear_highbeam_mode", rearHbMode)
        mCustomConf.updateParamInt("led_rear_highbeam_pos", packHbPos(rearHbPos))
        mCustomConf.updateParamDouble("led_rear_highbeam_min", rearHbMin.toFixed(2))
        mCustomConf.updateParamDouble("led_rear_highbeam_max", rearHbMax.toFixed(2))
        mCustomConf.updateParamBool("gnss_enabled", gnssEnabled.checked)
        mCustomConf.updateParamEnum("gnss_type", gnssType.currentIndex)
        mCustomConf.updateParamInt("gnss_rx_pin", gnssRxPin.value)
        mCustomConf.updateParamInt("gnss_tx_pin", gnssTxPin.value)
        mCustomConf.updateParamInt("gnss_uart_num", gnssUartNum.value)
        mCustomConf.updateParamInt("gnss_rate_ms", gnssRateMs.value)
        mCustomConf.updateParamInt("gnss_baud", gnssBaud.value)
    }

    // Property to track enabled tabs
    property var enabledIndices: []

    // Update enabled indices whenever checkbox states change
    onEnabledIndicesChanged: {
        // If current tab is disabled, switch to first enabled tab
        if (!enabledIndices.includes(tabBar2.currentIndex)) {
            const firstEnabled = enabledIndices[0]
            if (firstEnabled !== undefined) {
                tabBar2.currentIndex = firstEnabled
            }
        }
    }

    function updateEnabledIndices() {
        const newIndices = []
        if (ledEnabled.checked) newIndices.push(0)
        if (pubmoteEnabled.checked) newIndices.push(1)
        if (bmsEnabled.checked) newIndices.push(2)
        if (logEnabled.checked) newIndices.push(3)
        if (gnssEnabled.checked) newIndices.push(4)
        enabledIndices = newIndices
    }

    function sendCode(str) {
        mCommands.sendCustomAppData(str + '\0')
    }

    // ---- Diagnostics (verbose logging) ----
    // The checkboxes are the source of truth for the mask we send; the board
    // echoes back what it applied and applyDebugMask() pushes that back into
    // the checkboxes. Bit values must match the DBG-* constants in
    // lib/debug.lisp.
    function debugMaskFromUi() {
        return (dbgCore.checked  ? 1   : 0)
             | (dbgCfg.checked   ? 2   : 0)
             | (dbgCan.checked   ? 4   : 0)
             | (dbgLed.checked   ? 8   : 0)
             | (dbgBms.checked   ? 16  : 0)
             | (dbgRem.checked   ? 32  : 0)
             | (dbgGnss.checked  ? 64  : 0)
             | (dbgHum.checked   ? 128 : 0)
             | (dbgSdlog.checked ? 256 : 0)
             | (dbgCmd.checked   ? 512 : 0)
    }

    function applyDebugMask(m) {
        debugMask = m
        dbgCore.checked  = (m & 1)   !== 0
        dbgCfg.checked   = (m & 2)   !== 0
        dbgCan.checked   = (m & 4)   !== 0
        dbgLed.checked   = (m & 8)   !== 0
        dbgBms.checked   = (m & 16)  !== 0
        dbgRem.checked   = (m & 32)  !== 0
        dbgGnss.checked  = (m & 64)  !== 0
        dbgHum.checked   = (m & 128) !== 0
        dbgSdlog.checked = (m & 256) !== 0
        dbgCmd.checked   = (m & 512) !== 0
    }

    function sendDebugMaskValue(m) {
        sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(dbg-set " + m + ")")
    }

    function sendDebugMask() {
        var m = debugMaskFromUi()
        debugMask = m
        sendDebugMaskValue(m)
    }

    // ---- Test mode ----
    // 102 is FLOAT_ACCESSORIES_MAGIC and 1 is COMMAND_RUN_LISP, so the string is
    // evaluated on the board. The state there is ten plain globals, so a control
    // change is a setq and nothing more - no setter to keep in step with this file,
    // and a misspelled name fails loudly instead of creating a stray global.
    function sendSim(code) {
        sendCode(String.fromCharCode(102) + String.fromCharCode(1) + code)
    }

    function simSend(field, val) {
        sendSim("(setq " + field + " " + val + ")")
    }

    // toFixed keeps a decimal point in the literal: these globals hold floats on
    // the board and a bare "0" would pin an integer, which then divides as one in
    // the derived speed and current values.
    function simSendF(field, val) {
        simSend(field, val.toFixed(2))
    }

    // Lisp needs t / nil, not true / false.
    function simSendB(field, val) {
        simSend(field, val ? "t" : "nil")
    }

    // Called on every valueChanged while a slider is dragged. First move goes out
    // immediately so the strips react at once; the rest are held until the timer
    // expires, one pending value per field.
    function simSendFThrottled(field, val) {
        if (!simThrottleTimer.running) {
            simSendF(field, val)
            simThrottleTimer.start()
        } else {
            simThrottleTimer.pending[field] = val
        }
    }

    function simFlushPending() {
        var p = simThrottleTimer.pending
        for (var k in p) simSendF(k, p[k])
        simThrottleTimer.pending = ({})
    }

    // On release. Queues the released value first so the board always ends on the
    // exact position the slider was let go at, never a throttled sample from
    // part-way through the drag.
    function simFlushSlider(field, val) {
        simThrottleTimer.pending[field] = val
        simFlushPending()
        simThrottleTimer.stop()
    }

    // Push all twelve as one packet. Used on open and after a preset: twelve
    // separate setqs would walk the board through eleven states nobody chose.
    function simPushAll() {
        sendSim("(sim-load " + [
            simState.model[simState.currentIndex].value,
            simSwitch.model[simSwitch.currentIndex].value,
            simSat.model[simSat.currentIndex].value,
            simRpmLoader.item.value.toFixed(2),
            simDutyLoader.item.value.toFixed(2),
            simPhaseLoader.item.value.toFixed(2),
            simBatLoader.item.value.toFixed(2),
            simBattLoader.item.value.toFixed(2),
            simPitchLoader.item.value.toFixed(2),
            simCharging.checked ? "t" : "nil",
            simHandtest.checked ? "t" : "nil",
            simLink.checked ? "t" : "nil"
        ].join(" ") + ")")
    }

    // A preset fills the controls then pushes once. pushing stops each control
    // echoing its own change: the combos would not (onActivated is user-only) but
    // the sliders fire valueChanged on a programmatic set.
    function simApplyPreset(preset) {
        simPopup.pushing = true
        simState.currentIndex = simState.indexOfValue(preset.st)
        simSwitch.currentIndex = simSwitch.indexOfValue(preset.sw)
        simSat.currentIndex = simSat.indexOfValue(preset.sat)
        simRpmLoader.item.value = preset.rpm
        simDutyLoader.item.value = preset.duty
        simPhaseLoader.item.value = preset.phase
        simBatLoader.item.value = preset.bat
        simBattLoader.item.value = preset.batt
        simPitchLoader.item.value = preset.pitch
        simCharging.checked = preset.chg
        simHandtest.checked = preset.hand
        simLink.checked = preset.link
        simPopup.pushing = false
        simPushAll()
    }

    function hexStringToLispList(hexString) {
        var result = "'(";
        for (var i = 0; i < hexString.length; i += 2) {
            var byteHex = hexString.substr(i, 2);
            result += "0x" + byteHex.toUpperCase() + (i < 30 ? " " : "");
        }
        result += ")";
        return result;
    }

    function applyPubmotePairingState(state) {
        pubmotePairingState = state
        // Idle is reported after pairing saves the MAC, or unpairing clears it.
        // Reading on the button click can return the previous configuration.
        if (state === 0) mCommands.customConfigGet(faConfigIndex, false)
    }

    function unpackUint32ToBytes(packedValue) {
        return [
            (packedValue >> 24) & 0xFF,
            (packedValue >> 16) & 0xFF,
            (packedValue >> 8) & 0xFF,
            packedValue & 0xFF
        ];
    }

    Connections {
        target: mCommands

        function onLispPrintReceived(str) {
            applyBootLog(str)
        }

        function onCustomAppDataReceived(data) {
            var str = data.toString()
            var bootMessage = str.replace(/\0/g, "").trim()
            if (bootMessage.indexOf("fa-boot-state ") === 0) {
                applyBootState(Number(bootMessage.substring(14)))
                return
            }

            if (!wasConnected) {
                // Read settings on initial message
                wasConnected = true
                if (!readConfig) {
                    mCommands.customConfigGet(faConfigIndex, false)
                }
                // The verbose-logging mask is not part of the config, so it
                // has to be asked for separately.
                sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(send-debug)")
            }

            if (str.startsWith("debug ")) {
                // parseInt rather than Number: it stops at the trailing NUL
                // the lisp string carries instead of returning NaN.
                applyDebugMask(parseInt(str.split(" ")[1], 10) || 0)
            } else if (str.startsWith("msg")) {
                var msg = str.substring(4)
                VescIf.emitMessageDialog("Float Accessories", msg, false, false)
            } else if (str.startsWith("float-stats")) {
                var tokens = str.split(" ")

                // Provider-independent integration connection status
                integrationConnectionState = Number(tokens[1])
                if (integrationConnected) {
                    integrationLastStatusTime = 0
                }

                // Pubmote connection status
                pubmoteConnected = !!Number(tokens[2])
                pubmoteWifiChannel = Number(tokens[7])
                if (pubmoteConnected) {
                    pubmoteLastStatusTime = 0
                }

                if (!pubmoteConnected) {
                    pubmoteVersionStr = "Unknown";
                }

                // BMS connection status
                bmsConnected = Number(tokens[3])
                bmsStatusTemp = Number(tokens[4])
                bmsBatteryTypeVal = Number(tokens[5])
                bmsBatteryCyclesVal = Number(tokens[6])

                // Humidity Sensor Status
                lcmHum = parseFloat(tokens[8])
                lcmHumTemp = parseFloat(tokens[9])

                bmsHum = parseFloat(tokens[10])
                bmsHumTemp = parseFloat(tokens[11])

                loggerRunning = parseFloat(tokens[12])

                // GNSS status
                if (tokens.length > 16) {
                    gnssFix = !!Number(tokens[13])
                    gnssAge = parseFloat(tokens[14])
                    gnssHdop = parseFloat(tokens[15])
                    gnssSpeed = parseFloat(tokens[16])
                }

                gpioTarget = tokens.length > 17
                    ? tokens[17].replace(/\0/g, "").trim().toLowerCase() : ""
                // parseInt stops at the trailing NUL of the last token.
                if (tokens.length > 18) {
                    expressBleRole = parseInt(tokens[18], 10)
                }

                // Update status flags
                lastStatusTime = 0  // Reset the timer when status is received
                if (integrationConnected) {
                    integrationLastStatusTime = 0
                } else {
                    integrationLastStatusTime = integrationLastStatusTime // Trigger binding re-evaluation
                }
                
                if (pubmoteConnected) {
                    pubmoteLastStatusTime = 0
                } else {
                    pubmoteLastStatusTime = pubmoteLastStatusTime // Trigger binding re-evaluation
                }

                statusTimeout = false
            } else if (str.startsWith("ssbms-found ")) {
                var found = str.replace(/\0/g, "").split(" ")
                ssbmsBleFound.append({ a: parseInt(found[1], 10), b: parseInt(found[2], 10),
                                       rssi: parseInt(found[3], 10), name: found.slice(4).join(" ") })
            } else if (str.startsWith("ssbms-scan-done ")) {
                var count = parseInt(str.split(" ")[1], 10)
                ssbmsBleScanning = false
                ssbmsBleScanMessage = count === -2
                    ? "Bluetooth busy. Try again shortly."
                    : count < 0 ? "Enable BMS with SSBMS BLE, Save Config, then scan."
                    : (count === 0 ? "No BMS found. Wake it, close other BMS apps, retry." : "")
            } else if (str.startsWith("ssbms-ble-progress ")) {
                var progress = str.replace(/\0/g, "").split(" ")
                ssbmsBleConnectPhase = parseInt(progress[1], 10)
                ssbmsBleProgressMessage = progress.slice(2).join(" ")
                if (ssbmsBleConnecting) ssbmsBleConnectTimer.restart()
                else ssbmsBleConnectTimer.stop()
            } else if (str.startsWith("ssbms-ble-selected ")) {
                var selected = str.replace(/\0/g, "").split(" ")
                if (selected[1] === "1") {
                    ssbmsBleAddressA = parseInt(selected[2], 10)
                    ssbmsBleAddressB = parseInt(selected[3], 10)
                    mCustomConf.updateParamInt("ssbms_ble_paired_address_a", ssbmsBleAddressA)
                    mCustomConf.updateParamInt("ssbms_ble_paired_address_b", ssbmsBleAddressB)
                    ssbmsBleScanMessage = ""
                } else {
                    ssbmsBleScanMessage = "Could not save the BMS selection (test mode blocks config writes)."
                }
            } else if (str.startsWith("ssbms-ble-link ")) {
                var link = str.replace(/\0/g, "").split(" ")
                ssbmsBleLinkConnected = link[1] === "1"
                ssbmsBleLinkA = parseInt(link[2], 10)
                ssbmsBleLinkB = parseInt(link[3], 10)
                ssbmsBleRssi = parseInt(link[4], 10)
            } else if (str.startsWith("control")) {
                var tokens = str.split(" ")
                ledOn.checked = Number(tokens[1])
                ledHighbeamOn.checked = Number(tokens[2])
                ledBrightnessLoader.item.value = Number(tokens[3])
                ledBrightnessHighbeamLoader.item.value = parseFloat(Number(tokens[4]))
                ledBrightnessIdleLoader.item.value = Number(tokens[5])
                ledBrightnessStatusLoader.item.value = Number(tokens[6])
                bmsChargeState.checked = Number(tokens[7])
            } else if (str.startsWith("status Settings Read")) {
                sendCode(String.fromCharCode(102) + String.fromCharCode(1) + "(send-control)")
                var msg = str.substring(7)
                VescIf.emitStatusMessage(msg, true)
            } else if (str.startsWith("status")) {
                var msg = str.substring(7)
                VescIf.emitStatusMessage(msg, true)
            } else if (str.startsWith("pubmote-info")) {
                var tokens = str.split(" ");
                var newVersion = "unknown";
                if (tokens.length >= 2) {
                   var version = tokens[1].split(".");
                    if (version.length >= 3 && (version[0] || version[1] || version[2])) {
                        newVersion = tokens[1];
                    }
                }
                pubmoteVersionStr = newVersion;
            } else if (str.startsWith("pairing-status")) {
                var tokens = str.split(" ");
                applyPubmotePairingState(parseInt(tokens[1], 10));
            } else if (str.startsWith("ssbms-state ")) {
                applySsbmsTelemetry(str)
            } else if (str.startsWith("input-state")) {
                var tokens = str.split(" ");
                var pmConn = !!Number(tokens[1]);
                pubmoteInputConnected = pmConn;
                // Neutral when the remote isn't connected, so a dropped
                // link doesn't leave the last stick/buttons frozen.
                pubmoteInputJsy = pmConn ? parseFloat(tokens[2]) : 0;
                pubmoteInputJsx = pmConn ? parseFloat(tokens[3]) : 0;
                pubmoteInputBtC = pmConn ? !!Number(tokens[4]) : false;
                pubmoteInputBtZ = pmConn ? !!Number(tokens[5]) : false;
                pubmoteInputRev = pmConn ? !!Number(tokens[6]) : false;
            } else if (str.startsWith("gnss-state")) {
                var gs = str.split(" ")
                var gFix = !!Number(gs[1])
                // On any fix gained/lost transition, drop the stale track so
                // it rebuilds fresh instead of drawing a line across the gap.
                if (gFix !== gnssPreviewFix) {
                    gnssTrack = []
                    gnssTrackHasOrigin = false
                    gnssTrackCanvas.requestPaint()
                }
                gnssPreviewFix = gFix
                if (gFix) {
                    gnssPreviewLat = parseFloat(gs[2])
                    gnssPreviewLon = parseFloat(gs[3])
                    gnssPreviewHdop = parseFloat(gs[4])
                    gnssPreviewSpeed = parseFloat(gs[5])
                    gnssPreviewAge = parseFloat(gs[6])
                    appendGnssPoint(gnssPreviewLat, gnssPreviewLon)
                } else {
                    gnssPreviewLat = 0
                    gnssPreviewLon = 0
                    gnssPreviewHdop = 99
                    gnssPreviewSpeed = 0
                    gnssPreviewAge = parseFloat(gs[6])
                }
            }
        }
    }
}
