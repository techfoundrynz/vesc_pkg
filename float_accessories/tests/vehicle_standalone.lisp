(setup)
(init)
(expect test-lights-started t)
(expect (> (length test-threads) 0) t)
(expect integration-id 0)
(expect (integration-connection-state) 0)
(expect (integration-connecting) nil)
(expect (vehicle-fresh) nil)
(expect (running-state) nil)
(integration-step)
(integration-control 0.5 0.0 0 0 nil)
((assoc test-pubmote-hooks 'on-control) 0.5 0.0 0 0 nil)
(expect test-controls 0)
(expect test-sends 0)
; Run the real housekeeping loop through its first yield; no provider probes
; or ESC queries should be issued, even with an old stored controller ID.
(call-cc (fn (done) {
    (setq test-can-stop done)
    (can-loop)
}))
(setq test-can-stop nil)
(expect test-sends 0)
(expect test-controls 0)
; Magic 101 is harmless without a selected adapter.
(def unsolicited (bufcreate 2))
(bufset-u8 unsolicited 0 101)
(bufset-u8 unsolicited 1 51)
(command-rx unsolicited)
(expect can-last-activity-time 0)
; Own QML command interface still works without Refloat (magic 102).
(def expr "(setq led-brightness 0.25)")
(def control (bufcreate (+ (str-len expr) 2)))
(bufset-u8 control 0 102)
(bufset-u8 control 1 1)
(bufcpy control 2 expr 0 (str-len expr))
(command-rx control)
(near led-brightness 0.25)

(setq led-mode 5)
(setq led-mode-idle 0)
(setq led-max-brightness 0.3)
(setq idle-timeout 1)
(setq idle-timeout-shutoff 2)
(setq led-front-highbeam-mode 1)
(setq led-rear-highbeam-mode 0)
(setq led-highbeam-on 1)
(setq led-brake-light-enabled 1)
(setq led-brake-light-min-amps -4)
(setq seg-front 0)
(setq seg-rear 1)
(setq seg-status 2)
(setq led-front-type TYPE-GRB)
(setq led-rear-type TYPE-GRB)
(setq test-now 1000.0)
(led-track-direction)
(led-track-mall-grab)
(led-track-activity)
(led-decide)
(expect current-led-mode 5)
(near led-current-brightness 0.25)
(near hb-frac 0.3)
(expect hb-front t)
(expect braking nil)
(expect lights-off nil)
(expect led-mall-grab 0)
(expect direction 1)
(led-draw-drive)
(expect (bufget-u8 seg-want-look 0) FX-RAINBOW)
(led-draw-status)
(expect (bufget-u8 seg-want-look (+ (* seg-status 8) 3)) 0)
; BMS gauges work independently of any vehicle provider.
(setq test-bms-enabled 1)
(setq test-bms-backend 1)
(setq bms-active-backend BMS-BACKEND-OW)
(setq bms-status 0)
(setq bms-valid t)
(setq bms-worker-running t)
(setq bms-active-hooks (list nil nil nil nil nil))
(setq bms-last-activity-time test-now)
(vehicle-refresh-battery)
(near battery-percent-remaining 0.75)
(expect (battery-data-fresh) t)
(led-draw-status)
(expect (bufget-u8 seg-want-look (* seg-status 8)) FX-GAUGE)
(setq led-mode 1)
(led-decide)
(led-draw-drive)
(expect (bufget-u8 seg-want-look 0) FX-GAUGE)
; A configured but unbundled provider also degrades to standalone.
(if (eq integration-registry nil) {
    (integration-select 1)
    (expect integration-id 0)
    (integration-step)
    (expect test-sends 0)
})
; The provider contract also supports transports without a CAN controller ID.
(integration-register 2 (fn () t) (fn () t) (fn (data) nil)
    (fn (a b c d e) t) (fn () t))
(integration-select 2)
(expect (integration-connection-state) 1)
(expect (integration-connecting) t)
(integration-step)
(vehicle-publish 1 '(1 0 3 nil 0 0 72 1000 20 10 2 0.5 -1 30 30 -1 0.8 3 3 0))
(expect (vehicle-fresh) nil)
(vehicle-publish 2 '(1 0 3 nil 0 0 72 1000 20 10 2 0.5 -1 30 30 -1 0.8 3 3 0))
(expect can-id -1)
(expect (vehicle-fresh) t)
(expect (integration-connection-state) 2)
(expect (running-state) t)
(integration-select 0)
(expect (integration-connection-state) 0)
(expect (vehicle-fresh) nil)
(check test-ok)
