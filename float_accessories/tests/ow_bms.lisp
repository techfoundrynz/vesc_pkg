(def DBG-BMS 16)
(def now 10.0)
(def backend 1)
(def writes nil)
(def broadcasts 0)
(def stops 0)
(def incoming nil)
(defun get-config (key) (match key (bms-enabled 1) (bms-backend backend) (bms-type 2) (bms-rs485-chip 1) (_ 0)))
(defun test-clock () now)
(defun test-age (stamp) (- now stamp))
(defun test-value (field value) (setq writes (acons field value writes)))
(defun test-indexed (field index value) (setq writes (acons field (list index value) writes)))
(defun test-broadcast () (setq broadcasts (+ broadcasts 1)))
(defun test-stop () (setq stops (+ stops 1)))
(defun test-read (buffer size a b timeout) { (bufcpy buffer 0 incoming 0 (buflen incoming)) (buflen incoming) })
(defun test-crypt (key counter data start len) { (bufset-u8 counter 15 99) t })
(defun dbg-active (category) nil)
(defun dbg-tick (a b c) nil)
(defun expect (actual wanted)
    (if (not (eq actual wanted)) (exit-error (to-str (list actual 'wanted wanted)))))
; Imports allocate no protocol buffers and cannot open hardware.
(expect ow-key nil)
(expect ow-counter nil)
(expect ow-magic nil)
(expect ow-buf nil)
(setq bms-active-backend 1)
(setq bms-worker-running t)
(setq bms-active-hooks (assoc bms-registry 1))
(expect (bms-connected) nil)
(setq ow-key (bufcreate 16))
(setq ow-counter (bufcreate 16))
(setq ow-magic [255 85 170])
(setq ow-buf (bufcreate 64))
(setq incoming [255 85 170 3 75 0 0 0 0 0])
(defun seal () (bufset-u16 incoming (- (buflen incoming) 2) (ow-checksum incoming 0 (- (buflen incoming) 2))))
(seal)
(ow-recv-packets -1 -1)
(expect (assoc writes 'bms-soc) 0.75)
(expect (bms-connected) t)
(expect bms-status -1)
(expect broadcasts 1)
; A bad checksum, unknown command or magic alone cannot refresh a connection.
(setq now 12.0)
(bufset-u8 incoming 4 76)
(ow-recv-packets -1 -1)
(expect (bms-connected) nil)
(expect broadcasts 1)
(bufset-u8 incoming 3 0x22)
(seal)
(ow-recv-packets -1 -1)
(expect bms-last-activity-time 10.0)
(setq incoming [255 85 170])
(ow-recv-packets -1 -1)
(expect bms-last-activity-time 10.0)
; Encrypted framing invokes crypto, restores the counter byte, then publishes.
(setq ow-use-crypto t)
(setq incoming [255 85 170 0 1 3 80 0 0 0 0 0])
(bufset-u8 ow-counter 15 7)
(seal)
(ow-recv-packets -1 -1)
(expect (bufget-u8 ow-counter 15) 7)
(expect (assoc writes 'bms-soc) 0.8)
(expect (bms-connected) t)
(expect (bms-capabilities) 7)
(expect (bms-request-charge 1) t)
(expect ow-charge-target 1)
(expect ow-user-cmd 0x64)
(expect (bms-request-factory-init) t)
(expect ow-user-cmd 0x0e)
(expect (bms-pair '(1) '(2)) nil)
(bms-publish-info 1 'cycles 42)
(expect bms-battery-cycles 42)
(bms-publish-status 1 2 t nil t t)
(expect bms-status 102)
; A former backend cannot update shared data after selection changes.
(setq backend 2)
(bms-publish-value 1 'bms-soc 0.1)
(bms-publish-info 1 'cycles 99)
(expect (bms-mark-received 1) nil)
(expect bms-battery-cycles 42)
(expect (assoc writes 'bms-soc) 0.8)
(expect (bms-request-factory-init) nil)
(ow-cleanup)
(expect stops 0)
(expect ow-buf nil)
(expect ow-key nil)
(expect ow-counter nil)
(expect ow-magic nil)
(setq ow-uart-open t)
(ow-cleanup)
(expect stops 1)
(check t)
