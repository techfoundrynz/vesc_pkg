(def DBG-BMS 16)
(def now 10.0)
(def backend 1)
(def writes nil)
(def broadcasts 0)
(def stops 0)
(def incoming nil)
(def read-queue nil)
(def io nil)
(def sent-packets nil)
(def timeouts nil)
(def checkpoint 'initial)
(defun get-config (key) (match key (bms-enabled 1) (bms-backend backend) (bms-type 2) (bms-rs485-chip 1) (_ 0)))
(defun test-clock () now)
(defun test-age (stamp) (- now stamp))
(defun test-value (field value) (setq writes (acons field value writes)))
(defun test-indexed (field index value) (setq writes (acons field (list index value) writes)))
(defun test-broadcast () (setq broadcasts (+ broadcasts 1)))
(defun test-stop () (setq stops (+ stops 1)))
(defun test-read (buffer size a b rx-wait) {
    (setq timeouts (cons rx-wait timeouts))
    (if read-queue { (setq incoming (first read-queue)) (setq read-queue (rest read-queue)) })
    (bufcpy buffer 0 incoming 0 (buflen incoming)) (buflen incoming)
})
(defun test-write (packet) {
    (var bytes nil)
    (looprange k 5 (- (buflen packet) 2) (setq bytes (cons (bufget-u8 packet k) bytes)))
    (setq sent-packets (cons (reverse bytes) sent-packets))
    (setq io (cons 'write io))
    (expect (ow-checksum packet 0 (- (buflen packet) 2)) (bufget-u16 packet (- (buflen packet) 2)))
    (expect (bufget-u8 packet 3) 0)
    (expect (bufget-u8 packet 4) 1)
})
(defun test-gpio (pin value) (setq io (cons value io)))
(defun test-sleep (duration) (setq io (cons duration io)))
(defun test-crypt (key counter data start len) { (bufset-u8 counter 15 99) t })
(defun dbg-active (category) nil)
(defun dbg-tick (a b c) nil)
(defun expect (actual wanted)
    (if (not (eq actual wanted)) (exit-error (to-str (list checkpoint actual 'wanted wanted)))))
; Imports allocate no protocol buffers and cannot open hardware.
(expect ow-key nil)
(expect ow-counter nil)
(expect ow-magic nil)
(expect ow-buf nil)
(setq bms-active-backend 1)
(setq bms-worker-running t)
(setq bms-active-hooks (assoc bms-registry 1))
(expect (bms-connected) nil)
(setq ow-key (bufcreate 16))
(setq ow-counter (bufcreate 16))
(setq ow-magic [255 85 170])
(setq ow-buf (bufcreate 64))
(setq incoming [255 85 170 3 75 0 0 0 0 0])
(defun seal () (bufset-u16 incoming (- (buflen incoming) 2) (ow-checksum incoming 0 (- (buflen incoming) 2))))
(seal)
(ow-recv-packets -1 -1)
(expect (assoc writes 'bms-soc) 0.75)
(expect (bms-connected) t)
(expect bms-status -1)
(expect broadcasts 1)
; A bad checksum, unknown command or magic alone cannot refresh a connection.
(setq now 12.0)
(bufset-u8 incoming 4 76)
(ow-recv-packets -1 -1)
(expect (bms-connected) nil)
(expect broadcasts 1)
(bufset-u8 incoming 3 0x22)
(seal)
(ow-recv-packets -1 -1)
(expect bms-last-activity-time 10.0)
(setq incoming [255 85 170])
(ow-recv-packets -1 -1)
(expect bms-last-activity-time 10.0)
; Encrypted framing invokes crypto, restores the counter byte, then publishes.
(setq ow-use-crypto t)
(setq incoming [255 85 170 0 1 3 80 0 0 0 0 0])
(bufset-u8 ow-counter 15 7)
(seal)
(ow-recv-packets -1 -1)
(expect (bufget-u8 ow-counter 15) 7)
(expect (assoc writes 'bms-soc) 0.8)
(expect (bms-connected) t)
(expect (bms-capabilities) 7)
; Every parser must retain the plain/encrypted payload offsets and units.
(def fw-num 6.06)
(def ow-rs485-dere-pin 4)
(defun dbg (category message) nil)
(defun dbg-warn (message) nil)
(defun send-msg (message) nil)
(loopforeach crypto '(nil t) {
    (setq ow-use-crypto crypto)
    (var offset (if crypto 6 4))
    (var data (bufcreate (+ offset 8)))
    (bufset-u16 data offset 100)
    (bufset-u8 data (+ offset 2) 200)
    (expect (ow-process-cmd 0x0d data nil -1) true)
    (expect bms-battery-cycles 100)
    (expect (assoc writes 'bms-soh) 1.0)
    (bufset-u8 data (+ offset 2) 0)
    (expect (ow-process-cmd 0x0d data nil -1) true)
    (expect (assoc writes 'bms-soh) 0.01)
    (bufset-u8 data offset 0)
    (expect (ow-process-cmd 0x03 data nil -1) true)
    (expect (assoc writes 'bms-soc) 0.01)
    (bufset-u8 data offset 200)
    (expect (ow-process-cmd 0x03 data nil -1) true)
    (expect (assoc writes 'bms-soc) 1.0)
    (bufset-i16 data offset -100)
    (expect (ow-process-cmd 0x05 data nil -1) true)
    (expect (< (abs (- (assoc writes 'bms-i-in-ic) (if crypto -3.66 -5.5))) 0.0001) t)
    (bufset-u8 data offset 0x6f)
    (expect (ow-process-cmd 0x00 data nil -1) true)
    (expect ow-is-charging 1)
    (expect ow-is-battery-empty 1)
    (expect ow-is-battery-temp-out-of-range 1)
    (expect ow-is-battery-overcharged 1)
    (bufset-u16 data offset 1234)
    (expect (ow-process-cmd 0x06 data nil -1) true)
    (expect ow-serial 1234)
    (bufset-u8 data offset 10)
    (expect (ow-process-cmd 0x08 data nil -1) true)
    (expect bms-battery-type 10)
    (bufset-i16 data offset 1000)
    (expect (ow-process-cmd 0x05 data nil -1) true)
    (expect ow-is-current-over-limit 1)
    (setq ow-charge-only t)
    (expect (ow-process-cmd 0x05 data nil -1) true)
    (expect ow-is-current-over-limit 0)
    (setq ow-charge-only nil)
    ; Signed temperature bytes, maximum and indexed publication.
    (looprange k offset (- (buflen data) 2) (bufset-i8 data k -10))
    (bufset-i8 data (+ offset 1) 42)
    (expect (ow-process-cmd 0x04 data nil -1) true)
    (expect (assoc writes 'bms-temp-ic) -10)
    (expect (assoc writes 'bms-temp-cell-max) 42)
    (expect (assoc writes 'bms-temps-adc) (list 4 -10))
    ; Four samples plus the protocol's unused trailing cell word.
    (setq data (bufcreate (+ offset 12)))
    (looprange cell 0 5
        (bufset-u16 data (+ offset (* cell 2)) (* (if crypto 10000 1000) (+ 3.0 (* cell 0.1)))))
    (setq ow-cell-count-uninit t)
    (expect (ow-process-cmd 0x02 data nil -1) true)
    (expect (< (abs (- (assoc writes 'bms-v-tot) 12.6)) 0.002) t)
    (expect (< (abs (- (assoc writes 'bms-v-cell-min) 3.0)) 0.002) t)
    (expect (< (abs (- (assoc writes 'bms-v-cell-max) 3.3)) 0.002) t)
    (expect (first (assoc writes 'bms-v-cell)) 3)
    (expect ow-cell-count-uninit false)
})
; Charge writes keep the inversion, checksum, nonce and half-duplex ordering.
(setq ow-use-crypto t)
(setq ow-charge-state 0)
(setq incoming [255 85 170 0 1 0x15 1 0 0 0 0 0])
(seal)
(expect (ow-set-charge-state 0 1 1) true)
(expect sent-packets '((0x64 0)))
(expect io '(0.005 0 0.005 write 1))
(expect (first timeouts) 0.5)
; An unchanged state ACK is rejected, and missing ACKs time out.
(setq io nil)
(expect (ow-set-charge-state 0 1 0) false)
(expect (first sent-packets) '(0x64 1))
(setq incoming [255 85 170])
(expect (ow-set-charge-state 0 1 0) false)
; Factory reset performs both exchanges, with distinct handshake ACKs.
(setq checkpoint 'factory)
(setq incoming [255 85 170 0 1 0x0e 0 0 0 0 0 0])
(seal)
(def ack1 incoming)
(setq incoming [255 85 170 0 1 0x0e 0 1 0 0 0 0])
(seal)
(setq read-queue (list ack1 incoming))
(setq sent-packets nil)
(expect (ow-factory-init) true)
(expect sent-packets '((3 1) (5 0x52 0x4d 0x41)))
(expect (first timeouts) 1.0)
(expect (ix timeouts 1) 1.0)
; A failed second handshake must propagate failure through both exchanges.
(bufset-u16 incoming 6 2)
(seal)
(setq read-queue (list ack1 incoming))
(expect (ow-factory-init) false)
; An uninitialized charge state cannot transmit anything.
(setq ow-charge-state -1)
(setq io nil)
(expect (ow-set-charge-state 0 1 1) false)
(expect io nil)
(loopforeach command '(1 7 9 10 11 12 15 16 17 18 19 20 22 0x64)
    (expect (ow-process-cmd command incoming nil -1) false))
; Restore the shared-interface fixture after the parser/transport checks.
(setq checkpoint 'restore)
(setq bms-charge-state 0)
(setq incoming [255 85 170 0 1 3 80 0 0 0 0 0])
(seal)
(ow-recv-packets -1 -1)
(expect (bms-request-charge 1) t)
(expect ow-charge-target 1)
(expect ow-user-cmd 0x64)
(expect (bms-request-factory-init) t)
(expect ow-user-cmd 0x0e)
(expect (bms-pair '(1) '(2)) nil)
(bms-publish-info 1 'cycles 42)
(expect bms-battery-cycles 42)
(bms-publish-status 1 2 t nil t t)
(expect bms-status 102)
; A former backend cannot update shared data after selection changes.
(setq backend 2)
(bms-publish-value 1 'bms-soc 0.1)
(bms-publish-info 1 'cycles 99)
(expect (bms-mark-received 1) nil)
(expect bms-battery-cycles 42)
(expect (assoc writes 'bms-soc) 0.8)
(expect (bms-request-factory-init) nil)
(ow-cleanup)
(expect stops 0)
(expect ow-buf nil)
(expect ow-key nil)
(expect ow-counter nil)
(expect ow-magic nil)
(setq ow-uart-open t)
(ow-cleanup)
(expect stops 1)
(check t)
