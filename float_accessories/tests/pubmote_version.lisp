; Replay first-pairing packet loss against the actual packet handler.
(def sends nil)
(def activity 0)
(def saved 0)
(def settings '((pubmote-secret-code . 1234) (pubmote-remote-mac-a . 1)))
(defun expect (actual wanted)
    (if (not (eq actual wanted)) (exit-error (to-str (list actual 'wanted wanted)))))
(defun pubmote-reset-last-activity-time () (setq activity (+ activity 1)))
(defun pubmote-send-packet (mac data ble) {
    (var copy (bufcreate (buflen data)))
    (bufcpy copy 0 data 0 (buflen data))
    (setq sends (cons (list mac copy ble) sends))
})
(defun pubmote-init () t)
(defun systime () 0)
(defun cfg-get (key) (assoc settings key))
(defun cfg-set (key value) (setassoc settings key value))
(defun cfg-save () (setq saved (+ saved 1)))
(pubmote-setup (list (cons 'get-config cfg-get) (cons 'set-config cfg-set)
                    (cons 'save-config cfg-save)))
(setq pubmote-remote-mac '(1 2 3 4 5 6))
(def version-request [5 0 0 4 210])
(def version-packet [0 0 0 4 210 1 2 3])
; Version announcement lost; its separate API-version request still arrives.
(pubmote-process-packet version-request nil)
(expect sends nil)
(expect pubmote-version-received nil)
(expect activity 1)
; A malformed announcement must not complete the exchange either.
(pubmote-process-packet [0 0] nil)
(pubmote-process-packet version-request nil)
(expect sends nil)
; The remote retries its announcement and request; now acknowledge normally.
(pubmote-process-packet version-packet nil)
(expect pubmote-version '(1 2 3))
(expect pubmote-version-received t)
(pubmote-process-packet version-request nil)
(expect (length sends) 1)
(expect (ix (ix sends 0) 0) pubmote-remote-mac)
(expect (bufget-u8 (ix (ix sends 0) 1) 0) PUBMOTE_CMD_VERSION_REC)
; BLE uses the same exchange but sends its response without an ESP-NOW MAC.
(pubmote-process-packet version-request t)
(expect (ix (ix sends 0) 0) nil)
(expect (ix (ix sends 0) 2) t)
; Starting another pairing must not reuse the old remote's version.
(pubmote-pair 1234)
(expect pubmote-version-received nil)
(expect pubmote-version '(0 0 0))
(pubmote-process-packet version-request nil)
(expect (length sends) 2)
(pubmote-process-packet version-packet nil)
(pubmote-pair -2)
(expect pubmote-version-received nil)
(expect pubmote-version '(0 0 0))
(check t)
