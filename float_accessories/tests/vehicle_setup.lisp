; Mock hardware and configuration, retaining real setup/init, command routing,
; provider lifecycle, normalized snapshots and LED state decisions.
(def test-ok t)
(def test-now 10.0)
(def test-provider 0)
(def test-bms-enabled 0)
(def test-bms-backend 0)
(def test-can-id 66)
(def test-sends 0)
(def test-controls 0)
(def test-autoreply nil)
(def test-lights-started nil)
(def test-pubmote-hooks nil)
(def test-threads nil)
(def test-can-stop nil)
(def test-bms-soc 0.75)
(def dbg-prev-fault 0)
(def dbg-mask 0)
(def DBG-CORE 1)
(def DBG-CFG 2)
(def DBG-CMD 512)
(def DBG-CAN 4)
(def DBG-LED 8)
(def boot-t-main 0)
(def boot-t-libs 0)
(def boot-t-led 0)
(def pkg-version '(4 1 2))
(defun print (msg) nil)
(defun test-clock () test-now)
(defun test-age (stamp) (- test-now stamp))
(defun test-yield (us) (if test-can-stop (test-can-stop t)))
(defun dbg (cat msg) nil)
(defun dbg-active (cat) nil)
(defun dbg-tick (cat key interval) nil)
(defun dbg-warn (msg) (print msg))
(defun dbg-err (msg) (print msg))
(defun dbg-loop () nil)
(defun test-event (event) t)
(defun load-native-libs () t)
(defun spawn-with-restart (name stack f) {
    (setq test-threads (cons name test-threads))
    123
})
(defun spawn-event-handler-with-restart () t)
(defun led-start () (setq test-lights-started t))
(defun pubmote-setup (hooks) (setq test-pubmote-hooks hooks))
(defun test-sysinfo (key)
    (cond ((eq key 'fw-ver) '(7 0)) ((eq key 'hw-target) "esp32c3")
          ((eq key 'hw-type) "hw-express") (t 0)))
(defun get-config (key)
    (cond ((eq key 'integration) test-provider)
          ((eq key 'bms-enabled) test-bms-enabled)
          ((eq key 'bms-backend) test-bms-backend)
          ((eq key 'can-id) test-can-id)
          ((eq key 'led-enabled) 1)
          ((eq key 'led-on) 1)
          ((eq key 'led-brightness) 0.4)
          ((eq key 'led-brightness-highbeam) 0.6)
          ((eq key 'led-brightness-idle) 0.2)
          ((eq key 'led-brightness-status) 0.1)
          ((eq key 'can-loop-delay) 30)
          (t 0)))
(defun set-config (key value) (if (eq key 'can-id) (setq test-can-id value)))
(defun test-store () t)
(defun test-send (data mode id) {
    (setq test-sends (+ test-sends 1))
    (if (and test-autoreply (eq data '(101 10 3)))
        (integration-receive test-telem))
})
(defun test-can-cmd (id code) (setq test-controls (+ test-controls 1)))
(defun get-bms-val (key) (if (eq key 'bms-soc) test-bms-soc -1))
(defun expect (actual wanted) {
    (if (not (eq actual wanted)) {
        (exit-error (to-str (list 'unexpected actual 'wanted wanted)))
    })
})
(defun near (actual wanted) {
    (if (> (abs (- actual wanted)) 0.0001) {
        (exit-error (to-str (list 'unexpected actual 'wanted wanted)))
    })
})
