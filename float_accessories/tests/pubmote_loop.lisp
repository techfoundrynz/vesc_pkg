; Characterization of pubmote-loop phases, iteration by iteration, with radio,
; channel and pairing helpers faked. Loaded after the real pubmote module.
(def now 100.0)
(def sends nil)
(def pair-calls nil)
(def iterations 0)
(def stop-after 1)
(def loop-delay 30)
(def ble-up t)
(def send-ok nil)
(def warnings nil)
(defun test-clock () now)
(defun test-age (stamp) (- now stamp))
(defun test-yield (us) (setq now (+ now (/ us 1000000.0))))
(defun expect (actual wanted)
    (if (not (eq actual wanted)) (exit-error (to-str (list actual 'wanted wanted)))))
(defun copy (buf) { (var c (bufcreate (buflen buf))) (bufcpy c 0 buf 0 (buflen buf)) c })

(defun pubmote-init () t)
(defun pubmote-get-cfg (key)
    (match key (pubmote-loop-delay loop-delay) (pubmote-enabled 1) (pubmote-secret-code 0x11223344) (_ 0)))
(defun pubmote-log-transitions () {
    (setq iterations (+ iterations 1))
    (if (> iterations stop-after) (setq pubmote-exit-flag t))
})
(defun pubmote-should-unlock-channel (time) nil)
(defun pubmote-should-lock-channel () nil)
(defun pubmote-should-send-message () send-ok)
(defun pubmote-send-packet (mac buf is-ble) (setq sends (append sends (list (list mac (copy buf) is-ble)))))
(defun pubmote-pair (code) (setq pair-calls (cons code pair-calls)))
(defun pubmote-warn (text) (setq warnings (cons text warnings)))
(defun pubmote-log (level text) nil)
(defun pubmote-log-tick (key secs) nil)
(defun connected-ble () ble-up)
(defun get-mac-addr () '(1 2 3 4 5 6))
(defun wifi-get-chan () 6)
(setq pubmote-get-telemetry nil)

(defun run (n) {
    (setq iterations 0)
    (setq stop-after n)
    (setq sends nil)
    (setq pubmote-exit-flag nil)
    (pubmote-loop)
})

; Pair complete: each retry goes out on ESP-NOW and BLE; once the last one is
; sent, a failed pairing (status 0) with nothing new pending wipes the MAC.
(setq pubmote-pairing-state PUBMOTE_PAIR_IDLE)
(setq pubmote-remote-mac '(9 9 9 9 9 9))
(setq pubmote-send-pair-complete-retries 2)
(setq pubmote-pair-complete-status 0)
(run 3)
(expect (length sends) 4)
(expect (ix sends 0) (list '(9 9 9 9 9 9) [12 0] nil))
(expect (ix sends 1) (list nil [12 0] t))
(expect pubmote-send-pair-complete-retries 0)
(expect pubmote-remote-mac nil)
(expect pubmote-exit-flag nil)
; A successful pairing keeps the MAC; no BLE copy without a BLE link.
(setq pubmote-remote-mac '(9 9 9 9 9 9))
(setq pubmote-send-pair-complete-retries 1)
(setq pubmote-pair-complete-status 1)
(setq ble-up nil)
(run 1)
(expect sends (list (list '(9 9 9 9 9 9) [12 1] nil)))
(expect pubmote-remote-mac '(9 9 9 9 9 9))
(setq ble-up t)

; Pairing broadcast: our MAC and WiFi channel, to everyone and over BLE, at
; most every 50 ms of systime; activity stays fresh while pairing.
(setq pubmote-pairing-state PUBMOTE_PAIR_INITIATED)
(setq pubmote-pairing-timer now)
(setq pubmote-last-pairing-broadcast 0)
(setq pubmote-wifi-enabled t)
(run 1)
(expect (length sends) 2)
(expect (ix sends 0) (list pubmote-uni-mac [10 1 2 3 4 5 6 6] nil))
(expect (ix sends 1) (list nil [10 1 2 3 4 5 6 6] t))
(expect pubmote-last-activity-time now)
(setq pubmote-wifi-enabled nil)
(setq pubmote-last-pairing-broadcast 0)
(run 1)
(expect (ix sends 0) (list pubmote-uni-mac [10 1 2 3 4 5 6 0] nil))
; Expired pairing aborts.
(setq pubmote-pairing-timer (- now 61))
(run 1)
(expect pair-calls '(-2))
(setq pubmote-pairing-state PUBMOTE_PAIR_BONDING)
(setq pubmote-last-activity-time 0)
(run 1)
(expect pubmote-last-activity-time now)
(expect sends nil)

; Connected: telemetry to the paired MAC, or over BLE for a BLE pairing.
(setq pubmote-pairing-state PUBMOTE_PAIR_IDLE)
(setq send-ok t)
(setq pubmote-ble-paired nil)
(run 1)
(expect (length sends) 1)
(expect (ix (ix sends 0) 0) '(9 9 9 9 9 9))
(expect (buflen (ix (ix sends 0) 1)) 34)
(expect (bufget-u8 (ix (ix sends 0) 1) 0) PUBMOTE_CMD_SET_CORE_DATA)
(expect (bufget-i32 (ix (ix sends 0) 1) 1) 0x11223344)
(setq pubmote-ble-paired t)
(run 1)
(expect (ix (ix sends 0) 2) t)
(setq ble-up nil)
(run 1)
(expect sends nil)

; A rate below 1 Hz falls back to 30 Hz with a warning.
(setq loop-delay 0)
(run 1)
(expect pubmote-loop-delay 30)
(expect (car warnings) "rem bad rate, using 30Hz")
(check t)
