(defun expect (actual wanted)
    (if (not (eq actual wanted)) (exit-error (to-str (list actual 'wanted wanted)))))
(def calls nil)
(def values nil)
(def fresh t)
(def connecting nil)
(def battery-fresh t)
(def bms-is-charging nil)
(def bms-charger-just-plugged nil)
(def battery-percent-remaining 0.5)
(def state 1)
(def handtest-mode nil)
(defun vehicle-fresh () fresh)
(defun integration-connecting () connecting)
(defun battery-data-fresh () battery-fresh)
(defun running-state () nil)
(defun test-look (s fx pal color spd bri cyc)
    (setq calls (cons (list s fx pal color spd bri cyc) calls)))
(defun test-value (s val) (setq values (cons (list s val) values)))
(setq seg-front 0)
(setq seg-rear 1)
(setq led-front-type TYPE-RGBW)
(setq led-rear-type TYPE-GRBW)
(setq led-front-white-output 1)
(setq led-rear-white-output 2)
(setq head-bri 17)
(setq tail-bri 83)
; Expected effect, palette, head/tail colors, speed, cycle and value by mode.
; Numeric expectations deliberately fix the existing wire/API contract.
(def expected '(
    (2 0 0xFFFFFFFFu32 0x00FF0000u32 32 0 0)
    (8 0 0 0 0 0 127)
    (2 0 0x0000FFFFu32 0x00FF00FFu32 32 0 0)
    (2 0 0x000000FFu32 0x0000FF00u32 32 0 0)
    (2 0 0x00FFFF00u32 0x0000FF00u32 32 0 0)
    (5 1 0 0 0 4224 0)
    (9 0 0xFFFFFFFFu32 0xFFFFFFFFu32 0 211 0)
    (5 4 0 0 0 614 0)
    (2 0 0xFFFFFFFFu32 0 32 0 0)
    (10 0 0x00FF0000u32 0x00FF0000u32 0 1000 0)
    (11 0 0 0 0 792 0)
    (5 1 0 0 0 16896 0)))
(looprange reversed 0 2 {
    (setq head-seg reversed)
    (setq tail-seg (- 1 reversed))
    (loopforeach charging '(nil t) {
        (setq bms-is-charging charging)
        (looprange mode -1 14 {
            (seg-cache-reset)
            (setq calls nil)
            (setq values nil)
            (apply-drive-mode mode)
            (seg-flush)
            (expect (length calls) 2)
            (var e (ix expected (if (and (>= mode 0) (< mode 12)) mode 0)))
            (looprange side 0 2 {
                (var s (if (= side 0) head-seg tail-seg))
                (var c (ix e (+ side 2)))
                (if (= c 0xFFFFFFFFu32) (setq c (if (= s 0) 0xFF000000u32 0x00FFFFFFu32)))
                (var want (list s (ix e 0) (ix e 1) c (ix e 4)
                    (if (= side 0) head-bri tail-bri) (ix e 5)))
                ; Directional rave uses the rave tail while its head stays solid.
                (if (and (= mode 8) (= side 1))
                    (setq want (list s FX-RAINBOW PAL-NEON 0 0 tail-bri 614)))
                (if (and (= mode 1) charging)
                    (setq want (list s FX-GAUGE 0 0 32 (if (= side 0) head-bri tail-bri) 0)))
                (expect (ix calls (- 1 s)) want)
                (expect (ix values (- 1 s)) (list s (ix e 6)))
            })
            (apply-drive-mode mode)
            (seg-flush)
            (expect (length calls) 2)
        })
    })
})
; Each appearance field participates in the cache, including gauge value/cycle.
(seg-cache-reset)
(setq calls nil)
(looprange field 0 7 {
    (seg-want 0 (if (= field 0) 2 1) (if (= field 1) 1 0)
        (if (= field 2) 0x123456u32 0) (if (= field 3) 40 32)
        (if (= field 4) 18 17) (if (= field 5) 99 0) (if (= field 6) 1000 0))
    (seg-flush)
    (expect (length calls) (+ field 1))
})
; Last intent wins; unclaimed/disabled segments cause no hardware calls.
(setq calls nil)
(seg-want-off -1)
(seg-want-fx 0 FX-SOLID 0 123 32 17)
(seg-want-off 0)
(seg-flush)
(expect calls (list (list 0 FX-OFF 0 0u32 32 0 0)))
(seg-flush)
(expect (length calls) 1)
; Draw precedence: charging > connecting > disabled > handtest > shutoff > mode.
(setq head-seg 0)
(setq tail-seg 1)
(setq current-led-mode 2)
(setq braking nil)
(setq lights-off t)
(setq handtest-mode t)
(setq state 15)
(setq connecting t)
(setq led-startup-active nil)
(setq bms-charger-just-plugged t)
(led-draw-drive)
(expect (bufget-u8 seg-want-look 0) FX-GAUGE)
(setq bms-charger-just-plugged nil)
(setq bms-is-charging nil)
(led-draw-drive)
(expect (bufget-u8 seg-want-look 0) FX-BREATHE)
(setq connecting nil)
(led-draw-drive)
(expect (bufget-u32 seg-want-col 0) 0x00FF0000u32)
(setq state 1)
(led-draw-drive)
(expect (bufget-u8 seg-want-look 0) FX-BREATHE)
(setq handtest-mode nil)
(led-draw-drive)
(expect (bufget-u8 seg-want-look 0) FX-OFF)
(setq lights-off nil)
(setq braking t)
(led-draw-drive)
(expect (bufget-u32 seg-want-col 0) 0x0000FFFFu32)
(expect (bufget-u8 seg-want-look 8) FX-STROBE)
(expect (bufget-u16 seg-want-look 14) 176)
(check t)
