(def test-ok t)
(def test-now 10.0)
(def sent nil)
(def can-last-activity-time 9.9)
(def led-last-activity-time 9.9)
(def led-on 1)
(def led-highbeam-on 0)
(def vehicle-valid t)
(integration-select 1)
(setq integration-start-pending nil)
(setq refloat-generation integration-generation)
(setq vehicle-valid t)
(def led-brightness 0.8)
(def led-brightness-idle 0.4)
(def led-brightness-status 0.3)
(def led-brightness-highbeam 0.9)
(defun test-clock () test-now)
(defun test-age (stamp) (- test-now stamp))
(defun test-send (data mode id) (setq sent (list data mode id)))
(defun min (a b) (if (< a b) a b))
(defun max (a b) (if (> a b) a b))
(defun expect (actual wanted) {
    (if (not (eq actual wanted)) {
        (print (list 'unexpected actual 'wanted wanted))
        (setq test-ok nil)
    })
})
(defun near (actual wanted) {
    (if (> (abs (- actual wanted)) 0.0001) {
        (print (list 'unexpected actual 'wanted wanted))
        (setq test-ok nil)
    })
})
(def packet (bufcreate 14))
(bufset-u8 packet 0 101)
(bufset-u8 packet 1 24)
(bufset-u8 packet 11 60)
(bufset-u8 packet 12 20)
(bufset-u8 packet 13 10)
(setq can-id 66)
(setq can-last-activity-time 9.9)
(setq state 1)
(setq led-max-brightness 0.5)
(setq led-mode 0)
(setq led-mode-idle 0)
(setq idle-timeout 1)
(setq idle-timeout-shutoff 600)
(setq led-brake-light-enabled 0)
(setq led-front-highbeam-mode 1)
(setq led-rear-highbeam-mode 0)

; The adapter polls automatically, but uses local targets until a valid reply.
(poll-refloat-brightness)
(expect sent '((101 24) 2 66))
(expect (lighting-override-active) nil)
(led-decide)
(near led-current-brightness 0.5)

(setq sent nil)
(poll-refloat-brightness)
(expect sent nil)
(setq test-now 10.11)
(poll-refloat-brightness)
(expect sent '((101 24) 2 66))
; Existing telemetry freshness must not be refreshed by an LCM reply.
(refloat-rx packet)
(near can-last-activity-time 9.9)
(expect (lighting-override-active) t)
(led-decide)
(near led-current-brightness 0.5)
(near hb-frac 0.5)
(expect status-bri 25)
(setq led-max-brightness 1.0)
(led-decide)
(near led-current-brightness 0.6)
(near hb-frac 0.6)
(expect hb-front nil)
(setq led-highbeam-on 1)
(led-decide)
(expect hb-front t)
(setq led-highbeam-on 0)
(setq led-mall-grab 1)
(led-decide)
(near led-current-brightness 0.1)
(setq led-mall-grab 0)
(setq led-last-activity-time 8.0)
(led-decide)
(near led-current-brightness 0.2)
(setq led-last-activity-time 9.9)
(setq state 5)
(led-decide)
(near led-current-brightness 0.2)
(setq state 1)

; Refloat can explicitly turn everything off with valid zero brightness.
(bufset-u8 packet 11 0)
(bufset-u8 packet 12 0)
(bufset-u8 packet 13 0)
(refloat-rx packet)
(led-decide)
(near led-current-brightness 0.0)
(expect status-bri 0)
(near hb-frac 0.0)

; Disabled external LCM yields only the header, immediately restoring local.
(def disabled (bufcreate 2))
(bufset-u8 disabled 0 101)
(bufset-u8 disabled 1 24)
(refloat-rx disabled)
(expect (lighting-override-active) nil)
(led-decide)
(near led-current-brightness 0.8)
(near hb-frac 0.9)
; Reject every truncated length, and invalid values in each brightness slot.
(looprange n 2 14 {
    (lighting-override 1 0.0 0.0 0.0)
    (refloat-brightness-rx (bufcreate n))
    (expect (lighting-override-active) nil)
})
(looprange offset 11 14 {
    (bufset-u8 packet offset 101)
    (refloat-brightness-rx packet)
    (expect (lighting-override-active) nil)
    (bufset-u8 packet offset 0)
})
(refloat-brightness-rx packet)
(setq test-now 11.11)
(expect (lighting-override-active) nil)
(led-decide)
(near led-current-brightness 0.8)
(setq test-now 10.2)
(refloat-brightness-rx packet)
; Optional extension payload does not change the fixed brightness offsets.
(def extended (bufcreate 18))
(bufcpy extended 0 packet 0 14)
(refloat-brightness-rx extended)
(expect (lighting-override-active) t)
(integration-select 0)
(expect (lighting-override-active) nil)
(integration-select 1)
(setq integration-start-pending nil)
(setq refloat-generation integration-generation)
(setq can-id 66)
(refloat-brightness-rx packet)
(setq can-id 66)
(setq sim-active t)
(expect (lighting-override-active) nil)
(setq sim-active nil)
(integration-select 0)
(setq sent nil)
(poll-refloat-brightness)
(expect sent nil)
(expect (lighting-override-active) nil)
; Local config values survive all remote updates.
(near led-brightness 0.8)
(near led-brightness-idle 0.4)
(near led-brightness-status 0.3)
(near led-brightness-highbeam 0.9)
(check test-ok)
