; Construct a real mode-3 reply, including the highest accessed byte (53).
(def test-telem (bufcreate 54))
(bufset-u8 test-telem 0 101)
(bufset-u8 test-telem 1 10)
(bufset-u8 test-telem 2 3)
(bufset-i16 test-telem 7 123)
(bufset-u8 test-telem 9 0x31)
(bufset-u8 test-telem 10 2)
(bufset-u8 test-telem 11 150)
(bufset-u8 test-telem 12 125)
(bufset-i16 test-telem 19 -45)
(bufset-i16 test-telem 22 720)
(bufset-i16 test-telem 24 15000)
(bufset-i16 test-telem 26 250)
(bufset-i16 test-telem 28 -120)
(bufset-i16 test-telem 30 -35)
(bufset-u8 test-telem 32 178)
(bufset-f32 test-telem 34 1234.0)
(bufset-u8 test-telem 38 80)
(bufset-u8 test-telem 39 90)
(bufset-u32 test-telem 41 12345)
(bufset-u8 test-telem 53 150)
(setq test-provider 1)
(setup)
(init)
; Before discovery succeeds, both drive strips and the status strip connect.
(expect (integration-connection-state) 1)
(expect (integration-connecting) t)
(setq led-mode 5)
(setq led-mode-idle 5)
(setq led-max-brightness 0.4)
(setq idle-timeout 1)
(setq idle-timeout-shutoff 600)
(setq led-front-highbeam-mode 0)
(setq led-rear-highbeam-mode 0)
(setq led-brake-light-enabled 0)
(setq seg-front 0)
(setq seg-rear 1)
(setq seg-status 2)
(setq led-front-type TYPE-GRB)
(setq led-rear-type TYPE-GRB)
; Startup has priority over connecting on the drive strips until it expires.
(setq led-mode-startup 3)
(expect LED-STARTUP-SECONDS 3)
(setq test-now 1.0)
(led-decide)
(expect led-startup-active t)
(led-draw-drive)
(expect (bufget-u8 seg-want-look 0) FX-SOLID)
(near (bufget-u32 seg-want-col 0) 255)
(near (bufget-u32 seg-want-col 4) 65280)
(setq test-now 3.0)
(led-decide)
(expect led-startup-active nil)
(led-draw-drive)
(expect (bufget-u8 seg-want-look 0) FX-BREATHE)
(setq test-now 10.0)
(led-decide)
(led-draw-drive)
(led-draw-status)
(looprange segment 0 3 {
    (expect (bufget-u8 seg-want-look (* segment 8)) FX-BREATHE)
    (near (bufget-u32 seg-want-col (* segment 4)) 255)
})
(setq test-autoreply t)
(integration-step)
(expect (integration-connection-state) 2)
(expect (integration-connecting) nil)
(led-decide)
(led-draw-drive)
(expect (bufget-u8 seg-want-look 0) FX-RAINBOW)
(expect integration-id 1)
(expect can-id 66)
(expect (vehicle-fresh) t)
(expect (running-state) t)
(expect state 1)
(expect sat-t 3)
(expect switch-state 3)
(near footpad-adc1-t 3.0)
(near footpad-adc2-t 2.5)
(near roll-angle 12.3)
(near pitch-angle -4.5)
(near vin 72.0)
(near rpm 1500.0)
(near speed 25.0)
(near tot-current -12.0)
(near bat-current -3.5)
(near duty-cycle-now 0.5)
(near battery-percent-remaining 0.75)
(near distance-abs 1234.0)
(near odometer 12345)
(integration-control 0.5 0 0 0 nil)
(expect test-controls 1)

; Unknown/short packets and humidity replies cannot refresh vehicle state.
(setq test-autoreply nil)
(setq test-now 10.5)
(looprange n 2 54 {
    (var short (bufcreate n))
    (bufcpy short 0 test-telem 0 n)
    (integration-receive short)
})
(near can-last-activity-time 10.0)
(def humidity (bufcreate 2))
(bufset-u8 humidity 0 101)
(bufset-u8 humidity 1 51)
(integration-receive humidity)
(near can-last-activity-time 10.0)
; Link loss clears old riding/footpad data and blocks remote forwarding.
(setq test-now 11.1)
(integration-step)
(expect (vehicle-fresh) nil)
(expect (integration-connection-state) 3)
(expect (integration-connecting) t)
(led-decide)
(led-draw-drive)
(expect (bufget-u8 seg-want-look 0) FX-BREATHE)
(expect (running-state) nil)
(expect switch-state 0)
(near rpm 0)
(integration-control 0.5 0 0 0 nil)
(expect test-controls 1)
(integration-receive test-telem)
(expect (vehicle-fresh) t)
(expect (integration-connection-state) 2)

; Older telemetry formats remain supported, including single-pad direction.
(bufset-u8 test-telem 2 1)
(bufset-u8 test-telem 10 1)
(bufset-u8 test-telem 11 100)
(bufset-u8 test-telem 12 150)
(integration-receive test-telem)
(expect switch-state 2)
(near distance-abs -1)
(bufset-u8 test-telem 2 2)
(integration-receive test-telem)
(near distance-abs 1234.0)
(bufset-u8 test-telem 2 3)
; A requested voltage curve with unknown cell count must not divide by -1/0.
(setq soc-type 1)
(setq series-cells -1)
(integration-receive test-telem)
(expect (number? battery-percent-remaining) t)
(setq soc-type 0)

; Disable releases brightness and stops polling, discovery and control sends.
(lighting-override 1 0.1 0.2 0.3)
(integration-select 0)
(expect (integration-connection-state) 0)
(expect (lighting-override-active) nil)
(expect can-id -1)
(expect vehicle-valid nil)
(def before test-sends)
(integration-step)
(integration-control 0.5 0 0 0 nil)
(integration-receive test-telem)
(expect test-sends before)
(expect test-controls 1)
(expect can-id -1)
; Direct calls from an old discovery context are cancelled too.
(expect (refloat-try-can-devices '(66)) nil)
(expect test-sends before)
(integration-select 1)
(expect (integration-connection-state) 1)
(expect (refloat-active) nil)
(setq test-autoreply t)
(integration-step)
(expect (vehicle-fresh) t)
(expect (refloat-active) t)
(check test-ok)
