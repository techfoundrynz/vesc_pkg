; Characterization of LED segment setup, the flush cache and PWM highbeams,
; recording every lib call. Loaded after the real LED module by test_led.py.
(def calls nil)
(defun log-call (c) (setq calls (append calls (list c))))
(defun test-led-deinit () (log-call '(deinit)))
(defun test-led-seg-def (i pin typ num off tim) (log-call (list 'def i pin typ num off tim)))
(defun test-led-seg-overlay-def () (log-call (cons 'ovdef (rest-args))))
(defun test-led-init (n) (log-call (list 'init n)))
(defun test-led-fps (n) (log-call (list 'fps n)))
(defun test-led-seg-color-fade (s r) (log-call (list 'fade s r)))
(defun test-led-seg-reverse (s r) (log-call (list 'rev s r)))
(defun test-led-seg-look (s fx pal col spd bri cyc) (log-call (list 'look s fx pal col spd bri cyc)))
(defun test-led-seg-fx-val (s v) (log-call (list 'val s v)))
(defun test-led-seg-overlay (s c b) (log-call (list 'ov s c b)))
(defun pwm-start (f d ch pin res) (log-call (list 'pwm ch pin)))
(defun pwm-set-duty (d ch) (log-call (list 'duty ch d)))
(defun pwm-stop (ch) (log-call (list 'pwmstop ch)))
(defun dbg-warn (text) nil)
(defun dbg-err (text) (log-call (list 'err text)))
(defun expect (actual wanted)
    (if (not (eq actual wanted)) (exit-error (to-str (list actual 'wanted wanted)))))

; Status alone on pin 5; front, rear and the button chained on pin 6. The rear's
; own timing loses to the chain's first strip; the button adopts the chain's
; colour order. Front embedded highbeam at 3 and 9; 20 is past the footprint.
(setq led-status-pin 5) (setq led-status-num 10) (setq led-status-type TYPE-GRB)
(setq led-status-timing 1) (setq led-status-reversed 0)
(setq led-front-pin 6) (setq led-front-num 8) (setq led-front-type TYPE-GRBW)
(setq led-front-timing 2) (setq led-front-reversed 1)
(setq led-front-highbeam-mode 2)
(setq led-front-highbeam-pos (+ 3 (shl 9 8) (shl 20 16) (shl 0xFF 24)))
(setq led-rear-pin 6) (setq led-rear-num 12) (setq led-rear-type TYPE-GRBW)
(setq led-rear-timing 3) (setq led-rear-reversed 0)
(setq led-rear-highbeam-mode 1) (setq led-rear-highbeam-pin 7)
(setq led-footpad-timing 0) (setq led-footpad-pin 8) (setq led-footpad-num 4)
(setq led-button-pin 6) (setq led-button-timing 1)

(expect (led-setup-segments) t)
(expect (list seg-status seg-front seg-rear seg-footpad seg-button) '(0 1 2 -1 3))
(expect calls '((deinit)
    (def 0 5 0 10 0 0)
    (def 1 6 2 8 0 1) (ovdef 1 3 9)
    (def 2 6 2 12 10 1)
    (def 3 6 2 1 22 1)
    (init 4) (fps 60) (fade 1 10) (fade 2 10)
    (rev 0 0) (rev 1 1) (rev 2 0)
    (pwm 1 7)))
(expect (hb-positions (+ 1 (shl 2 8) (shl 0xFF 16) (shl 0xFF 24)) 4) '(1 2))
(expect (hb-positions -1 4) nil)

; Flush: push on change only; look and fx-val go out together.
(setq calls nil)
(seg-want-fx seg-front FX-SOLID 0 0x00FF0000u32 32 100)
(seg-flush)
(expect calls (list (list 'look 1 FX-SOLID 0 0x00FF0000u32 32 100 0) '(val 1 0)))
(setq calls nil)
(seg-want-fx seg-front FX-SOLID 0 0x00FF0000u32 32 100)
(seg-flush)
(expect calls nil)
(seg-want seg-front FX-SOLID 0 0x00FF0000u32 32 100 0 500)
(seg-flush)
(expect calls (list (list 'look 1 FX-SOLID 0 0x00FF0000u32 32 100 500) '(val 1 0)))
(setq calls nil)
(seg-want seg-front FX-SOLID 0 0x00FF0000u32 32 100 7 500)
(seg-flush)
(expect calls (list (list 'look 1 FX-SOLID 0 0x00FF0000u32 32 100 500) '(val 1 7)))
(setq calls nil)
(seg-want seg-front FX-SOLID 0 0x0000FF00u32 32 100 7 500)
(seg-flush)
(expect (length calls) 2)
(setq calls nil)
(seg-flush)
(expect calls nil)
(seg-cache-reset)
(seg-want seg-front FX-SOLID 0 0x0000FF00u32 32 100 7 500)
(seg-flush)
(expect (length calls) 2)

; PWM highbeam duty is written only when it changes.
(setq calls nil)
(setq hb-front nil) (setq hb-rear t) (setq hb-frac 0.5)
(led-draw-highbeam-pwm)
(expect calls '((duty 1 0.5)))
(led-draw-highbeam-pwm)
(expect (length calls) 1)
(setq hb-rear nil)
(led-draw-highbeam-pwm)
(expect (ix calls 1) '(duty 1 0.0))
(led-teardown)
(expect (ix calls 2) '(deinit))
(expect (ix calls 3) '(pwmstop 1))
(check t)
