; Characterization of the OW adapter's parsers, send paths, key storage and
; init validation, written against the implementation before refactoring.
(def DBG-BMS 16)
(def now 10.0)
(def fw-num 6.1)
(def writes nil)
(def incoming nil)
(def uart-out nil)
(def gpio-out nil)
(def starts nil)
(def msgs nil)
(def warnings nil)
(def stores 0)
(def config '((bms-enabled . 1) (bms-backend . 1) (bms-type . 1)))
(defun get-config (key) (or (assoc config key) 0))
(defun set-config (key value) (setq config (acons key value config)))
(defun save-config () (setq stores (+ stores 1)))
(defun test-clock () now)
(defun test-age (stamp) (- now stamp))
(defun test-value (field value) (setq writes (acons field value writes)))
(defun test-indexed (field index value) (setq writes (acons field (list index value) writes)))
(defun get-bms-val (field) (or (assoc writes field) 0))
(defun test-broadcast () t)
(defun test-stop () t)
(defun test-read (buffer size a b timeout) { (bufcpy buffer 0 incoming 0 (buflen incoming)) (buflen incoming) })
(defun test-crypt (key counter data start len) t)
(defun test-write (data) {
    (var copy (bufcreate (buflen data)))
    (bufcpy copy 0 data 0 (buflen data))
    (setq uart-out (append uart-out (list copy)))
})
(defun test-gpio (pin value) (setq gpio-out (append gpio-out (list (list pin value)))))
(defun test-sleep (seconds) (setq now (+ now seconds)))
(defun test-yield (us) t)
(defun test-start () (setq starts (rest-args)))
(defun test-configure (pin mode) (if (< pin 0) (car 1) t))
(def crc-ok nil)
(defun test-crc32 (buf init) (if crc-ok (if (eq buf ow-key) 3141361152u32 4092889840u32) 123))
(defun dbg-active (category) nil)
(defun dbg-tick (a b c) nil)
(defun dbg (category text) nil)
(defun dbg-err (text) (setq warnings (cons text warnings)))
(defun dbg-warn (text) (setq warnings (cons text warnings)))
(defun send-msg (text) (setq msgs (cons text msgs)))
(defun expect (actual wanted)
    (if (not (eq actual wanted)) (exit-error (to-str (list actual 'wanted wanted)))))
(defun near (actual wanted)
    (if (> (abs (- actual wanted)) 0.001) (exit-error (to-str (list actual 'near wanted)))))

(setq bms-active-backend 1)
(setq bms-worker-running t)
(setq bms-active-hooks (assoc bms-registry 1))
(setq ow-key (bufcreate 16))
(setq ow-counter (bufcreate 16))
(setq ow-buf (bufcreate 128))

; Framed packet: magic, (nonce,) command, data, big-endian checksum.
(defun packet (cmd data) {
    (var head (if ow-use-crypto 6 4))
    (var out (bufcreate (+ head (buflen data) 2)))
    (bufcpy out 0 ow-magic 0 3)
    (bufset-u8 out (- head 1) cmd)
    (bufcpy out head data 0 (buflen data))
    (bufset-u16 out (- (buflen out) 2) (ow-checksum out 0 (- (buflen out) 2)))
    out
})
(defun feed (cmd data) {
    (setq incoming (packet cmd data))
    (ow-recv-packets -1 -1)
})

; ---- Plain parsers -----------------------------------------------------------
(setq ow-use-crypto nil)
(setq ow-magic [255 85 170])
(setq ow-override-soc 0)
(setq ow-charge-only 0)
(feed 0x02 [0x10 0x04 0x0f 0xa0 0x0f 0x3c 0x10 0x68 0 0])
(expect (assoc writes 'bms-cell-num) 4)
(expect (assoc writes 'bms-v-cell) '(3 4.2))
(near (assoc writes 'bms-v-tot) 16.2)
(near (assoc writes 'bms-v-cell-min) 3.9)
(near (assoc writes 'bms-v-cell-max) 4.2)
(feed 0x05 [0xff 0xec 0 0])
(near (assoc writes 'bms-i-in-ic) -1.1)
(expect ow-is-current-over-limit 0)
(feed 0x00 [0x25 0 0 0])
(expect (list ow-is-charging ow-is-battery-empty ow-is-battery-temp-out-of-range ow-is-battery-overcharged) '(1 1 1 0))
(expect bms-status 37)
(near (assoc writes 'bms-v-charge) 16.2)
(feed 0x04 [25 30 251 40 33])
(expect (assoc writes 'bms-temp-ic) 33)
(expect (assoc writes 'bms-temps-adc) '(3 40))
(expect (assoc writes 'bms-temp-cell-max) 40)
(feed 0x06 [0x12 0x34 0 0])
(expect ow-serial 0x1234)
(feed 0x08 [7 0 0 0])
(expect bms-battery-type 7)
(feed 0x0d [0x01 0x2c 95 0])
(expect bms-battery-cycles 300)
(near (assoc writes 'bms-soh) 0.95)
(feed 0x15 [1 0 0 0])
(expect (list ow-charge-state bms-charge-state) '(1 1))
(feed 0x03 [150 0 0 0])
(expect (assoc writes 'bms-soc) 1.0)
(feed 0x03 [0 0 0 0])
(expect (assoc writes 'bms-soc) 0.01)
; Over the plain 30 A limit warns once and sets the flag, unless charge-only.
(setq warnings nil)
(feed 0x05 [0x02 0x40 0 0])
(expect ow-is-current-over-limit 1)
(expect (length warnings) 1)
(feed 0x05 [0x02 0x40 0 0])
(expect (length warnings) 1)
(setq ow-charge-only 1)
(feed 0x05 [0x02 0x40 0 0])
(expect ow-is-current-over-limit 0)
(setq ow-charge-only 0)

; ---- Encrypted send paths ------------------------------------------------------
(setq ow-use-crypto t)
(setq ow-magic [255 85 187])
(setq ow-rs485-dere-pin 7)
; Factory init: the first ack triggers the accept packet, the second confirms.
(setq incoming (packet 0x0e [0 1 0 0]))
(expect (ow-factory-init) t)
(expect (length uart-out) 2)
(expect (ix uart-out 0) (let ((p [255 85 187 0 1 5 0x52 0x4d 0x41 0 0]))
    { (bufset-u16 p 9 (ow-checksum p 0 9)) p }))
(expect (ix uart-out 1) (let ((p [255 85 187 0 1 3 1 0 0]))
    { (bufset-u16 p 7 (ow-checksum p 0 7)) p }))
(expect gpio-out '((7 1) (7 0) (7 1) (7 0)))
(expect (car msgs) "Success")
; Charge state: an ack still showing the old state reports no change yet.
(setq uart-out nil)
(setq incoming (packet 0x15 [1 0 0 0]))
(expect (ow-set-charge-state 0 1 0) nil)
(expect (ix uart-out 0) (let ((p [255 85 187 0 1 0x64 1 0 0]))
    { (bufset-u16 p 7 (ow-checksum p 0 7)) p }))
(setq incoming (packet 0x15 [0 0 0 0]))
(expect (ow-set-charge-state 0 1 0) t)
(expect ow-charge-state 0)
(setq ow-charge-state -1)
(expect (ow-set-charge-state 0 1 1) nil)
(expect (car warnings) "bms no charge state yet")

; ---- Keys ----------------------------------------------------------------------
(ow-store-keys (range 16) (range 16 32))
(expect stores 1)
(bufclear ow-key)
(bufclear ow-counter)
(ow-load-keys)
(expect (bufget-u8 ow-key 0) 0)
(expect (bufget-u8 ow-key 15) 15)
(expect (bufget-u8 ow-counter 0) 16)
(expect (bufget-u8 ow-counter 15) 31)
(expect (ow-verify-keys ow-key ow-counter '(123) '(123)) t)
(expect (ow-verify-keys ow-key ow-counter '(1) '(123)) nil)
; Pairing is offered only for the encrypted types.
(expect (bms-pair (range 16) (range 16 32)) nil)
(set-config 'bms-type 2)
(expect (bms-pair (range 16) (range 16 32)) t)
(expect stores 2)

; ---- Init validation -------------------------------------------------------------
(setq ow-exit-flag nil)
(setq ow-use-crypto nil)
(setq ow-rs485-chip 0)
(setq ow-rs485-ro-pin -1)
(setq msgs nil)
(expect (ow-init) nil)
(expect (car msgs) "Invalid Pin: rs485-ro-pin")
(setq ow-rs485-ro-pin 5)
(setq ow-magic (bufcreate 3))
(expect (ow-init) t)
(expect starts '(1 5 -1 115200))
(expect (bufget-u8 ow-magic 2) 0xaa)
(expect (assoc writes 'bms-temp-adc-num) 4)
(setq ow-use-crypto t)
(setq fw-num 6.0)
(expect (ow-init) nil)
(expect (car msgs) "hw-express needs to be running 6.06")
(setq fw-num 6.1)
(setq crc-ok nil)
(expect (ow-init) nil)
(expect (car msgs) "Invalid keys")
(setq crc-ok t)
(setq ow-rs485-chip 1)
(setq ow-rs485-di-pin -1)
(expect (ow-init) nil)
(expect (car msgs) "Invalid Pin: bms-rs485-di-pin")
(setq ow-rs485-di-pin 3)
(setq ow-rs485-dere-pin -1)
(expect (ow-init) nil)
(expect (car msgs) "Invalid Pin: bms-rs485-dere-pin")
(setq ow-rs485-dere-pin 4)
(setq gpio-out nil)
(expect (ow-init) t)
(expect starts '(1 5 3 115200))
(expect gpio-out '((4 0)))
(expect (bufget-u8 ow-magic 2) 0xbb)
(setq ow-charge-only 1)
(setq ow-wakeup-pin -2)
(expect (ow-init) t)
(setq ow-wakeup-pin 9)
(setq gpio-out nil)
(expect (ow-init) t)
(expect gpio-out '((4 0) (9 0)))
(check t)
