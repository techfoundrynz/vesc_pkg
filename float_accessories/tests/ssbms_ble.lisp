; Replies are split into MTU-3 notifications, after unrelated traffic and noise.
(defun ble-client-write (handle data mode conn) {
    (expect handle 12) (expect conn 0) (expect (buflen data) 8)
    (setq write-modes (cons mode write-modes))
    (if (= mode 1) (push (list 'ble-write-result 12 0)))
    (var frame (match (bufget-u16 data 2) (512 count-frame) (32 cells-frame) (0 status-frame)))
    (if answer {
        (push (list 'ble-notification 99 0 [1 2 3] nil))
        (push (list 'ble-notification 14 0 [0 22] nil))
        (var pos 0)
        (loopwhile (< pos (buflen frame)) {
            (var n (min (- mtu 3) (- (buflen frame) pos)))
            (var chunk (bufcreate n))
            (bufcpy chunk 0 frame pos n)
            (push (list 'ble-notification 14 0 chunk nil))
            (setq pos (+ pos n))
        })
    })
    t
})

