(def enabled 0)
(def backend 0)
(def test-time 10.0)
(def uart-stops 0)
(def ow-starts 0)
(def warnings nil)
(def DBG-CFG 2)
(defun get-config (key)
    (cond ((eq key 'bms-enabled) enabled) ((eq key 'bms-backend) backend) (t 0)))
(defun set-config (key value) nil)
(defun test-clock () test-time)
(defun test-age (stamp) { (setq test-time (+ test-time 0.01)) (- test-time stamp) })
(defun test-yield (us) (sleep 0.001))
(defun test-uart-stop () (setq uart-stops (+ uart-stops 1)))
(defun dbg-warn (msg) (setq warnings (cons msg warnings)))
(defun dbg-err (msg) (setq warnings (cons msg warnings)))
(defun send-msg (msg) (setq warnings (cons msg warnings)))
(defun dbg-tick (category key interval) nil)
(defun expect (actual wanted)
    (if (not (eq actual wanted)) (exit-error (to-str (list actual 'wanted wanted)))))
(def fake-stop nil)
(defun fake-run () {
    (setq ow-starts (+ ow-starts 1))
    (bms-mark-received BMS-BACKEND-OW)
    (loopwhile (not fake-stop) (sleep 0.005))
})
(defun register-fake ()
    (bms-register BMS-BACKEND-OW fake-run
        (fn () (setq fake-stop t)) test-uart-stop
        (fn (command value) t) (fn () 7)))

; Default None and the enable flag are independent requirements.
(integration-register 1 (fn () t) (fn () t) (fn (data) nil)
    (fn (a b c d e) t) (fn () t))
(integration-select 1)
(expect BMS-BACKEND-NONE 0)
(bms-start-backend)
(expect bms-worker-running nil)
(setq enabled 1)
(bms-start-backend)
(expect bms-worker-running nil)
(expect bms-context-id -1)
(setq enabled 0)
(setq backend BMS-BACKEND-OW)
(bms-start-backend)
(expect bms-worker-running nil)
(expect ow-starts 0)
(expect uart-stops 0)

; An adapter can be omitted entirely without breaking core startup.
(setq enabled 1)
(bms-start-backend)
(expect bms-worker-running nil)
(register-fake)
; Enable OW, then stop its owner before selecting SSBMS.
(setq enabled 1)
(bms-start-backend)
(sleep 0.02)
(expect ow-starts 1)
(expect integration-id 1)
(expect (bms-capabilities) 7)
(expect (bms-connected) t)
(expect (bms-stop-backend) t)
(expect bms-worker-running nil)
(expect uart-stops 1)

; SSBMS with unconfigured pins clears stale OW status without opening UART.
(setq backend BMS-BACKEND-SSBMS)
(setq bms-status 0)
(setq bms-last-activity-time (test-clock))
(setq bms-is-charging t)
(bms-start-backend)
(sleep 0.02)
(expect bms-worker-running t)
(expect (bms-capabilities) 0)
(expect (bms-connected) nil)
(expect bms-status -1)
(expect bms-is-charging nil)
(expect uart-stops 1)
(expect ow-starts 1)
(expect integration-id 1)
(expect (bms-request-factory-init) nil)
(expect (bms-request-charge 1) nil)
(expect (bms-pair '(1) '(2)) nil)
(expect (bms-stop-backend) t)
(expect bms-worker-running nil)
(expect uart-stops 1)

; Returning to None stays parked with no monitor reviving a previous backend.
(setq backend BMS-BACKEND-NONE)
(bms-start-backend)
(sleep 0.08)
(expect bms-worker-running nil)
(expect ow-starts 1)
(expect uart-stops 1)
(expect (bms-connected) nil)
; A stuck owner blocks replacement instead of spawning a second UART owner.
(setq bms-worker-running t)
(setq backend BMS-BACKEND-OW)
(expect (bms-stop-backend) nil)
(bms-start-backend)
(expect ow-starts 1)
(expect uart-stops 1)
(setq bms-worker-running nil)
(expect integration-id 1)
(check t)
