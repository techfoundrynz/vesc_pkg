(def count-frame [22 3 2 0 2 0 20 232 32])
(def cells-frame [22 3 0 32 40 15 241 15 6 15 237 15 240 15 240 15 240 15 240 15 240 15 241 15 241 15 244 15 244 15 244 15 244 15 244 15 243 15 244 15 244 15 244 15 244 50 26])
(def status-frame [22 3 0 0 32 11 166 11 176 11 186 0 0 0 0 0 0 0 0 7 208 0 0 0 0 0 0 0 0 0 136 0 0 0 0 0 0 120 1])
(def now 10.0)
(def enabled 1)
(def backend 2)
(def rx-pin -1)
(def tx-pin -1)
(def gnss-enabled 0)
(def gnss-port 0)
(def gnss-type 0)
(def starts 0)
(def stops 0)
(def warnings nil)
(def wire nil)
(def wire-pos 0)
(def mode 0)
(def cancel nil)
(def writes nil)
(def indexed nil)
(def frames nil)
(def frame-order nil)
(def requests nil)
(def DBG-BMS 16)
(def voltage-curve (get-voltage-curve 0))
(defun get-config (key) (match key
    (bms-enabled enabled) (bms-backend backend)
    (ssbms-rx-pin rx-pin) (ssbms-tx-pin tx-pin)
    (gnss-enabled gnss-enabled) (gnss-uart-num gnss-port) (gnss-type gnss-type) (_ 0)))
(defun test-clock () now)
(defun test-age (stamp) (- now stamp))
(defun test-sleep (seconds) { (setq now (+ now seconds)) (if cancel (setq bms-stop-requested t)) })
(defun dbg-warn (message) (setq warnings (cons message warnings)))
(defun dbg (cat message) nil)
(defun test-id () 66)
(defun expect (actual wanted)
    (if (not (eq actual wanted)) (exit-error (to-str (list actual 'wanted wanted)))))
(defun near (actual wanted) (if (> (abs (- actual wanted)) 0.001) (exit-error (to-str (list actual 'near wanted)))))
(defun test-value (field value) (setq writes (acons field value writes)))
(defun test-indexed (field index value) (setq indexed (acons (list field index) value indexed)))
(defun get-bms-val (field) {
    (var extra-args (rest-args))
    (var found (if extra-args (assoc indexed (list field (ix extra-args 0))) (assoc writes field)))
    (if found found 0)
})
(defun test-start (port rx tx baud) {
    (expect port 1) (expect rx 8) (expect tx 9) (expect baud 115200)
    (setq starts (+ starts 1)) t
})
(defun test-stop () (setq stops (+ stops 1)))
(defun test-write (request) {
    (expect (buflen request) 8)
    (expect (bufget-u8 request 1) 3)
    (var reg (bufget-u16 request 2))
    (setq requests (cons reg requests))
    (setq wire (if (= mode 2) nil (match reg (512 count-frame) (32 cells-frame) (0 (if (= mode 1) nil status-frame)))))
    (setq wire-pos 0)
    t
})
(defun test-read (buffer size offset stop wait-seconds) {
    (expect wait-seconds 0)
    (if wire {
        (var n (min 7 (min size (- (buflen wire) wire-pos))))
        (if (> n 0) (bufcpy buffer offset wire wire-pos n))
        (setq wire-pos (+ wire-pos n))
        (if (= wire-pos (buflen wire)) (setq wire nil))
        n
    } 0)
})
(defun test-can (id buffer) {
    (expect (bitwise-and id 255) 66)
    (var packet (shr id 8))
    (var copy (bufcreate (buflen buffer)))
    (bufcpy copy 0 buffer 0 (buflen buffer))
    (setq frames (acons packet copy frames))
    (setq frame-order (cons packet frame-order))
})
(expect ssbms-rx nil)
(expect ssbms-uart-open nil)
(setq bms-worker-running t)
(setq bms-active-backend 2)
(setq bms-active-hooks (assoc bms-registry 2))
; Invalid/unassigned or conflicting pins never acquire UART.
(expect (ssbms-init) nil)
(setq rx-pin 8) (setq tx-pin 8)
(expect (ssbms-init) nil)
(setq tx-pin 9)
(setq gnss-enabled 1) (setq gnss-port 1)
(expect (ssbms-init) nil)
(setq gnss-port 0) (setq gnss-type 1)
(expect (ssbms-init) nil)
(expect starts 0)
(setq gnss-enabled 0)
(expect (ssbms-init) t)
(bms-set-freshness 2 3.0)
(setq ssbms-last-snapshot now)
; Metadata/cells alone cannot connect or emit CAN.
(setq mode 1)
(ssbms-poll)
(expect (bms-connected) nil)
(expect frames nil)
(expect ssbms-cell-count 20)
(setq mode 0)
(ssbms-poll)
(expect (bms-connected) t)
(expect (bms-capabilities) 0)
(expect (bms-request-charge 1) nil)
(expect (bms-request-factory-init) nil)
(expect (bms-pair '(1) '(2)) nil)
(near (get-bms-val 'bms-v-tot) 81.405)
(near (get-bms-val 'bms-v-cell-min) 3.846)
(near (get-bms-val 'bms-v-cell-max) 4.084)
(near (get-bms-val 'bms-v-cell 0) 4.081)
(near (get-bms-val 'bms-soc) 0.764)
(near (get-bms-val 'bms-temp-ic) 25.05)
(near (get-bms-val 'bms-temps-adc 0) 26.05)
(near (get-bms-val 'bms-temps-adc 1) 27.05)
(near (get-bms-val 'bms-i-in) -2.0)
(expect bms-status 32)
(bms-service-step)
(expect bms-is-charging t)
(expect bms-charger-just-plugged t)
; Decode emitted CAN fields/flags, including the short final cell frame.
(expect (bufget-u8 (assoc frames 45) 7) 7)
(expect (bufget-u8 (assoc frames 45) 5) 0)
(expect (buflen (assoc frames 41)) 6)
(expect (bufget-u8 (assoc frames 41) 0) 18)
(expect (bufget-u8 (assoc frames 41) 1) 20)
(expect (bufget-u16 (assoc frames 41) 2) 4084)
(near (bufget-f32 (assoc frames 38) 0) 81.405)
(near (bufget-f32 (assoc frames 39) 0) -2.0)
(expect (buflen (assoc frames 43)) 6)
(expect (bufget-i16 (assoc frames 43) 4) 2705)
; No stale rebroadcast; rediscover count after a link loss.
(setq mode 2)
(setq now (+ now 3.1))
(expect (bms-connected) nil)
(def sent (length frame-order))
(ssbms-poll)
(expect (length frame-order) sent)
(expect ssbms-cell-count 0)
(expect bms-status -1)
(bms-service-step)
(expect bms-is-charging nil)
(setq mode 0)
(ssbms-poll)
(expect (bms-connected) t)
; Loss of ownership and cancellation prevent further publication or commands.
(setq backend 0)
(setq sent (length frame-order))
(expect (ssbms-publish) nil)
(expect (length frame-order) sent)
(setq backend 2)
(setq mode 2)
(setq cancel t)
(expect (ssbms-read 0 16 ssbms-status) nil)
(expect bms-stop-requested t)
(ssbms-cleanup)
(expect stops 1)
(expect ssbms-rx nil)
(expect ssbms-tx nil)
(expect ssbms-cells nil)
(expect ssbms-status nil)
(check t)
