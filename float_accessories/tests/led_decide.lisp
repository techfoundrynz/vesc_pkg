; Characterization of led-decide: mode, brightness, highbeams, head/tail and
; the lights-off / braking flags, with the vehicle helpers faked.
(def now 100.0)
(def fresh t)
(def running t)
(def selected t)
(def follow nil)
(def state 1)
(def tot-current 0.0)
(def handtest-mode nil)
(def can-last-activity-time 100.0)
(def lighting-ride 0.0)
(def lighting-idle 0.0)
(def lighting-status 0.0)
(defun test-clock () now)
(defun test-age (stamp) (- now stamp))
(defun vehicle-fresh () fresh)
(defun running-state () running)
(defun integration-selected () selected)
(defun integration-connecting () (and selected (not fresh)))
(defun lighting-override-active () follow)
(defun expect (actual wanted)
    (if (not (eq actual wanted)) (exit-error (to-str (list actual 'wanted wanted)))))
(defun near (actual wanted)
    (if (> (abs (- actual wanted)) 0.001) (exit-error (to-str (list actual 'near wanted)))))

(def seg-front 0) (def seg-rear 1)
(def led-mode 2) (def led-mode-idle 7) (def led-mode-startup 9)
(def led-brightness 0.8) (def led-brightness-highbeam 0.6) (def led-brightness-idle 0.2)
(def led-brightness-status 0.4) (def led-max-brightness 1.0) (def led-dim-on-highbeam-ratio 0.5)
(def idle-timeout 300) (def idle-timeout-shutoff 350)
(def led-brake-light-enabled 1) (def led-brake-light-min-amps -4.0)
(def led-on 1) (def led-highbeam-on 1)
(def led-front-highbeam-mode 1) (def led-rear-highbeam-mode 0)

; Riding forward: front highbeam dims the front strip, braking lights the rear.
(def led-last-activity-time now)
(def direction 1)
(def led-mall-grab 0)
(def tot-current -10.0)
(led-decide)
(expect current-led-mode 2)
(near led-current-brightness 0.8)
(expect (list hb-front hb-rear) '(t nil))
(near hb-frac 0.6)
(expect (list front-bri rear-bri status-bri aux-bri) '(102 204 102 204))
(expect (list head-seg tail-seg head-bri tail-bri) '(0 1 102 204))
(expect (list lights-off braking led-startup-active) '(nil t nil))

; Idle and backwards: idle mode and brightness, no highbeam or brake, rear is
; the head, and past the shutoff timeout with fresh CAN the lights go off.
(def running nil)
(def led-last-activity-time (- now 400))
(def direction -1)
(led-decide)
(expect current-led-mode 7)
(near led-current-brightness 0.2)
(expect (list hb-front hb-rear braking lights-off) '(nil nil nil t))
(expect (list head-seg tail-seg head-bri tail-bri) '(1 0 51 51))
; Stale CAN keeps them on; so does a handtest.
(def can-last-activity-time (- now 5))
(led-decide)
(expect lights-off nil)
(def can-last-activity-time now)
(def handtest-mode t)
(led-decide)
(expect lights-off nil)
(def handtest-mode nil)

; Following the ESC's lighting values, held up for a mall grab: status
; brightness for the strips, ride brightness for the highbeam.
(def follow t)
(def running t)
(def led-last-activity-time now)
(def direction 1)
(def lighting-ride 0.7) (def lighting-status 0.3) (def lighting-idle 0.1)
(def led-mall-grab 1)
(led-decide)
(near led-current-brightness 0.3)
(near hb-frac 0.7)
(expect status-bri 76)
(def follow nil)
(def led-mall-grab 0)
; Max brightness caps everything; state 5 forces idle brightness.
(def led-max-brightness 0.5)
(led-decide)
(near led-current-brightness 0.5)
(def state 5)
(led-decide)
(near led-current-brightness 0.2)
(expect (list hb-front braking) '(nil nil))
(def state 1)
(def led-max-brightness 1.0)

; Startup is only a connection display, not an unconditional three-second hold.
(def now 2.0)
(def can-last-activity-time now)
(def led-last-activity-time now)
(def running nil)
(def fresh nil)
(def selected nil)
(led-decide)
(expect (list led-startup-active current-led-mode) '(nil 2))
; A selected integration still gets its startup display while awaiting telemetry.
(def selected t)
(led-decide)
(expect (list led-startup-active current-led-mode) '(t 9))
; Establishing the link ends startup immediately, even while parked in the window.
(def fresh t)
(led-decide)
(expect (list led-startup-active current-led-mode) '(nil 2))
; Riding and the elapsed startup window independently suppress the display.
(def fresh nil)
(def running t)
(led-decide)
(expect (list led-startup-active current-led-mode) '(nil 2))
(def running nil)
(def now 3.0)
(led-decide)
(expect (list led-startup-active current-led-mode) '(nil 2))
(check t)
